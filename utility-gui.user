      var top = api.el('div', 'row');
      var sScore = api.stat('Score'); var sLives = api.stat('Lives', 3); var sLevel = api.stat('Level', 1); var sBest = api.stat('Best', best);
      [sScore, sLives, sLevel, sBest].forEach(function (s) { top.appendChild(s.el); });
      var hint = api.el('div', 'hint', 'Mouse or arrow keys to move  ·  Click or Space to launch  ·  Enter to restart');
      stage.appendChild(top); stage.appendChild(cv.c); stage.appendChild(hint);
      function build() {
