      stage.appendChild(top); stage.appendChild(msg); stage.appendChild(board); stage.appendChild(hint);
      var COL = { 2: ['#eee4da', '#776e65'], 4: ['#ede0c8', '#776e65'], 8: ['#f2b179', '#fff'], 16: ['#f59563', '#fff'], 32: ['#f67c5f', '#fff'], 64: ['#f65e3b', '#fff'],
        128: ['#edcf72', '#fff'], 256: ['#edcc61', '#fff'], 512: ['#edc850', '#fff'], 1024: ['#edc53f', '#fff'], 2048: ['#edc22e', '#fff'] };
      function pos(r, c) { return 'translate(' + (GAP + c * (CELL + GAP)) + 'px,' + (GAP + r * (CELL + GAP)) + 'px)'; }
