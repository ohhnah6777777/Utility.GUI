    /* ---------- 2048 ---------- */
    GAME_IMPL.g2048 = function (stage, api) {
      var N = 4;
      var CELL = 98;
      var GAP = 12;
      var tiles, nextId, score, won, keepGoing, over, best = api.hi('2048');
      var top = api.el('div', 'row');
      var sScore = api.stat('Score'); var sBest = api.stat('Best', best);
      var newBtn = api.btn('New Game', function () { reset(); });
      top.appendChild(sScore.el); top.appendChild(sBest.el); top.appendChild(newBtn);
      var msg = api.el('div', 'msg');
      var size = N * CELL + (N + 1) * GAP;
      var board = api.el('div');
      board.style.cssText = 'position:relative;width:' + size + 'px;height:' + size + 'px;background:#2a2e3d;border-radius:18px;touch-action:none;';
      for (var i = 0; i < N * N; i++) {
        var bgc = api.el('div');
        bgc.style.cssText = 'position:absolute;width:' + CELL + 'px;height:' + CELL + 'px;border-radius:12px;background:rgba(255,255,255,.06);left:' + (GAP + (i % N) * (CELL + GAP)) + 'px;top:' + (GAP + ((i / N) | 0) * (CELL + GAP)) + 'px;';
        board.appendChild(bgc);
