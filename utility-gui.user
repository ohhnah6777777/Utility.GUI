    /* ---------- Memory Match ---------- */
    GAME_IMPL.memory = function (stage, api) {
      var POOL = ['🐶', '🐱', '🦊', '🐼', '🐸', '🐵', '🦄', '🐙', '🦋', '🐢', '🦁', '🐧', '🍎', '🍕', '🚀', '⭐', '🎈', '🎸', '⚽', '🌈'];
      var SIZES = { 'Easy (4×3)': [4, 3], 'Medium (4×4)': [4, 4], 'Hard (6×5)': [6, 5] };
      var size = 'Medium (4×4)';
      var cards, flipped, lock, moves, matched, secs, timer, started;
      var row = api.el('div', 'row');
      var btns = {};
      Object.keys(SIZES).forEach(function (k) { btns[k] = api.btn(k, function () { size = k; reset(); }, k === size ? 'on' : ''); row.appendChild(btns[k]); });
      var top = api.el('div', 'row');
      var sMoves = api.stat('Moves'); var sTime = api.stat('Time', 0); var sPairs = api.stat('Pairs', '0');
      top.appendChild(sMoves.el); top.appendChild(sTime.el); top.appendChild(sPairs.el);
      var msg = api.el('div', 'msg');
      var grid = api.el('div');
      var again = api.btn('New Game', function () { reset(); });
      stage.appendChild(row); stage.appendChild(top); stage.appendChild(msg); stage.appendChild(grid); stage.appendChild(again);
      function reset() {
        clearInterval(timer);
        var s = SIZES[size], cols = s[0], rows = s[1], n = cols * rows / 2;
        var pool = POOL.slice().sort(function () { return Math.random() - 0.5; }).slice(0, n);
        var deck = pool.concat(pool).sort(function () { return Math.random() - 0.5; });
        flipped = []; lock = false; moves = 0; matched = 0; secs = 0; started = false;
        sMoves.set(0); sTime.set(0); sPairs.set('0 / ' + n); msg.textContent = '';
        Object.keys(btns).forEach(function (k) { btns[k].className = 'btn' + (k === size ? ' on' : ''); });
        var cs = Math.max(56, Math.min(110, Math.floor((stage.clientHeight - 260) / rows) - 10, Math.floor((stage.clientWidth - 60) / cols) - 10));
        grid.innerHTML = '';
        grid.style.cssText = 'display:grid;grid-template-columns:repeat(' + cols + ',' + cs + 'px);gap:10px;perspective:800px;';
        cards = deck.map(function (emo, i) {
          var card = api.el('button');
          card.style.cssText = 'position:relative;width:' + cs + 'px;height:' + cs + 'px;border:none;background:none;padding:0;cursor:pointer;transform-style:preserve-3d;transition:transform .35s;';
          var face = api.el('div', '', emo), back = api.el('div', '', '?');
          var common = 'position:absolute;inset:0;border-radius:14px;display:flex;align-items:center;justify-content:center;backface-visibility:hidden;-webkit-backface-visibility:hidden;';
          back.style.cssText = common + 'background:linear-gradient(135deg,#3a4160,#262b40);color:#7c84a8;font-size:' + (cs * 0.4) + 'px;font-weight:800;border:1px solid rgba(255,255,255,.1);';
          face.style.cssText = common + 'background:#1d2130;font-size:' + (cs * 0.55) + 'px;transform:rotateY(180deg);border:1px solid rgba(255,255,255,.12);';
          card.appendChild(back); card.appendChild(face);
          var obj = { el: card, face: face, e: emo, up: false, done: false };
          card.addEventListener('click', function () { flip(i); });
          grid.appendChild(card);
          return obj;
        });
      }
      function setUp(c, up) { c.up = up; c.el.style.transform = up ? 'rotateY(180deg)' : 'none'; }
      function flip(i) {
        var c = cards[i];
