          ctx.fill();
          ctx.fillStyle = 'rgba(255,255,255,.22)'; ctx.fillRect(b.x + 3, b.y + 2, BW - 6, 4);
        });
        ctx.shadowColor = '#7fe3b0'; ctx.shadowBlur = 14; ctx.fillStyle = '#e8fff4';
        ctx.beginPath();
        if (ctx.roundRect) ctx.roundRect(paddle.x, paddle.y, paddle.w, paddle.h, 6); else ctx.rect(paddle.x, paddle.y, paddle.w, paddle.h);
