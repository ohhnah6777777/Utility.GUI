      }
      api.key(function (e) {
        var k = e.key;
        if (k === 'ArrowLeft' || k === 'a' || k === 'A') { move(-1); return true; }
        if (k === 'ArrowRight' || k === 'd' || k === 'D') { move(1); return true; }
        if (k === 'ArrowUp' || k === 'x' || k === 'X' || k === 'w' || k === 'W') { tryRotate(1); return true; }
        if (k === 'z' || k === 'Z') { tryRotate(-1); return true; }
