      var wrap = api.el('div', 'row');
      wrap.style.cssText = 'align-items:flex-start;gap:24px;';
      var cv = api.canvas(COLS * CS, ROWS * CS, 90);
      var side = api.el('div');
      side.style.cssText = 'display:flex;flex-direction:column;gap:12px;min-width:150px;';
      var sScore = api.stat('Score'); var sLines = api.stat('Lines'); var sLevel = api.stat('Level', 1); var sBest = api.stat('Best', best);
      var nextC = api.canvas(4 * 22, 4 * 22, 0);
      var nextLbl = api.el('div', 'hint', 'Next');
      var msg = api.el('div', 'msg');
      var newBtn = api.btn('New Game', function () { reset(); });
      [sScore.el, sLines.el, sLevel.el, sBest.el, nextLbl, nextC.c, msg, newBtn].forEach(function (x) { side.appendChild(x); });
      wrap.appendChild(cv.c); wrap.appendChild(side);
      var hint = api.el('div', 'hint', '← → move  ·  ↑ rotate  ·  ↓ soft drop  ·  Space hard drop  ·  P pause');
      stage.appendChild(wrap); stage.appendChild(hint);
      function newBag() { var b = Object.keys(SHAPES); for (var i = b.length - 1; i > 0; i--) { var j = (Math.random() * (i + 1)) | 0; var t = b[i]; b[i] = b[j]; b[j] = t; } return b; }
      function pull() { if (!bag.length) bag = newBag(); return bag.pop(); }
