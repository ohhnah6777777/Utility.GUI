        for (var r = 0; r < ROWS; r++) if (b[r][3] === p) s += 3;
        for (var r2 = 0; r2 < ROWS; r2++) for (var c = 0; c < COLS; c++) {
          if (c + 3 < COLS) s += evalWindow([b[r2][c], b[r2][c + 1], b[r2][c + 2], b[r2][c + 3]], p);
          if (r2 + 3 < ROWS) s += evalWindow([b[r2][c], b[r2 + 1][c], b[r2 + 2][c], b[r2 + 3][c]], p);
          if (r2 + 3 < ROWS && c + 3 < COLS) s += evalWindow([b[r2][c], b[r2 + 1][c + 1], b[r2 + 2][c + 2], b[r2 + 3][c + 3]], p);
          if (r2 + 3 < ROWS && c - 3 >= 0) s += evalWindow([b[r2][c], b[r2 + 1][c - 1], b[r2 + 2][c - 2], b[r2 + 3][c - 3]], p);
        }
        return s;
