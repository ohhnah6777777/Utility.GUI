        var n = 0;
        while (n < M) { var i = (Math.random() * R * C) | 0; if (!mine[i] && !safe[i]) { mine[i] = true; n++; } }
        for (var r = 0; r < R; r++) for (var c = 0; c < C; c++) adj[idx(r, c)] = nbrs(r, c).filter(function (x) { return mine[idx(x[0], x[1])]; }).length;
        placed = true;
      }
