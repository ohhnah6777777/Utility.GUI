// ==UserScript==
// @name         Utility.Gui
// @namespace    utility-gui
// @version      5.0
// @description  Utility.Gui toolkit. Press Alt+Shift+U to open or close it on any page.
// @match        *://*/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==
(function () {
  function run() {
/* Utility.Gui bookmarklet - readable source.
   Click the bookmarklet again to close the panel and undo everything. */
(function () {
  var NAME = 'Utility.Gui';
  var ID = 'utility-gui-host';
  if (window.__utilityGui) { window.__utilityGui.destroy(); return; }

  var SCALE = 1.2;   /* default panel size: 1 = original, 1.2 = 20% bigger (also a slider in Settings) */

  var html = document.documentElement;
  var timers = [];
  var cleanups = [];
  var extras = [];
  var fx = {};
  var uid = 0;
  var scrollSpeed = 0;
  var scrollRaf = null;
  var refreshId = null;
  var delStack = [];
  var dd = null;
  var origZoom = document.body.style.zoom;

  /* filter state (body filter built from CSS variables) */
  var F = { b: 100, c: 100, s: 100, sp: 0, bl: 0, h: 0, g: 0 };
  var rainbowOn = false;
  var CB = '';
  var curAccent = 'Emerald';
  /* layout / typography state */
  var T = { mw: 0, op: 100, lh: 0, ls: 0, ws: 0 };
  /* misc settings driven by sliders */
  var cfg = { mskip: 3, snow: 120, trail: 5, confetti: 160, shake: 12, rate: 1, fw: 90, bub: 50 };
  var snowFlakes = [];

  /* ---------- persistence (localStorage is already per-site, so settings are remembered per site) ---------- */
  var store = {
    get: function (k) { try { return JSON.parse(localStorage.getItem(k) || 'null'); } catch (e) { return null; } },
    set: function (k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} },
    del: function (k) { try { localStorage.removeItem(k); } catch (e) {} }
  };
  var GK = 'ug:v1:global';
  var SK = 'ug:v1:site';
  var GLOB = store.get(GK) || {};
  var SITE = store.get(SK) || {};

  var ACCENTS = {
    Emerald: ['#146c4b', '#2cc38b', '#4fe0aa', '44,195,139'],
    Ocean: ['#1d4f91', '#3b9cf5', '#6db8ff', '59,156,245'],
    Violet: ['#5b2fa8', '#9a6cf5', '#b79bff', '154,108,245'],
    Rose: ['#9b2c4a', '#f0587f', '#ff8aa6', '240,88,127'],
    Amber: ['#9a5a0b', '#f0a020', '#ffc457', '240,160,32']
  };

  function later(fn, ms) { var t = setTimeout(fn, ms); timers.push(t); return t; }

  /* ---------- page-level styles (toggled with ug- classes on <html>) ---------- */
  var CUR = 'data:image/svg+xml,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40">' +
    '<path d="M4 2l0 28 8-7 5 11 6-3-5-11 10 0z" fill="black" stroke="white" stroke-width="2"/></svg>');
  var pageStyle = document.createElement('style');
  var X = ':not(#' + ID + ')';
  pageStyle.textContent =
    '@property --ug-h{syntax:"<angle>";inherits:true;initial-value:0deg}' +
    'html.ug-dark{filter:invert(1) hue-rotate(180deg)}' +
    'html.ug-dark img,html.ug-dark video,html.ug-dark picture,html.ug-dark canvas[id^=ug-],html.ug-dark #ug-buddy,html.ug-dark #ug-game,html.ug-dark #' + ID +
      '{filter:invert(1) hue-rotate(180deg)}' +
    'html.ug-reader body{background:#fbf6ec!important;color:#433422!important}' +
    'html.ug-reader body *' + X + '{background:transparent!important;color:inherit!important;font-family:Georgia,serif!important}' +
    'html.ug-noimg img,html.ug-noimg picture,html.ug-noimg video{visibility:hidden!important}' +
    'html.ug-filt body{filter:brightness(var(--ug-b,1)) contrast(var(--ug-c,1)) saturate(var(--ug-s,1)) ' +
      'grayscale(var(--ug-g,0)) sepia(var(--ug-sp,0)) hue-rotate(var(--ug-h)) blur(var(--ug-bl,0px)) var(--ug-cb,)}' +
    '@keyframes ug-rainbow{from{--ug-h:0deg}to{--ug-h:360deg}}' +
    'html.ug-rainbow body{animation:ug-rainbow var(--ug-rs,6s) linear infinite}' +
    'html.ug-still body *' + X + '{animation:none!important;transition:none!important;scroll-behavior:auto!important}' +
    'html.ug-outline body *' + X + '{outline:1px solid rgba(37,99,235,.45)!important}' +
    'html.ug-links a' + X + '{background:#fde68a!important;color:#000!important;outline:2px solid #f59e0b!important}' +
    'html.ug-unlock *' + X + '{-webkit-user-select:text!important;user-select:text!important}' +
    'html.ug-del body *' + X + ':hover{outline:2px solid #ef4444!important;cursor:crosshair!important}' +
    'html.ug-unscroll,html.ug-unscroll body{overflow:auto!important}' +
    '.ug-hidefix,.ug-gone,.ug-ad{display:none!important}' +
    '@keyframes ug-roll{to{transform:rotate(360deg)}}' +
    'html.ug-roll body{animation:ug-roll 1.2s ease-in-out}' +
    'html.ug-linkurls a[href]' + X + '::after{content:" (" attr(href) ")";font-size:.8em;opacity:.7;word-break:break-all}' +
    'html.ug-bigcur *' + X + '{cursor:url("' + CUR + '") 4 2,auto!important}' +
    'html.ug-tx-up body *' + X + '{text-transform:uppercase!important}' +
    'html.ug-tx-low body *' + X + '{text-transform:lowercase!important}' +
    'html.ug-tx-cap body *' + X + '{text-transform:capitalize!important}' +
    'html.ug-tx-mirror body{transform:scaleX(-1)}' +
    'html.ug-tx-flip body{transform:rotate(180deg)}' +
    '@keyframes ug-wob{0%,100%{transform:rotate(-1.2deg)}50%{transform:rotate(1.2deg)}}' +
    'html.ug-tx-wobble :is(h1,h2,h3,h4,h5,h6,p,li,img,button,label)' + X + '{animation:ug-wob 1.4s ease-in-out infinite}' +
    'html.ug-tx-glitch body *' + X + '{text-shadow:2px 0 rgba(255,0,60,.6),-2px 0 rgba(0,220,255,.6)!important}' +
    'html.ug-tx-neon body *' + X + '{text-shadow:0 0 4px currentColor,0 0 12px currentColor!important}' +
    'html.ug-hacker body,html.ug-hacker body *' + X + '{background:#000!important;color:#33ff66!important;' +
      'font-family:ui-monospace,Menlo,Consolas,monospace!important;border-color:#33ff66!important}' +
    'html.ug-hacker a' + X + '{color:#9dffb0!important}' +
    'html.ug-hacker img{filter:grayscale(1) sepia(1) hue-rotate(70deg) saturate(3)}' +
    '';
  document.head.appendChild(pageStyle);

  var fontStyle = document.createElement('style');
  document.head.appendChild(fontStyle);
  var adjStyle = document.createElement('style');
  document.head.appendChild(adjStyle);
  pageStyle.setAttribute('data-ug', '1');
  fontStyle.setAttribute('data-ug', '1');
  adjStyle.setAttribute('data-ug', '1');

  function updateFilt() {
    var st = html.style;
    st.setProperty('--ug-b', F.b / 100);
    st.setProperty('--ug-c', F.c / 100);
    st.setProperty('--ug-s', F.s / 100);
    st.setProperty('--ug-sp', F.sp / 100);
    st.setProperty('--ug-g', F.g);
    st.setProperty('--ug-bl', F.bl + 'px');
    st.setProperty('--ug-h', F.h + 'deg');
    if (CB) st.setProperty('--ug-cb', 'url(#ug-cb-' + CB + ')'); else st.removeProperty('--ug-cb');
    var on = rainbowOn || !!CB || F.b !== 100 || F.c !== 100 || F.s !== 100 || F.sp || F.bl || F.h || F.g;
    html.classList.toggle('ug-filt', !!on);
  }

  function updateAdj() {
    var c = '';
    if (T.mw) c += 'body{max-width:' + T.mw + 'px!important;margin-left:auto!important;margin-right:auto!important}';
    if (T.op < 100) c += 'body{opacity:' + (T.op / 100) + '}';
    var t = '';
    if (T.lh) t += 'line-height:' + T.lh + '!important;';
    if (T.ls) t += 'letter-spacing:' + T.ls + 'px!important;';
    if (T.ws) t += 'word-spacing:' + T.ws + 'px!important;';
    if (t) c += 'body *' + X + '{' + t + '}';
    adjStyle.textContent = c;
  }

  /* ---------- host + shadow root (keeps the panel isolated from page CSS) ---------- */
  var host = document.createElement('div');
  host.id = ID;
  host.style.cssText = 'all:initial;position:fixed;top:0;left:0;width:0;height:0;z-index:2147483647;';
  html.appendChild(host);
  var root = host.attachShadow({ mode: 'open' });

  function applyAccent(name) {
    var a = ACCENTS[name] || ACCENTS.Emerald;
    curAccent = ACCENTS[name] ? name : 'Emerald';
    host.style.setProperty('--a1', a[0]);
    host.style.setProperty('--a2', a[1]);
    host.style.setProperty('--at', a[2]);
    host.style.setProperty('--ar', a[3]);
  }
  applyAccent('Emerald');

  var SHADOW_CSS =
    ':host{all:initial}' +
    '*{box-sizing:border-box;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}' +
    '#hud{position:fixed;top:20px;right:20px;width:' + (360 * SCALE) + 'px;max-height:' + (520 * SCALE) + 'px;' +
      'display:flex;flex-direction:column;background:rgba(17,17,17,.97);backdrop-filter:blur(16px);' +
      '-webkit-backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.07);border-radius:24px;' +
      'box-shadow:0 30px 70px rgba(0,0,0,.55);color:#f2f2f2;user-select:none;overflow:hidden}' +
    '#inner{zoom:' + SCALE + ';width:360px;max-height:520px;flex:none;display:flex;flex-direction:column;min-height:0}' +
    '#hdr{padding:18px 20px 8px;display:flex;justify-content:space-between;align-items:flex-start;cursor:move;touch-action:none}' +
    '#hdr h3{margin:0;font-size:17px;font-weight:600;color:#fff;letter-spacing:-.01em}' +
    '#hdr small{display:block;margin-top:2px;font-size:11px;color:#6f6f6f}' +
    '.hbtns{display:flex;gap:2px;align-items:center;margin-top:-2px}' +
    '.ico{background:none;border:none;color:#a3a3a3;cursor:pointer;padding:6px;border-radius:9px;display:flex}' +
    '.ico:hover{color:#fff;background:rgba(255,255,255,.08)}' +
    'svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}' +
    '#hdr,#searchbar,#tabs,#grip{flex:none}' +
    '#hud.collapsed #hdr{padding:12px 16px;align-items:center}' +
    '#hud.collapsed #hdr small,#hud.collapsed .hmore,#hud.collapsed #tabs,#hud.collapsed #searchbar,' +
      '#hud.collapsed #body,#hud.collapsed #grip{display:none}' +
    '#searchbar{display:none;padding:2px 20px 8px}#searchbar.open{display:block}' +
    '#tabs{overflow-x:auto;overflow-y:hidden;scrollbar-width:none;padding:6px 20px 10px;' +
      '-webkit-mask-image:linear-gradient(90deg,transparent,#000 14px,#000 calc(100% - 14px),transparent);' +
      'mask-image:linear-gradient(90deg,transparent,#000 14px,#000 calc(100% - 14px),transparent)}' +
    '#tabs::-webkit-scrollbar{display:none}' +
    '#tabrow{position:relative;display:flex;gap:8px;width:max-content}' +
    '#tabind{position:absolute;left:0;top:0;height:100%;width:0;background:#2b2b2b;border:1px solid rgba(255,255,255,.1);' +
      'border-radius:999px;box-shadow:0 2px 10px rgba(0,0,0,.35);pointer-events:none;' +
      'transition:transform .3s cubic-bezier(.4,0,.2,1),width .3s cubic-bezier(.4,0,.2,1),opacity .2s}' +
    '#tabind.off{opacity:0}' +
    '.tab{position:relative;z-index:1;flex:none;display:flex;align-items:center;gap:7px;background:rgba(255,255,255,.025);' +
      'border:1px solid rgba(255,255,255,.05);color:#8f8f8f;padding:7px 14px 7px 12px;font-size:13px;font-weight:500;' +
      'cursor:pointer;border-radius:999px;transition:color .2s,background .2s,border-color .2s}' +
    '.tab svg{width:15px;height:15px}' +
    '.tab:hover{color:#ddd}' +
    '.tab.active{color:#fff;background:transparent;border-color:transparent}' +
    '#body{padding:2px 18px 0;overflow-y:auto;overflow-x:hidden;flex:1;min-height:0;scrollbar-width:none;' +
      '-webkit-mask-image:linear-gradient(to bottom,#000 calc(100% - 34px),transparent);' +
      'mask-image:linear-gradient(to bottom,#000 calc(100% - 34px),transparent)}' +
    '#body::-webkit-scrollbar{display:none}' +
    '.pane{display:none;flex-direction:column;gap:8px;padding-bottom:40px}' +
    '.pane.active{display:flex;animation:ugslide .28s cubic-bezier(.2,.7,.2,1)}' +
    '@keyframes ugslide{from{opacity:0;transform:translateX(calc(30px * var(--dir,1)))}to{opacity:1;transform:none}}' +
    '#rlist,#favlist{display:flex;flex-direction:column;gap:8px}' +
    '.rdiv{height:1px;background:rgba(255,255,255,.07);margin:14px 4px 10px}' +
    '#tip{position:fixed;left:0;top:0;z-index:5;max-width:230px;background:rgba(34,34,34,.98);' +
      'border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:9px 12px;font-size:12px;line-height:1.45;' +
      'color:#e8e8e8;box-shadow:0 10px 30px rgba(0,0,0,.5);pointer-events:none;opacity:0;transition:opacity .12s}' +
    '#tip.show{opacity:1}' +
    '.sec{font-size:13px;color:#7d7d7d;font-weight:500;margin:10px 4px 0}' +
    '.desc{font-size:11px;color:#707070;margin:-3px 6px 4px;line-height:1.4}' +
    '.row{display:flex;align-items:center;justify-content:space-between;background:#1f1f1f;' +
      'border:1px solid rgba(255,255,255,.04);border-radius:13px;padding:0 16px;min-height:42px;font-size:13.5px;' +
      'color:#f0f0f0;gap:12px}' +
    '.row.sl{padding:13px 16px;min-height:64px}' +
    '.lbl{display:flex;flex-direction:column;gap:4px;flex:none;max-width:48%}' +
    '.lbl small{font-size:12px;color:#9a9a9a}' +
    '.row.sl input[type=range]{width:50%;flex:none}' +
    '.btn{display:flex;align-items:center;justify-content:space-between;width:100%;text-align:left;cursor:pointer;' +
      'background:#1f1f1f;border:1px solid rgba(255,255,255,.04);border-radius:13px;padding:0 16px;min-height:42px;' +
      'font-size:13.5px;color:#f0f0f0}' +
    '.btn:hover,.row:hover{background:#262626}' +
    '.sw{position:relative;display:inline-block;width:46px;height:24px;flex:none}' +
    '.sw input{opacity:0;width:0;height:0;position:absolute}' +
    '.knob{position:absolute;inset:0;cursor:pointer;background:#2a2a2a;border:1px solid #3b3b3b;transition:.2s;border-radius:14px}' +
    '.knob:before{content:"";position:absolute;height:16px;width:16px;left:3px;top:3px;background:#7a7a7a;' +
      'transition:.2s;border-radius:50%}' +
    '.sw input:checked+.knob{background:linear-gradient(90deg,var(--a1),var(--a2));border-color:var(--a2)}' +
    '.sw input:checked+.knob:before{transform:translateX(22px);background:var(--at)}' +
    '.sw input:focus-visible+.knob{outline:2px solid var(--at)}' +
    'input[type=range]{-webkit-appearance:none;appearance:none;height:16px;border-radius:9px;cursor:pointer;outline:none;' +
      'background:linear-gradient(90deg,var(--a1),var(--a2)) 0 0/calc(17px + (100% - 34px) * var(--f,0)) 100% no-repeat,#2b2b2b}' +
    'input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:34px;height:20px;border-radius:10px;background:#fff;' +
      'box-shadow:0 1px 5px rgba(0,0,0,.6);border:none}' +
    'input[type=range]::-moz-range-thumb{width:34px;height:20px;border-radius:10px;background:#fff;border:none;' +
      'box-shadow:0 1px 5px rgba(0,0,0,.6)}' +
    'input[type=text]{background:#2b2b2b;border:1px solid rgba(255,255,255,.06);border-radius:9px;color:#f3f3f3;' +
      'padding:6px 12px;font-size:12.5px;width:54%;user-select:text;outline:none}' +
    'input[type=text]:focus{border-color:var(--a2)}' +
    '#q{width:100%;padding:9px 14px;border-radius:12px;font-size:13px}' +
    'input[type=color]{width:34px;height:22px;padding:0;border:none;background:none;cursor:pointer;margin-left:8px;vertical-align:middle}' +
    '.selw{position:relative;display:flex;align-items:center}' +
    '.selw select{-webkit-appearance:none;appearance:none;background:transparent;border:none;color:#a8a8a8;font-size:13px;' +
      'padding:6px 20px 6px 8px;cursor:pointer;outline:none;text-align:right}' +
    '.selw option{background:#1f1f1f;color:#eee}' +
    '.selw svg{position:absolute;right:0;width:14px;height:14px;pointer-events:none;color:#a8a8a8}' +
    '.keybtn{background:#2b2b2b;border:1px solid rgba(255,255,255,.06);border-radius:9px;color:#d8d8d8;padding:6px 14px;' +
      'font-size:12.5px;cursor:pointer}' +
    '.keybtn:hover{background:#333}' +
    '.stat{background:linear-gradient(135deg,rgba(var(--ar),.28),rgba(24,24,24,.9) 75%);' +
      'border:1px solid rgba(var(--ar),.4);border-radius:18px;padding:16px 18px;margin-bottom:4px}' +
    '.st-top{display:flex;align-items:center;gap:10px;font-size:15px;font-weight:600;color:#fff}' +
    '.st-top svg{width:20px;height:20px}' +
    '.st-bot{display:flex;justify-content:space-between;align-items:baseline;margin-top:12px;font-size:19px;font-weight:500}' +
    '.st-chg{font-size:12px;font-weight:700;color:var(--at)}' +
    '#out{display:none;white-space:pre-wrap;word-break:break-all;font:11px ui-monospace,Menlo,Consolas,monospace;' +
      'background:#181818;border:1px solid rgba(255,255,255,.04);border-radius:13px;padding:12px;max-height:150px;' +
      'overflow:auto;user-select:text;color:#c7c7c7}' +
    '.row.col{flex-direction:column;align-items:stretch;padding:12px 16px;gap:8px}' +
    'textarea{width:100%;height:120px;resize:vertical;background:#2b2b2b;border:1px solid rgba(255,255,255,.06);' +
      'border-radius:10px;color:#f3f3f3;padding:10px 12px;font-size:12.5px;font-family:inherit;outline:none;user-select:text}' +
    'textarea:focus{border-color:var(--a2)}' +
    '#css{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;height:110px;white-space:pre}' +
    '#hud.compact .row,#hud.compact .btn{min-height:34px;font-size:12.5px}' +
    '#hud.compact .row.sl{padding:8px 14px;min-height:52px}' +
    '#hud.compact .pane{gap:6px}#hud.compact .sec{margin-top:6px}#hud.compact .desc{margin-top:-2px}' +
    '#hud.light{background:rgba(247,247,250,.98);color:#17171c;border-color:rgba(0,0,0,.1);box-shadow:0 30px 70px rgba(0,0,0,.25)}' +
    '#hud.light #hdr h3,#hud.light .st-top{color:#111}' +
    '#hud.light #hdr small,#hud.light .sec,#hud.light .desc{color:#7a7a84}' +
    '#hud.light .ico{color:#6b6b75}#hud.light .ico:hover{color:#000;background:rgba(0,0,0,.06)}' +
    '#hud.light .tab{background:rgba(0,0,0,.04);border-color:rgba(0,0,0,.07);color:#6b6b75}' +
    '#hud.light .tab:hover{color:#222}#hud.light .tab.active{color:#111}' +
    '#hud.light #tabind{background:#fff;border-color:rgba(0,0,0,.12);box-shadow:0 2px 8px rgba(0,0,0,.12)}' +
    '#hud.light .row,#hud.light .btn{background:#fff;border-color:rgba(0,0,0,.07);color:#1b1b20}' +
    '#hud.light .btn:hover,#hud.light .row:hover{background:#f0f0f4}' +
    '#hud.light .lbl small{color:#6f6f78}' +
    '#hud.light .knob{background:#dcdce2;border-color:#c9c9d1}#hud.light .knob:before{background:#9a9aa5}' +
    '#hud.light .sw input:checked+.knob{background:linear-gradient(90deg,var(--a1),var(--a2));border-color:var(--a2)}' +
    '#hud.light .sw input:checked+.knob:before{background:#fff}' +
    '#hud.light input[type=range]{background:linear-gradient(90deg,var(--a1),var(--a2)) 0 0/calc(17px + (100% - 34px) * var(--f,0)) 100% no-repeat,#dcdce2}' +
    '#hud.light input[type=range]::-webkit-slider-thumb{box-shadow:0 1px 5px rgba(0,0,0,.35);border:1px solid rgba(0,0,0,.08)}' +
    '#hud.light input[type=text],#hud.light textarea,#hud.light .keybtn{background:#ececf1;border-color:rgba(0,0,0,.08);color:#16161a}' +
    '#hud.light .selw select{color:#55555f}#hud.light .selw option{background:#fff;color:#111}#hud.light .selw svg{color:#55555f}' +
    '#hud.light .stat{background:linear-gradient(135deg,rgba(var(--ar),.25),#fff 75%)}#hud.light .st-bot{color:#222}' +
    '#hud.light #out{background:#ececf1;color:#333;border-color:rgba(0,0,0,.06)}' +
    '#hud.light #grip span{background:rgba(0,0,0,.25)}#hud.light .rdiv{background:rgba(0,0,0,.08)}' +
    '.elgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}' +
    '.el{display:flex;flex-direction:column;align-items:center;gap:7px;padding:10px 4px 9px;background:#1f1f1f;' +
      'border:1px solid rgba(255,255,255,.05);border-radius:13px;color:#d9d9d9;font-size:11.5px;cursor:pointer}' +
    '.el i{display:block;width:36px;height:22px;border-radius:7px;box-shadow:inset 0 0 0 1px rgba(255,255,255,.18),0 1px 3px rgba(0,0,0,.5)}' +
    '.el:hover{background:#2a2a2a}' +
    '.el.on{border-color:var(--a2);box-shadow:0 0 0 1px var(--a2) inset;color:#fff;background:#262626}' +
    '#hud.light .el{background:#fff;border-color:rgba(0,0,0,.08);color:#222}#hud.light .el:hover{background:#f0f0f4}#hud.light .el.on{background:#eef7f2;color:#111}' +
    '.gmgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}' +
    '.gm{display:flex;align-items:center;gap:11px;padding:12px 12px;background:#1f1f1f;border:1px solid rgba(255,255,255,.05);' +
      'border-radius:13px;color:#e8e8e8;font-size:13px;cursor:pointer;text-align:left}' +
    '.gm .ge{font-size:24px;line-height:1}' +
    '.gm:hover{background:#2a2a2a}' +
    '#hud.light .gm{background:#fff;border-color:rgba(0,0,0,.08);color:#222}#hud.light .gm:hover{background:#f0f0f4}' +
    '#grip{padding:8px 0 12px;display:flex;justify-content:center;cursor:move;touch-action:none}' +
    '#grip span{width:100px;height:4px;border-radius:4px;background:rgba(255,255,255,.3)}' +
    '#toast{position:fixed;bottom:20px;left:50%;transform:translate(-50%,100px);background:rgba(20,20,20,.96);' +
      'backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.12);padding:14px 24px;border-radius:30px;color:#fff;' +
      'font-size:14px;font-weight:600;display:flex;align-items:center;gap:12px;max-width:90vw;' +
      'box-shadow:0 10px 30px rgba(0,0,0,.5);transition:transform .4s cubic-bezier(.175,.885,.32,1.275)}' +
    '#toast.show{transform:translate(-50%,0)}' +
    '#spin{width:16px;height:16px;border:2px solid rgba(255,255,255,.2);border-top-color:var(--a2,#2cc38b);border-radius:50%;' +
      'animation:spin .8s linear infinite;flex:none}' +
    '@keyframes spin{to{transform:rotate(360deg)}}';

  root.innerHTML =
    '<style>' + SHADOW_CSS + '</style>' +
    '<div id="toast" role="status" aria-live="polite"><span id="spin"></span><span id="tt">Loading GUI...</span></div>';

  var toast = root.querySelector('#toast');
  var tt = root.querySelector('#tt');
  var spin = root.querySelector('#spin');
  var toastTimer;

  function say(msg, ms) {
    spin.style.display = 'none';
    tt.textContent = msg;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { toast.classList.remove('show'); }, ms || 2200);
    timers.push(toastTimer);
  }

  /* ---------- fake loading animation, then build the GUI ---------- */
  tt.textContent = 'Loading ' + NAME + '...';
  later(function () { toast.classList.add('show'); }, 50);
  later(function () {
    spin.style.display = 'none';
    tt.textContent = '\u2705 Loaded ' + NAME + '!';
    later(function () { toast.classList.remove('show'); }, 1000);
    try { buildGUI(); } catch (err) {
      console.error(NAME, err);
      say(NAME + ' failed to build: ' + err.message, 8000);
    }
  }, 1500);

  window.__utilityGui = { destroy: destroy };

  /* =====================================================================
     GUI
     ===================================================================== */
  function buildGUI() {
    var ICON = {
      search: '<circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/>',
      gear: '<circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="8" stroke-dasharray="3.1 2.5"/>',
      min: '<path d="M5 12h14"/>',
      expand: '<rect x="5.5" y="5.5" width="13" height="13" rx="2.5"/>',
      close: '<path d="M6 6l12 12M18 6L6 18"/>',
      layout: '<rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M3 9.5h18M9.5 9.5V20"/>',
      sliders: '<path d="M4 7h9M17 7h3M4 17h3M11 17h9"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="17" r="2"/>',
      bars: '<path d="M5 20v-8M12 20V5M19 20v-5"/>',
      pen: '<path d="M14 5l5 5L9 20H4v-5z"/><path d="M12 7l5 5"/>',
      tools: '<rect x="3" y="8" width="18" height="12" rx="2"/><path d="M9 8V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 13h18"/>',
      spark: '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 16v4M17 18h4"/>',
      chev: '<path d="M6 9l6 6 6-6"/>',
      star: '<path d="M12 3l2.6 5.6 6 .8-4.4 4.2 1.1 6L12 16.9 6.7 19.6l1.1-6L3.4 9.4l6-.8z"/>',
      target: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.5"/>',
      game: '<rect x="3" y="8" width="18" height="10" rx="5"/><path d="M8 11v4M6 13h4"/><circle cx="15.5" cy="12" r=".8"/><circle cx="17.5" cy="14" r=".8"/>'
    };
    function ic(n) { return '<svg viewBox="0 0 24 24">' + ICON[n] + '</svg>'; }

    function lc(s) { return String(s).toLowerCase().replace(/"/g, ''); }
    function SEC(t) { return '<div class="sec">' + t + '</div>'; }
    function D(t) { return '<div class="desc">' + t + '</div>'; }
    function S(id, label, extra) {
      return '<div class="row" data-s="' + lc(label) + '"><span>' + label + (extra || '') + '</span><label class="sw"><input type="checkbox" id="' + id +
        '"><span class="knob"></span></label></div>';
    }
    function B(id, label) { return '<button class="btn" id="' + id + '" data-s="' + lc(label) + '">' + label + '</button>'; }
    function R(id, label, min, max, val, step) {
      return '<div class="row sl" data-s="' + lc(label) + '"><div class="lbl"><span>' + label + '</span><small id="' + id + 'v"></small></div>' +
        '<input type="range" id="' + id + '" min="' + min + '" max="' + max + '" value="' + val + '" step="' + (step || 1) + '"></div>';
    }
    function DD(id, label, opts) {
      return '<div class="row" data-s="' + lc(label) + '"><span>' + label + '</span><span class="selw"><select id="' + id + '">' + opts + '</select>' + ic('chev') + '</span></div>';
    }

    var SB_ITEMS = [
      ['Powders', 'sand', 'Sand', 'linear-gradient(135deg,#ecd29a,#c19a5b)', 'Falls and piles up. Sinks in water and turns to glass in lava.'],
      ['Powders', 'dirt', 'Dirt', 'linear-gradient(135deg,#8a6240,#5b3d26)', 'Heavy soil. Turns to mud when it soaks up water.'],
      ['Powders', 'snow', 'Snow', 'linear-gradient(135deg,#ffffff,#c9dcec)', 'Light and fluffy. Melts into water near heat.'],
      ['Powders', 'gunpowder', 'Gunpowder', 'linear-gradient(135deg,#55555c,#26262a)', 'Burns fast and explodes in a small blast when lit.'],
      ['Powders', 'ash', 'Ash', 'linear-gradient(135deg,#b8b8ba,#79797c)', 'Soft grey ash left behind by fires.'],
      ['Liquids', 'water', 'Water', 'linear-gradient(180deg,#9fdcff,#2a78c9)', 'Flows and spreads. Puts out fire, grows plants, makes mud, and cools lava.'],
      ['Liquids', 'oil', 'Oil', 'linear-gradient(180deg,#7a5a2a,#2b1a08)', 'Floats on water. Very flammable.'],
      ['Liquids', 'lava', 'Lava', 'linear-gradient(180deg,#ffd24a,#e03a08)', 'Slow, glowing and hot. Ignites things and turns to obsidian in water.'],
      ['Liquids', 'acid', 'Acid', 'linear-gradient(180deg,#b9ff7a,#35c21e)', 'Eats through most solids, giving off fumes as it goes.'],
      ['Liquids', 'napalm', 'Napalm', 'linear-gradient(180deg,#ff9a3c,#c23a0e)', 'Thick sticky fuel that burns for a very long time.'],
      ['Liquids', 'mud', 'Mud', 'linear-gradient(135deg,#6a4c34,#3b2918)', 'Wet, heavy dirt that barely slides.'],
      ['Solids', 'stone', 'Stone', 'linear-gradient(135deg,#8d9097,#5a5d63)', 'Solid rock. Only acid and blasts affect it.'],
      ['Solids', 'wood', 'Wood', 'linear-gradient(90deg,#9a6a3a,#7b4f27)', 'Solid and flammable. Burns for a long time.'],
      ['Solids', 'metal', 'Metal', 'linear-gradient(135deg,#d6dbe3,#7f8794)', 'Nearly indestructible steel. Only a nuke breaks it.'],
      ['Solids', 'ice', 'Ice', 'linear-gradient(135deg,#e6faff,#92cfe6)', 'Freezes nearby water. Melts near heat.'],
      ['Solids', 'glass', 'Glass', 'linear-gradient(135deg,#e8fffb,#9fd8d2)', 'Clear solid made when lava melts sand.'],
      ['Solids', 'plant', 'Plant', 'linear-gradient(135deg,#7ddc6a,#2f8f3c)', 'Grows when it touches water. Burns easily.'],
      ['Gases', 'fire', 'Fire', 'radial-gradient(circle at 50% 85%,#fff3b0,#ff9a1a 45%,#c41d0a)', 'Burns flammable things and rises as flames.'],
      ['Gases', 'smoke', 'Smoke', 'linear-gradient(180deg,#9a9a9a,#4a4a4a)', 'Drifts up and fades away.'],
      ['Gases', 'steam', 'Steam', 'linear-gradient(180deg,#ffffff,#cfd8e0)', 'Rises, then condenses back into water.'],
      ['Gases', 'gas', 'Gas', 'linear-gradient(180deg,#bdf5bd,#6cc46c)', 'Natural gas. Collects at the top and explodes if lit.'],
      ['Explosives', 'tnt', 'TNT', 'repeating-linear-gradient(180deg,#e9d2b8 0 3px,#c02a2a 3px 9px)', 'Explodes when touched by fire or lava, and sets off other TNT.'],
      ['Explosives', 'bomb', 'Bomb', 'radial-gradient(circle at 35% 30%,#8a8a92,#18181c 60%)', 'Click to drop a bomb. It bounces, then explodes after a short fuse.'],
      ['Explosives', 'nuke', 'Nuke', 'radial-gradient(circle at 50% 55%,#fff6c8,#ff8a1a 40%,#b3150a 75%)', 'Click to launch a nuke. It flattens the page and leaves it burning.'],
      ['Explosives', 'lightning', 'Lightning', 'linear-gradient(135deg,#ffffff,#8fb4ff)', 'Click to strike. Ignites things and fuses sand into glass.'],
      ['Tools', 'eraser', 'Eraser', 'linear-gradient(135deg,#f4a6b8,#d9647f)', 'Wipes away whatever you paint over.']
    ];
    var sbPalette = '';
    ['Powders', 'Liquids', 'Solids', 'Gases', 'Explosives', 'Tools'].forEach(function (g) {
      sbPalette += SEC(g) + '<div class="elgrid">';
      SB_ITEMS.forEach(function (it) {
        if (it[0] !== g) return;
        sbPalette += '<button class="el" id="el-' + it[1] + '" data-el="' + it[1] + '" data-s="' + it[2].toLowerCase() + ' element sandbox" data-tip="' + it[4] + '">' +
          '<i style="background:' + it[3] + '"></i>' + it[2] + '</button>';
      });
      sbPalette += '</div>';
    });

    var GAMES = [
      ['ttt', '❌', 'Tic Tac Toe', 'Get three in a row. Play the unbeatable computer or a friend.'],
      ['rps', '✊', 'Rock Paper Scissors', 'First to 5 wins the match. Beat the computer.'],
      ['snake', '🐍', 'Snake', 'Eat apples, grow longer and avoid the walls and yourself.'],
      ['pong', '🏓', 'Pong', 'The original video game. First to 7 points wins.'],
      ['breakout', '🧱', 'Breakout', 'Bounce the ball and smash every brick.'],
      ['tetris', '🟦', 'Tetris', 'Stack falling blocks and clear lines.'],
      ['g2048', '🔢', '2048', 'Slide and merge tiles to reach 2048.'],
      ['mines', '💣', 'Minesweeper', 'Uncover every safe square without hitting a mine.'],
      ['memory', '🃏', 'Memory Match', 'Flip cards and find all the pairs.'],
      ['c4', '🔴', 'Connect Four', 'Drop discs and connect four in a row.'],
      ['hangman', '🔤', 'Hangman', 'Guess the word before the drawing is finished.'],
      ['simon', '🎵', 'Simon', 'Watch the pattern, then repeat it from memory.'],
      ['flappy', '🐤', 'Flappy Bird', 'Tap to flap through the gaps between the pipes.']
    ];
    var gamesHtml = '<div class="gmgrid">' + GAMES.map(function (g) {
      return '<button class="gm" id="gm-' + g[0] + '" data-game="' + g[0] + '" data-s="' + g[2].toLowerCase() + ' game play" data-tip="' + g[3] + '">' +
        '<span class="ge">' + g[1] + '</span>' + g[2] + '</button>';
    }).join('') + '</div>';

    var TABS = [
      ['p-presets', 'star', 'Presets'], ['p-layout', 'layout', 'Layout'], ['p-adjust', 'sliders', 'Adjust'],
      ['p-data', 'bars', 'Data'], ['p-design', 'pen', 'Design'], ['p-tools', 'tools', 'Tools'],
      ['p-focus', 'target', 'Focus'], ['p-fun', 'spark', 'Fun'], ['p-play', 'game', 'Play']
    ];
    var tabsHtml = TABS.map(function (t, i) {
      return '<button class="tab' + (i === 0 ? ' active' : '') + '" data-tab="' + t[0] + '">' + ic(t[1]) + t[2] + '</button>';
    }).join('');

    var GUI =
      '<div id="hud"><div id="inner">' +
        '<div id="hdr"><div><h3>' + NAME + '</h3><small>Bookmarklet toolkit</small></div><div class="hbtns">' +
          '<button class="ico hmore" id="search" title="Search features">' + ic('search') + '</button>' +
          '<button class="ico hmore" id="gear" title="Settings">' + ic('gear') + '</button>' +
          '<button class="ico" id="min" title="Collapse">' + ic('min') + '</button>' +
          '<button class="ico" id="close" title="Close">' + ic('close') + '</button></div></div>' +
        '<div id="tabs"><div id="tabrow"><div id="tabind"></div>' + tabsHtml + '</div></div>' +
        '<div id="searchbar"><input type="text" id="q" placeholder="Search features..."></div>' +
        '<div id="body">' +
          '<div id="results" style="display:none"><div class="sec" id="rtitle"></div><div id="rlist"></div><div class="rdiv"></div></div>' +

          '<div class="pane active" id="p-presets">' +
            '<div id="favs" style="display:none"><div class="sec">Pinned</div><div id="favlist"></div></div>' +
            SEC('One-tap setups') +
            B('pr-night', 'Night Reading') +
            D('Dark reader theme, roomy line spacing, a narrow column and no pinned bars.') +
            B('pr-focus', 'Focus Mode') +
            D('Hides pinned bars, freezes animations, narrows the page and adds a reading ruler.') +
            B('pr-clean', 'Declutter') +
            D('Hides likely ads, pinned bars and popups.') +
            B('pr-print', 'Clean & Print') +
            D('Applies a clean reader layout, then opens the print dialog.') +
            B('pr-easy', 'Easy Reading') +
            D('Larger zoom with extra letter, word and line spacing.') +
            B('pr-party', 'Party Mode') +
            D('Rainbow colors, sparkles, snow and a confetti burst.') +
            SEC('Reset') +
            B('pr-reset', 'Reset Everything') +
            D('Turns off every effect and puts every slider back to its default.') +
          '</div>' +

          '<div class="pane" id="p-layout">' +
            SEC('Appearance') +
            S('dark', 'Dark Mode') +
            S('read', 'Reader Mode') +
            S('img', 'Hide Images') +
            S('gray', 'Grayscale') +
            S('still', 'Freeze Animations') +
            S('fix', 'Hide Sticky / Fixed Bars') +
            D('Hides headers, cookie bars and other pinned elements.') +
            SEC('Reading Aids') +
            S('progress', 'Reading Progress Bar') +
            S('linkurls', 'Show Link URLs') +
            D('Prints each link\u2019s address right after its text.') +
            S('newtab', 'Open Links in New Tab') +
            S('bigcur', 'Big Cursor') +
            SEC('Scrolling & Size') +
            R('scroll', 'Auto Scroll Speed', 0, 10, 0) +
            R('zoom', 'Page Zoom', 50, 200, 100, 10) +
            R('mw', 'Max Content Width', 0, 2000, 0, 50) +
            R('op', 'Page Opacity', 20, 100, 100, 5) +
          '</div>' +

          '<div class="pane" id="p-adjust">' +
            SEC('Color') +
            R('bri', 'Brightness', 20, 200, 100, 5) +
            R('con', 'Contrast', 50, 200, 100, 5) +
            R('sat', 'Saturation', 0, 300, 100, 5) +
            R('sep', 'Sepia', 0, 100, 0, 5) +
            R('hue', 'Hue Rotate', 0, 360, 0, 5) +
            R('blur', 'Blur', 0, 10, 0, 0.5) +
            SEC('Eyes') +
            R('blf', 'Blue Light Filter', 0, 60, 0, 5) +
            DD('cvd', 'Color Vision Simulator', '<option value="">Normal</option><option value="prot">Protanopia</option>' +
              '<option value="deut">Deuteranopia</option><option value="trit">Tritanopia</option><option value="achro">Achromatopsia</option>') +
            D('Previews how the page looks to people with different kinds of color blindness.') +
            SEC('Text') +
            R('lh', 'Line Height', 0, 3, 0, 0.1) +
            R('ls', 'Letter Spacing', 0, 6, 0, 0.5) +
            R('ws', 'Word Spacing', 0, 20, 0, 1) +
            B('reset', 'Reset All Adjustments') +
          '</div>' +

          '<div class="pane" id="p-data">' +
            '<div class="stat"><div class="st-top">' + ic('bars') + '<span>Words on this page</span></div>' +
              '<div class="st-bot"><span id="stval">0</span><span class="st-chg" id="stchg"></span></div></div>' +
            SEC('Collect') +
            B('links', 'Harvest Links') +
            B('emails', 'Extract Emails') +
            B('imgs', 'Download Images') +
            B('tables', 'Tables \u2192 CSV') +
            SEC('Analyze') +
            B('heads', 'Heading Outline') +
            B('text', 'Copy Page Text') +
            B('stats', 'Page Stats') +
            B('fonts', 'Fonts & Colors') +
            SEC('Audit') +
            B('seo', 'SEO & Accessibility Check') +
            B('weight', 'Largest Resources') +
            B('storage', 'Storage Report') +
            SEC('Media') +
            B('gallery', 'Image Gallery') +
            B('medialinks', 'Video & Audio Links') +
            SEC('Export') +
            B('mdpage', 'Copy Page as Markdown') +
            B('savehtml', 'Save Page as HTML') +
            '<div id="out"></div>' +
          '</div>' +

          '<div class="pane" id="p-design">' +
            SEC('Edit') +
            S('edit', 'Page Editor') +
            D('Click anywhere on the page and type to change the text.') +
            S('outline', 'Outline Elements') +
            S('inspect', 'Inspect Elements') +
            D('Hover any element to see its size, font and colors. Click to copy a CSS selector.') +
            S('hl', 'Highlight Links') +
            DD('font', 'Font', '<option value="">Default</option><option value="Georgia,serif">Serif</option>' +
              '<option value="system-ui,sans-serif">Sans</option><option value="ui-monospace,Menlo,Consolas,monospace">Monospace</option>' +
              '<option value="&quot;Comic Sans MS&quot;,&quot;Comic Neue&quot;,cursive">Comic</option>' +
              '<option value="Impact,Haettenschweiler,sans-serif">Impact</option>') +
            B('eye', 'Pick Color (copies hex)') +
            SEC('Draw') +
            S('doodle', 'Doodle on Page', '<input type="color" id="dcol" value="#ef4444">') +
            R('brush', 'Brush Size', 1, 30, 4, 1) +
            B('dclear', 'Clear Doodles') +
            SEC('Guides') +
            S('grid', 'Grid Overlay') +
            R('gridsz', 'Grid Size', 10, 200, 40, 5) +
            S('ruler', 'Reading Ruler') +
            R('rulerh', 'Ruler Height', 20, 300, 60, 10) +
            SEC('Custom CSS') +
            '<div class="row col" data-s="custom css style stylesheet"><span>Your CSS</span>' +
              '<textarea id="css" spellcheck="false" placeholder="body { background: #111; }"></textarea></div>' +
            D('Applies instantly as you type. Re-applied next time if Remember Settings is on.') +
            B('cssclear', 'Clear Custom CSS') +
          '</div>' +

          '<div class="pane" id="p-tools">' +
            SEC('Page') +
            S('unlock', 'Unlock Copy & Right-Click') +
            D('Re-enables text selection, copy and the context menu on locked pages.') +
            S('pw', 'Show Passwords') +
            S('del', 'Delete Elements') +
            D('Click anything on the page to remove it. Esc stops.') +
            S('mute', 'Mute All Media') +
            S('ads', 'Hide Likely Ads') +
            D('Hides elements that look like ads. Turn it off to bring them back.') +
            B('undo', 'Undo Delete') +
            B('overlays', 'Remove Popups') +
            SEC('Navigate') +
            B('top', 'Scroll to Top') +
            B('bottom', 'Scroll to Bottom') +
            B('md', 'Copy Markdown Link') +
            B('clean', 'Copy Clean URL') +
            B('wayback', 'Open in Wayback Machine') +
            B('print', 'Print Page') +
            SEC('Media & Timing') +
            R('rate', 'Video / Audio Speed', 0.25, 4, 1, 0.25) +
            R('refresh', 'Auto Refresh', 0, 120, 0, 5) +
            SEC('Find') +
            '<div class="row" data-s="find highlight"><span>Highlight</span><input type="text" id="find" placeholder="Input"></div>' +
            SEC('Find & Replace') +
            '<div class="row" data-s="replace find text"><span>Find</span><input type="text" id="frfind" placeholder="Text"></div>' +
            '<div class="row" data-s="replace with text"><span>Replace With</span><input type="text" id="frrepl" placeholder="New text"></div>' +
            B('frgo', 'Replace All on Page') +
            B('frundo', 'Undo Replace') +
            SEC('Video & Capture') +
            B('pip', 'Picture-in-Picture') +
            S('loop', 'Loop All Videos') +
            B('shot', 'Take Screenshot') +
            D('Asks you to share this tab, then saves a PNG without the panel in it.') +
          '</div>' +

          '<div class="pane" id="p-focus">' +
            SEC('Read Aloud') +
            B('tts', 'Read Aloud') +
            D('Reads your selection, or the whole page if nothing is selected.') +
            B('ttsstop', 'Stop Reading') +
            R('ttsrate', 'Reading Speed', 0.5, 2, 1, 0.1) +
            SEC('Focus Timer') +
            R('ftmin', 'Session Length', 1, 90, 25, 1) +
            B('ftstart', 'Start Focus Timer') +
            D('Counts down and plays a chime when the session ends.') +
            SEC('Notes') +
            '<div class="row col" data-s="notes scratchpad memo"><span>Scratchpad</span>' +
              '<textarea id="notes" placeholder="Type notes for this site..."></textarea></div>' +
            B('notecopy', 'Copy Notes') +
            D('Notes are saved in this browser, separately for each site.') +
          '</div>' +

          '<div class="pane" id="p-fun">' +
            SEC('Effects') +
            S('matrix', 'Matrix Rain') +
            R('mspeed', 'Rain Speed', 1, 8, 6, 1) +
            S('snow', 'Snowfall') +
            R('snowamt', 'Snow Amount', 10, 400, 120, 10) +
            S('rainbow', 'Rainbow Mode') +
            R('rbspeed', 'Seconds per Cycle', 1, 20, 6, 1) +
            S('trail', 'Cursor Sparkle Trail') +
            R('trailsz', 'Sparkle Size', 2, 15, 5, 1) +
            S('spot', 'Spotlight') +
            R('spotsz', 'Spotlight Size', 60, 400, 150, 10) +
            S('fireworks', 'Fireworks (click to launch)') +
            R('fwsize', 'Firework Size', 40, 200, 90, 10) +
            S('bubbles', 'Bubbles') +
            R('bubamt', 'Bubble Amount', 10, 150, 50, 5) +
            SEC('Actions') +
            B('confetti', 'Confetti') +
            R('confamt', 'Confetti Amount', 50, 500, 160, 10) +
            B('roll', 'Barrel Roll') +
            B('shake', 'Earthquake') +
            R('shakeamt', 'Quake Strength', 2, 40, 12, 1) +
            SEC('Weather & Space') +
            S('rain', 'Rain & Lightning') +
            R('rainamt', 'Rain Amount', 20, 400, 150, 10) +
            S('stars', 'Starfield Warp') +
            R('starspd', 'Warp Speed', 1, 15, 6, 1) +
            SEC('Party') +
            S('emoji', 'Emoji Rain') +
            DD('emoset', 'Emoji Set', '<option value="party">Party</option><option value="food">Food</option><option value="space">Space</option>' +
              '<option value="animals">Animals</option><option value="love">Love</option>') +
            R('emoamt', 'Emoji Amount', 5, 80, 30, 5) +
            S('disco', 'Disco Lights') +
            R('discospd', 'Disco Speed', 1, 10, 5, 1) +
            S('ripples', 'Click Ripples') +
            S('buddy', 'Cursor Buddy') +
            DD('budemoji', 'Buddy', '<option value="\uD83D\uDC31">Cat</option><option value="\uD83D\uDC36">Dog</option><option value="\uD83E\uDD84">Unicorn</option>' +
              '<option value="\uD83D\uDC7B">Ghost</option><option value="\uD83D\uDE80">Rocket</option><option value="\uD83D\uDC38">Frog</option><option value="\uD83E\uDD16">Robot</option>') +
            R('budsz', 'Buddy Size', 20, 80, 36, 2) +
            SEC('Looks') +
            DD('texteff', 'Text Effect', '<option value="">Normal</option><option value="up">UPPERCASE</option><option value="low">lowercase</option>' +
              '<option value="cap">Capitalize Each Word</option><option value="mirror">Mirror Page</option><option value="flip">Upside Down</option>' +
              '<option value="wobble">Wobble</option><option value="glitch">Chromatic Glitch</option><option value="neon">Neon Glow</option>') +
            S('hacker', 'Hacker Terminal') +
            S('scan', 'CRT Scanlines') +
            R('scanamt', 'Scanline Strength', 10, 100, 40, 5) +
            S('grain', 'Film Grain') +
            R('grainamt', 'Grain Amount', 5, 100, 30, 5) +
            SEC('Chaos') +
            B('gravity', 'Drop Everything') +
            D('Makes the text and images on screen fall to the bottom.') +
            B('gravityundo', 'Restore Gravity') +
            SEC('Sound') +
            S('sounds', 'Click Sounds') +
            DD('sndstyle', 'Sound Style', '<option value="pop">Pop</option><option value="coin">Coin</option><option value="laser">Laser</option><option value="bell">Bell</option>') +
            R('sndvol', 'Sound Volume', 10, 100, 50, 5) +
            SEC('Random') +
            B('surprise', 'Surprise Me') +
            D('Turns on three random effects.') +
            B('stopfx', 'Stop All Effects') +
          '</div>' +

          '<div class="pane" id="p-play">' +
            SEC('Element Sandbox') +
            B('opensb', 'Open Element Sandbox \u203A') +
            D('Draw sand, water, fire, explosives and more right on the page. There is even a nuke.') +
            SEC('Games') +
            gamesHtml +
            D('Every game opens in its own window. Press Esc to close it.') +
          '</div>' +

          '<div class="pane" id="p-sandbox">' +
            B('sbback', '\u2039 Back to Play') +
            SEC('Element Sandbox') +
            S('sbox', 'Sandbox On') +
            D('Draws over the page. Pick an element below, then hold the mouse and drag on the page.') +
            sbPalette +
            SEC('Brush') +
            R('sbbrush', 'Brush Size', 1, 24, 5, 1) +
            R('sbres', 'Pixel Size (smaller is sharper)', 2, 8, 4, 1) +
            SEC('Physics') +
            R('sbgrav', 'Gravity', 1, 10, 5, 1) +
            R('sbspeed', 'Simulation Speed', 1, 4, 1, 1) +
            R('sbwind', 'Wind', -5, 5, 0, 1) +
            S('sbghost', 'Ignore Page Elements') +
            D('Normally sand, water and debris land on the page\u2019s text, images and buttons. Turn this on to let them fall straight through.') +
            S('sbpass', 'Let Clicks Pass Through') +
            S('sbmute', 'Mute Explosions') +
            SEC('Actions') +
            B('sbpause', 'Pause') +
            B('sbclear', 'Clear Sandbox') +
            B('sbrestore', 'Restore Page') +
            D('Brings the page back after a nuke and removes the burn marks.') +
          '</div>' +

          '<div class="pane" id="p-settings">' +
            SEC('Interface') +
            DD('accent', 'Accent Color', '<option>Emerald</option><option>Ocean</option><option>Violet</option><option>Rose</option><option>Amber</option>') +
            R('pscale', 'Panel Scale', 80, 160, Math.round(SCALE * 100), 5) +
            R('popacity', 'Panel Opacity', 60, 100, 97, 1) +
            '<div class="row" data-s="collapse key keybind"><span>Collapse Key</span><button class="keybtn" id="keybtn">Esc</button></div>' +
            D('Click the button, then press any key to rebind it.') +
            DD('theme', 'Panel Theme', '<option>Dark</option><option>Light</option>') +
            S('compact', 'Compact Mode') +
            D('Tighter rows so more fits on screen.') +
            D('Tip: right-click any feature to pin it to the top of Presets.') +
            B('resetpos', 'Reset Panel Position') +
            SEC('Memory') +
            S('remember', 'Remember Settings on This Site') +
            D('Re-applies your toggles and sliders the next time you open Utility.Gui on this site. Panel look and position are always remembered.') +
            B('cleardata', 'Clear Saved Data') +
            D('Deletes saved settings, notes and panel position from this browser.') +
            SEC('Share') +
            B('exportcfg', 'Copy My Setup') +
            D('Copies your current settings as text so you can load them on another site.') +
            B('importcfg', 'Load a Setup') +
            D('Paste a setup you copied earlier to apply it here.') +
          '</div>' +

        '</div>' +
        '<div id="grip" title="Drag to move"><span></span></div>' +
      '</div></div><div id="tip"></div>';

    var wrap = document.createElement('div');
    wrap.innerHTML = GUI;
    root.appendChild(wrap);

    var $ = function (s) { return root.querySelector(s); };
    var hud = $('#hud');
    var out = $('#out');
    var ckey = 'Escape';
    var binding = false;

    /* ---------- small helpers ---------- */
    function sw(id, on, off) {
      $('#' + id).addEventListener('change', function (e) {
        if (e.target.checked) on(); else if (off) off();
      });
    }
    function cls(id, c) {
      sw(id, function () { html.classList.add(c); }, function () { html.classList.remove(c); });
    }
    function setSwitch(id, v) {
      var el = $('#' + id);
      if (el.checked !== v) { el.checked = v; el.dispatchEvent(new Event('change')); }
    }
    function click(id, fn) { $('#' + id).addEventListener('click', fn); }
    function show(text) { out.textContent = text; out.style.display = 'block'; }

    var sliders = {};
    function rng(id, fn, fmt) {
      var el = $('#' + id);
      var lab = $('#' + id + 'v');
      var def = el.value;
      var mn = parseFloat(el.min);
      var mx = parseFloat(el.max);
      function upd() {
        var v = parseFloat(el.value);
        lab.textContent = fmt ? fmt(v) : v;
        el.style.setProperty('--f', (v - mn) / (mx - mn));
        return v;
      }
      el.addEventListener('input', function () { fn(upd()); });
      upd();
      sliders[id] = {
        reset: function () { el.value = def; fn(upd()); },
        set: function (v) { el.value = v; fn(upd()); }
      };
    }
    var pct = function (v) { return v + '%'; };
    var offOr = function (suffix) { return function (v) { return v ? v + (suffix || '') : 'off'; }; };
    var pxf = function (v) { return v + 'px'; };

    function copy(text) {
      function fallback() {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.style.cssText = 'position:fixed;opacity:0;top:0;left:0';
        document.body.appendChild(ta);
        ta.select();
        var ok = false;
        try { ok = document.execCommand('copy'); } catch (e) {}
        ta.remove();
        return ok;
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        return navigator.clipboard.writeText(text).then(function () { return true; }, function () { return fallback(); });
      }
      return Promise.resolve(fallback());
    }

    function saveBlob(name, blob) {
      var a = document.createElement('a');
      var url = URL.createObjectURL(blob);
      a.href = url;
      a.download = name;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(function () { URL.revokeObjectURL(url); }, 5000);
    }

    function unique(arr) {
      var seen = {};
      return arr.filter(function (v) { var k = v.toLowerCase(); if (seen[k]) return false; seen[k] = 1; return true; });
    }

    function toHex(c) {
      var m = c.match(/\d+(\.\d+)?/g);
      if (!m || m.length < 3) return c;
      return '#' + m.slice(0, 3).map(function (n) {
        return ('0' + Math.round(+n).toString(16)).slice(-2);
      }).join('');
    }

    function topN(obj, n) {
      return Object.keys(obj).sort(function (a, b) { return obj[b] - obj[a]; }).slice(0, n);
    }

    function mkDiv(id, css) {
      var d = document.createElement('div');
      d.id = id;
      d.style.cssText = css;
      html.appendChild(d);
      extras.push(d);
      return d;
    }

    /* ---------- canvas overlays + animation loop ---------- */
    function overlay(id, interactive) {
      var c = document.createElement('canvas');
      c.id = id;
      c.style.cssText = 'position:fixed;top:0;left:0;width:100vw;height:100vh;pointer-events:' +
        (interactive ? 'auto' : 'none') + ';z-index:2147483646;';
      c.width = window.innerWidth;
      c.height = window.innerHeight;
      html.appendChild(c);
      var onResize = function () { c.width = window.innerWidth; c.height = window.innerHeight; };
      window.addEventListener('resize', onResize);
      return {
        c: c,
        ctx: c.getContext('2d'),
        close: function () { window.removeEventListener('resize', onResize); c.remove(); }
      };
    }

    function loop(fn) {
      var on = true;
      var id;
      function step(t) {
        if (!on) return;
        fn(t);
        if (on) id = requestAnimationFrame(step);
      }
      id = requestAnimationFrame(step);
      return function () { on = false; cancelAnimationFrame(id); };
    }

    /* ---------- tabs / search / settings / collapse / close ---------- */
    var tabsEl = $('#tabs');
    var ind = $('#tabind');
    var tabBtns = Array.prototype.slice.call(root.querySelectorAll('.tab'));
    var curIdx = 0;
    function moveInd(btn, instant) {
      if (!btn) { ind.classList.add('off'); return; }
      ind.classList.remove('off');
      ind.style.width = btn.offsetWidth + 'px';
      ind.style.transform = 'translateX(' + btn.offsetLeft + 'px)';
      var left = Math.max(0, btn.offsetLeft - (tabsEl.clientWidth - btn.offsetWidth) / 2);
      if (instant) tabsEl.scrollLeft = left;
      else tabsEl.scrollTo({ left: left, behavior: 'smooth' });
    }
    function showTab(id, instant) {
      hideTip();
      var hl = id === 'p-sandbox' ? 'p-play' : id;
      var idx = -1;
      tabBtns.forEach(function (b, i) {
        var on = b.getAttribute('data-tab') === hl;
        b.classList.toggle('active', on);
        if (on) idx = i;
      });
      var pos = idx === -1 ? tabBtns.length : idx + (id === 'p-sandbox' ? 0.5 : 0);
      $('#body').style.setProperty('--dir', pos >= curIdx ? 1 : -1);
      curIdx = pos;
      root.querySelectorAll('.pane').forEach(function (p) { p.classList.toggle('active', p.id === id); });
      $('#body').scrollTop = 0;
      moveInd(idx === -1 ? null : tabBtns[idx], instant);
      gset('tab', hl);
    }
    tabBtns.forEach(function (btn) {
      btn.addEventListener('click', function () { showTab(btn.getAttribute('data-tab')); });
    });
    tabsEl.addEventListener('wheel', function (e) {
      if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) { tabsEl.scrollLeft += e.deltaY; e.preventDefault(); }
    }, { passive: false });
    $('#gear').addEventListener('click', function () { showTab('p-settings'); });

    var moved = [];
    function restoreMoved() {
      moved.forEach(function (m) { if (m.ph.parentNode) m.ph.parentNode.replaceChild(m.el, m.ph); });
      moved = [];
    }
    function grab(el, list) {
      var ph = document.createComment('ug');
      el.parentNode.insertBefore(ph, el);
      list.appendChild(el);
      moved.push({ el: el, ph: ph });
      var nx = ph.nextElementSibling;
      if (nx && nx.classList.contains('desc')) {
        var ph2 = document.createComment('ug');
        nx.parentNode.insertBefore(ph2, nx);
        list.appendChild(nx);
        moved.push({ el: nx, ph: ph2 });
      }
    }
    function applySearch(raw) {
      hideTip();
      restoreMoved();
      var q = raw.trim().toLowerCase();
      var box = $('#results');
      var list = $('#rlist');
      list.textContent = '';
      if (!q) { box.style.display = 'none'; return; }
      var words = q.split(/\s+/);
      var found = [];
      root.querySelectorAll('#body .pane [data-s]').forEach(function (el, i) {
        var lab = el.getAttribute('data-s');
        var nx = el.nextElementSibling;
        var extra = ((el.getAttribute('data-k') || '') + ' ' + (el.getAttribute('data-tip') || '') + ' ' +
          (nx && nx.classList.contains('desc') ? nx.textContent : '')).toLowerCase();
        var all = lab + ' ' + extra;
        if (!words.every(function (w) { return all.indexOf(w) !== -1; })) return;
        found.push({ el: el, i: i, score: lab.indexOf(q) === 0 ? 0 : (lab.indexOf(q) !== -1 ? 1 : 2) });
      });
      found.sort(function (a, b) { return a.score - b.score || a.i - b.i; });
      $('#rtitle').textContent = found.length ? 'Results (' + found.length + ')' : 'No results';
      if (!found.length) {
        var none = document.createElement('div');
        none.className = 'desc';
        none.textContent = 'Nothing matches "' + raw.trim() + '". Try another word.';
        list.appendChild(none);
      }
      found.forEach(function (f) { grab(f.el, list); });
      box.style.display = 'block';
      $('#body').scrollTop = 0;
    }
    function toggleSearch() {
      var bar = $('#searchbar');
      var open = bar.classList.toggle('open');
      if (open) { $('#q').focus(); }
      else { $('#q').value = ''; applySearch(''); }
    }
    $('#search').addEventListener('click', toggleSearch);
    $('#q').addEventListener('input', function (e) { applySearch(e.target.value); });
    $('#q').addEventListener('keydown', function (e) {
      e.stopPropagation();
      if (e.key === 'Escape') toggleSearch();
    });

    function toggleCollapse() {
      hideTip();
      var c = hud.classList.toggle('collapsed');
      $('#min').innerHTML = ic(c ? 'expand' : 'min');
      $('#min').title = c ? 'Expand' : 'Collapse';
    }
    $('#min').addEventListener('click', toggleCollapse);
    $('#hdr').addEventListener('dblclick', function (e) {
      if (!e.target.closest('.ico')) toggleCollapse();
    });
    $('#close').addEventListener('click', destroy);

    /* dragging (pointer events: mouse + touch), from the header or the grip bar */
    var drag = null;
    function makeDraggable(el) {
      el.addEventListener('pointerdown', function (e) {
        if (e.target.closest('.ico')) return;
        hideTip();
        var r = hud.getBoundingClientRect();
        drag = { dx: e.clientX - r.left, dy: e.clientY - r.top };
        hud.style.right = 'auto';
        el.setPointerCapture(e.pointerId);
      });
      el.addEventListener('pointermove', function (e) {
        if (!drag) return;
        var vw = window.innerWidth;
        var vh = window.innerHeight;
        var w = hud.offsetWidth;
        var h = hud.offsetHeight;
        var x = Math.min(Math.max(0, e.clientX - drag.dx), vw - 80);
        var y = Math.min(Math.max(0, e.clientY - drag.dy), vh - 40);
        if (x < 22) x = 12;
        if (Math.abs(x + w - vw) < 22) x = vw - w - 12;
        if (y < 22) y = 12;
        if (Math.abs(y + h - vh) < 22) y = vh - h - 12;
        hud.style.left = x + 'px';
        hud.style.top = y + 'px';
      });
      el.addEventListener('pointerup', function () {
        if (drag) gset('pos', { left: hud.style.left, top: hud.style.top });
        drag = null;
      });
    }
    makeDraggable($('#hdr'));
    makeDraggable($('#grip'));

    /* =================== SETTINGS =================== */
    $('#accent').addEventListener('change', function (e) { applyAccent(e.target.value); gset('accent', e.target.value); });
    rng('pscale', function (v) {
      SCALE = v / 100;
      hud.style.width = (360 * SCALE) + 'px';
      hud.style.maxHeight = (520 * SCALE) + 'px';
      $('#inner').style.zoom = SCALE;
      gset('scale', v);
    }, pct);
    rng('popacity', function (v) {
      hud.style.background = 'rgba(17,17,17,' + (v / 100) + ')';
      gset('opacity', v);
    }, pct);
    function keyName(k) { return k === 'Escape' ? 'Esc' : (k === ' ' ? 'Space' : (k.length === 1 ? k.toUpperCase() : k)); }
    $('#keybtn').addEventListener('click', function () { binding = true; this.textContent = 'Press a key...'; });
    click('resetpos', function () {
      hud.style.left = '';
      hud.style.top = '20px';
      hud.style.right = '20px';
      gset('pos', null);
    });

    /* =================== LAYOUT =================== */
    cls('dark', 'ug-dark');
    cls('read', 'ug-reader');
    cls('img', 'ug-noimg');
    cls('still', 'ug-still');

    sw('gray', function () { F.g = 1; updateFilt(); }, function () { F.g = 0; updateFilt(); });

    sw('fix', function () {
      var n = 0;
      document.body.querySelectorAll('*').forEach(function (el) {
        var p = getComputedStyle(el).position;
        if (p === 'fixed' || p === 'sticky') { el.classList.add('ug-hidefix'); n++; }
      });
      say('Hid ' + n + ' fixed/sticky elements');
    }, function () {
      document.querySelectorAll('.ug-hidefix').forEach(function (el) { el.classList.remove('ug-hidefix'); });
    });

    function scrollLoop() {
      if (scrollSpeed > 0) { window.scrollBy(0, scrollSpeed); scrollRaf = requestAnimationFrame(scrollLoop); }
      else scrollRaf = null;
    }
    rng('scroll', function (v) {
      scrollSpeed = v;
      if (scrollSpeed > 0 && !scrollRaf) scrollRaf = requestAnimationFrame(scrollLoop);
    }, offOr());
    function stopScroll() {
      if (!scrollSpeed) return;
      sliders.scroll.reset();
    }
    window.addEventListener('wheel', stopScroll, { passive: true });
    window.addEventListener('touchstart', stopScroll, { passive: true });
    cleanups.push(function () {
      window.removeEventListener('wheel', stopScroll);
      window.removeEventListener('touchstart', stopScroll);
    });

    rng('zoom', function (v) { document.body.style.zoom = v / 100; }, pct);
    rng('mw', function (v) { T.mw = v; updateAdj(); }, offOr('px'));
    rng('op', function (v) { T.op = v; updateAdj(); }, pct);

    /* =================== ADJUST =================== */
    rng('bri', function (v) { F.b = v; updateFilt(); }, pct);
    rng('con', function (v) { F.c = v; updateFilt(); }, pct);
    rng('sat', function (v) { F.s = v; updateFilt(); }, pct);
    rng('sep', function (v) { F.sp = v; updateFilt(); }, pct);
    rng('blur', function (v) { F.bl = v; updateFilt(); }, pxf);
    rng('hue', function (v) { F.h = v; updateFilt(); }, function (v) { return v + '\u00B0'; });
    rng('lh', function (v) { T.lh = v; updateAdj(); }, offOr());
    rng('ls', function (v) { T.ls = v; updateAdj(); }, offOr('px'));
    rng('ws', function (v) { T.ws = v; updateAdj(); }, offOr('px'));
    click('reset', function () {
      ['bri', 'con', 'sat', 'sep', 'blur', 'hue', 'lh', 'ls', 'ws'].forEach(function (k) { sliders[k].reset(); });
      say('Adjustments reset');
    });

    /* =================== DATA =================== */
    function refreshStat() {
      var t = document.body.innerText || '';
      var w = (t.trim().match(/\S+/g) || []).length;
      $('#stval').textContent = w.toLocaleString() + ' words';
      $('#stchg').textContent = '~' + Math.max(1, Math.round(w / 200)) + ' min read';
      return { text: t, words: w };
    }
    refreshStat();

    click('links', function () {
      var seen = {};
      var list = [];
      document.querySelectorAll('a[href]').forEach(function (a) {
        var h = a.href;
        if (h && /^https?:/i.test(h) && !seen[h]) { seen[h] = 1; list.push(h); }
      });
      if (!list.length) return say('No links found');
      show(list.join('\n'));
      copy(list.join('\n')).then(function (ok) {
        say(ok ? 'Copied ' + list.length + ' unique links' : 'Found ' + list.length + ' links (copy blocked)');
      });
    });

    click('emails', function () {
      var re = /[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}/g;
      var found = (document.body.innerText.match(re) || []).slice();
      document.querySelectorAll('a[href^="mailto:" i]').forEach(function (a) {
        a.getAttribute('href').replace(/^mailto:/i, '').split('?')[0].split(',').forEach(function (x) {
          try { x = decodeURIComponent(x.trim()); } catch (e) {}
          if (x.indexOf('@') > 0) found.push(x);
        });
      });
      var list = unique(found);
      if (!list.length) return say('No emails found');
      show(list.join('\n'));
      copy(list.join('\n')).then(function (ok) {
        say(ok ? 'Copied ' + list.length + ' emails' : 'Found ' + list.length + ' emails (copy blocked)');
      });
    });

    click('imgs', function () {
      var seen = {};
      var urls = [];
      document.querySelectorAll('img').forEach(function (img) {
        var u = img.currentSrc || img.src;
        if (u && !/^data:/i.test(u) && !seen[u]) { seen[u] = 1; urls.push(u); }
      });
      urls = urls.slice(0, 50);
      if (!urls.length) return say('No downloadable images found');
      say('Downloading ' + urls.length + ' images...', 4000);
      var failed = [];
      var done = 0;
      urls.reduce(function (chain, u, i) {
        return chain.then(function () {
          return fetch(u).then(function (r) {
            if (!r.ok) throw new Error('bad status');
            return r.blob();
          }).then(function (blob) {
            saveBlob((u.split('?')[0].split('/').pop() || 'image-' + i).slice(0, 80), blob);
            done++;
          }).catch(function () { failed.push(u); });
        });
      }, Promise.resolve()).then(function () {
        if (!failed.length) return say('Downloaded ' + done + ' images');
        show(failed.join('\n'));
        copy(failed.join('\n')).then(function () {
          say(done + ' saved. ' + failed.length + ' blocked by the site (CORS), URLs copied', 4500);
        });
      });
    });

    click('tables', function () {
      var tables = Array.prototype.slice.call(document.querySelectorAll('table')).slice(0, 10);
      if (!tables.length) return say('No tables found');
      tables.forEach(function (t, i) {
        var csv = Array.prototype.map.call(t.rows, function (row) {
          return Array.prototype.map.call(row.cells, function (c) {
            return '"' + c.innerText.replace(/\s+/g, ' ').trim().replace(/"/g, '""') + '"';
          }).join(',');
        }).join('\n');
        later(function () { saveBlob('table-' + (i + 1) + '.csv', new Blob([csv], { type: 'text/csv' })); }, i * 300);
      });
      say('Saving ' + tables.length + ' table(s) as CSV');
    });

    click('heads', function () {
      var lines = Array.prototype.map.call(document.querySelectorAll('h1,h2,h3,h4,h5,h6'), function (h) {
        var lvl = parseInt(h.tagName.charAt(1), 10);
        return new Array(lvl).join('  ') + h.innerText.replace(/\s+/g, ' ').trim().slice(0, 100);
      }).filter(function (l) { return l.trim(); });
      if (!lines.length) return say('No headings found');
      show(lines.join('\n'));
      copy(lines.join('\n')).then(function () { say('Copied ' + lines.length + ' headings'); });
    });

    click('text', function () {
      var sel = String(window.getSelection() || '');
      var t = sel.trim() ? sel : document.body.innerText;
      copy(t).then(function (ok) {
        say(ok ? 'Copied ' + t.length + ' characters' + (sel.trim() ? ' (your selection)' : '') : 'Copy blocked');
      });
    });

    click('stats', function () {
      var s = refreshStat();
      var sel = (String(window.getSelection() || '').trim().match(/\S+/g) || []).length;
      var lines = [
        'Words: ' + s.words,
        'Characters: ' + s.text.length,
        'Reading time: ~' + Math.max(1, Math.round(s.words / 200)) + ' min',
        'Selected words: ' + sel,
        'Links: ' + document.links.length,
        'Images: ' + document.images.length,
        'Headings: ' + document.querySelectorAll('h1,h2,h3,h4,h5,h6').length,
        'Tables: ' + document.querySelectorAll('table').length,
        'Forms: ' + document.forms.length,
        'Scripts: ' + document.scripts.length,
        'DOM nodes: ' + document.getElementsByTagName('*').length,
        'Max nesting depth: ' + (function () {
          var md = 0;
          Array.prototype.forEach.call(document.getElementsByTagName('*'), function (e) {
            var d = 0;
            var n = e;
            while ((n = n.parentElement)) d++;
            if (d > md) md = d;
          });
          return md;
        })()
      ];
      var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
      var res = performance.getEntriesByType ? performance.getEntriesByType('resource') : [];
      var bytes = 0;
      res.forEach(function (r) { bytes += r.transferSize || 0; });
      if (nav && (nav.loadEventEnd || nav.domComplete)) lines.push('Load time: ' + Math.round(nav.loadEventEnd || nav.domComplete) + ' ms');
      lines.push('Requests: ' + res.length);
      if (bytes) lines.push('Transferred: ~' + Math.round(bytes / 1024) + ' KB');
      show(lines.join('\n'));
    });

    click('fonts', function () {
      var fonts = {};
      var colors = {};
      Array.prototype.slice.call(document.body.querySelectorAll('*'), 0, 1500).forEach(function (el) {
        var s = getComputedStyle(el);
        var f = s.fontFamily.split(',')[0].replace(/["']/g, '').trim();
        fonts[f] = (fonts[f] || 0) + 1;
        [s.color, s.backgroundColor].forEach(function (c) {
          if (c && c !== 'rgba(0, 0, 0, 0)') { var h = toHex(c); colors[h] = (colors[h] || 0) + 1; }
        });
      });
      show('FONTS\n' + topN(fonts, 6).join('\n') + '\n\nCOLORS\n' + topN(colors, 10).join('\n'));
    });

    /* =================== DESIGN =================== */
    sw('edit', function () { document.designMode = 'on'; }, function () { document.designMode = 'off'; });
    cls('outline', 'ug-outline');
    cls('hl', 'ug-links');

    $('#font').addEventListener('change', function (e) {
      var v = e.target.value;
      fontStyle.textContent = v ? 'body,body *' + X + '{font-family:' + v + '!important}' : '';
    });

    click('eye', function () {
      if (!window.EyeDropper) return say('Eyedropper needs Chrome or Edge', 3500);
      new window.EyeDropper().open().then(function (r) {
        copy(r.sRGBHex).then(function () { say('Copied ' + r.sRGBHex); });
      }).catch(function () {});
    });

    var brush = 4;
    rng('brush', function (v) { brush = v; }, pxf);
    sw('doodle', function () {
      if (!dd) {
        dd = overlay('ug-doodle', true);
        dd.c.style.cursor = 'crosshair';
        var drawing = false;
        var last = null;
        dd.c.addEventListener('pointerdown', function (e) {
          drawing = true;
          last = [e.clientX, e.clientY];
          dd.c.setPointerCapture(e.pointerId);
        });
        dd.c.addEventListener('pointermove', function (e) {
          if (!drawing) return;
          var x = dd.ctx;
          x.strokeStyle = $('#dcol').value;
          x.lineWidth = brush;
          x.lineCap = 'round';
          x.beginPath();
          x.moveTo(last[0], last[1]);
          x.lineTo(e.clientX, e.clientY);
          x.stroke();
          last = [e.clientX, e.clientY];
        });
        var stop = function () { drawing = false; };
        dd.c.addEventListener('pointerup', stop);
        dd.c.addEventListener('pointercancel', stop);
      }
      dd.c.style.pointerEvents = 'auto';
    }, function () { if (dd) dd.c.style.pointerEvents = 'none'; });
    click('dclear', function () { if (dd) dd.ctx.clearRect(0, 0, dd.c.width, dd.c.height); });

    var gridEl = null;
    var gridSz = 40;
    sw('grid', function () {
      gridEl = mkDiv('ug-grid', 'position:fixed;top:0;left:0;width:100vw;height:100vh;pointer-events:none;z-index:2147483645;' +
        'background-image:linear-gradient(rgba(37,99,235,.4) 1px,transparent 1px),' +
        'linear-gradient(90deg,rgba(37,99,235,.4) 1px,transparent 1px);background-size:' + gridSz + 'px ' + gridSz + 'px;');
    }, function () { if (gridEl) { gridEl.remove(); gridEl = null; } });
    rng('gridsz', function (v) { gridSz = v; if (gridEl) gridEl.style.backgroundSize = v + 'px ' + v + 'px'; }, pxf);

    var rulerEl = null;
    var rulerH = 60;
    function rulerMove(e) { if (rulerEl) rulerEl.style.top = (e.clientY - rulerH / 2) + 'px'; }
    sw('ruler', function () {
      rulerEl = mkDiv('ug-ruler', 'position:fixed;left:0;width:100vw;height:' + rulerH + 'px;top:' + (window.innerHeight / 2) +
        'px;pointer-events:none;z-index:2147483645;box-shadow:0 0 0 100vmax rgba(0,0,0,.55);');
      window.addEventListener('mousemove', rulerMove);
    }, function () {
      window.removeEventListener('mousemove', rulerMove);
      if (rulerEl) { rulerEl.remove(); rulerEl = null; }
    });
    rng('rulerh', function (v) { rulerH = v; if (rulerEl) rulerEl.style.height = v + 'px'; }, pxf);
    cleanups.push(function () { window.removeEventListener('mousemove', rulerMove); });

    /* =================== TOOLS =================== */
    var unlockEvents = ['contextmenu', 'copy', 'cut', 'paste', 'selectstart', 'dragstart'];
    function unlockFn(e) { e.stopImmediatePropagation(); }
    cleanups.push(function () {
      unlockEvents.forEach(function (n) { window.removeEventListener(n, unlockFn, true); });
    });
    sw('unlock', function () {
      html.classList.add('ug-unlock');
      unlockEvents.forEach(function (n) { window.addEventListener(n, unlockFn, true); });
      say('Copy, select and right-click unlocked');
    }, function () {
      html.classList.remove('ug-unlock');
      unlockEvents.forEach(function (n) { window.removeEventListener(n, unlockFn, true); });
    });

    sw('pw', function () {
      document.querySelectorAll('input[type=password]').forEach(function (i) {
        i.setAttribute('data-ug-pw', '1');
        i.type = 'text';
      });
    }, function () {
      document.querySelectorAll('input[data-ug-pw]').forEach(function (i) {
        i.type = 'password';
        i.removeAttribute('data-ug-pw');
      });
    });

    function onDelClick(e) {
      if (!html.classList.contains('ug-del')) return;
      if (e.composedPath().indexOf(host) !== -1) return;
      var t = e.target;
      if (!t || t === html || t === document.body || (t.id && t.id.indexOf('ug-') === 0)) return;
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      t.classList.add('ug-gone');
      delStack.push(t);
    }
    document.addEventListener('click', onDelClick, true);
    cleanups.push(function () { document.removeEventListener('click', onDelClick, true); });
    cls('del', 'ug-del');
    click('undo', function () {
      var el = delStack.pop();
      if (el) { el.classList.remove('ug-gone'); say('Restored (' + delStack.length + ' left)'); }
      else say('Nothing to undo');
    });

    sw('mute', function () {
      document.querySelectorAll('video,audio').forEach(function (m) {
        if (!m.muted) { m.muted = true; m.setAttribute('data-ug-muted', '1'); }
      });
    }, function () {
      document.querySelectorAll('[data-ug-muted]').forEach(function (m) {
        m.muted = false;
        m.removeAttribute('data-ug-muted');
      });
    });

    click('overlays', function () {
      var n = 0;
      var vw = window.innerWidth;
      var vh = window.innerHeight;
      document.body.querySelectorAll('*').forEach(function (el) {
        var s = getComputedStyle(el);
        if (s.position !== 'fixed' && s.position !== 'sticky') return;
        var r = el.getBoundingClientRect();
        var big = r.width * r.height >= vw * vh * 0.4;
        var z = parseInt(s.zIndex, 10) || 0;
        if (big || (s.position === 'fixed' && z >= 1000)) { el.classList.add('ug-hidefix'); n++; }
      });
      html.classList.add('ug-unscroll');
      say(n ? 'Removed ' + n + ' overlay(s), scrolling restored' : 'No overlays found, scrolling unlocked');
    });

    click('top', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
    click('bottom', function () { window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' }); });

    click('md', function () {
      var title = document.title.replace(/[\[\]]/g, '');
      copy('[' + title + '](' + location.href + ')').then(function () { say('Copied Markdown link'); });
    });

    click('clean', function () {
      var u;
      try { u = new URL(location.href); } catch (e) { return say('Could not parse URL'); }
      var drop = [];
      u.searchParams.forEach(function (v, k) {
        if (/^(utm_|fbclid|gclid|msclkid|mc_|igshid|yclid|_hsenc|_hsmi)/i.test(k)) drop.push(k);
      });
      drop.forEach(function (k) { u.searchParams.delete(k); });
      copy(u.toString()).then(function () {
        say(drop.length ? 'Copied URL (removed ' + drop.length + ' tracking params)' : 'Copied URL (already clean)');
      });
    });

    click('wayback', function () { window.open('https://web.archive.org/web/' + location.href, '_blank', 'noopener'); });
    click('print', function () { window.print(); });

    function eachMedia(fn) { document.querySelectorAll('video,audio').forEach(fn); }
    rng('rate', function (v) { cfg.rate = v; eachMedia(function (m) { m.playbackRate = v; }); },
      function (v) { return v + 'x'; });
    function onPlay(e) {
      if (cfg.rate !== 1 && e.target && e.target.playbackRate !== undefined) e.target.playbackRate = cfg.rate;
    }
    document.addEventListener('play', onPlay, true);
    cleanups.push(function () {
      document.removeEventListener('play', onPlay, true);
      if (cfg.rate !== 1) eachMedia(function (m) { m.playbackRate = 1; });
    });

    rng('refresh', function (v) {
      clearInterval(refreshId);
      refreshId = null;
      if (v > 0) {
        refreshId = setInterval(function () { location.reload(); }, v * 1000);
        say('Auto refresh every ' + v + 's');
      }
    }, offOr('s'));

    function clearMarks() {
      document.querySelectorAll('mark.ug-mark').forEach(function (m) {
        var p = m.parentNode;
        if (!p) return;
        p.replaceChild(document.createTextNode(m.textContent), m);
        p.normalize();
      });
    }
    function highlight(term) {
      clearMarks();
      if (!term) return 0;
      var re = new RegExp(term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');
      var nodes = [];
      var w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
        acceptNode: function (n) {
          var p = n.parentNode ? n.parentNode.nodeName : '';
          return (/^(SCRIPT|STYLE|NOSCRIPT|TEXTAREA|MARK)$/.test(p) || !n.nodeValue.trim())
            ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT;
        }
      });
      while (w.nextNode()) nodes.push(w.currentNode);
      var count = 0;
      nodes.forEach(function (n) {
        if (count >= 500) return;
        var txt = n.nodeValue;
        var m;
        var last = 0;
        var frag = null;
        re.lastIndex = 0;
        while (count < 500 && (m = re.exec(txt))) {
          if (!frag) frag = document.createDocumentFragment();
          frag.appendChild(document.createTextNode(txt.slice(last, m.index)));
          var mk = document.createElement('mark');
          mk.className = 'ug-mark';
          mk.style.cssText = 'background:#fde047;color:#000;';
          mk.textContent = m[0];
          frag.appendChild(mk);
          last = m.index + m[0].length;
          count++;
        }
        if (frag) {
          frag.appendChild(document.createTextNode(txt.slice(last)));
          n.parentNode.replaceChild(frag, n);
        }
      });
      var first = document.querySelector('mark.ug-mark');
      if (first) first.scrollIntoView({ block: 'center', behavior: 'smooth' });
      return count;
    }
    var findTimer;
    $('#find').addEventListener('input', function (e) {
      clearTimeout(findTimer);
      var v = e.target.value;
      findTimer = setTimeout(function () {
        var n = highlight(v);
        if (v) say(n + ' match' + (n === 1 ? '' : 'es') + (n >= 500 ? ' (capped)' : ''), 1500);
      }, 250);
      timers.push(findTimer);
    });
    $('#find').addEventListener('keydown', function (e) { e.stopPropagation(); });

    /* =================== FUN =================== */
    rng('mspeed', function (v) { cfg.mskip = 9 - v; });
    sw('matrix', function () {
      var o = overlay('ug-matrix');
      var fs = 16;
      var drops = [];
      var f = 0;
      function init() {
        drops = [];
        for (var i = 0; i < Math.ceil(o.c.width / fs); i++) drops.push(Math.random() * -40);
      }
      init();
      var stop = loop(function () {
        if (++f % cfg.mskip) return;
        var x = o.ctx;
        x.globalCompositeOperation = 'destination-out';
        x.fillStyle = 'rgba(0,0,0,0.12)';
        x.fillRect(0, 0, o.c.width, o.c.height);
        x.globalCompositeOperation = 'source-over';
        x.fillStyle = '#22c55e';
        x.font = fs + 'px monospace';
        if (drops.length !== Math.ceil(o.c.width / fs)) init();
        drops.forEach(function (y, i) {
          x.fillText(String.fromCharCode(0x30A0 + Math.floor(Math.random() * 96)), i * fs, y * fs);
          drops[i] = (y * fs > o.c.height && Math.random() > 0.975) ? 0 : y + 1;
        });
      });
      fx.matrix = { o: o, stop: stop };
    }, function () { stopFx('matrix'); });

    rng('snowamt', function (v) { cfg.snow = v; });
    sw('snow', function () {
      var o = overlay('ug-snow');
      snowFlakes = [];
      var stop = loop(function () {
        var x = o.ctx;
        while (snowFlakes.length < cfg.snow) {
          snowFlakes.push({ x: Math.random() * o.c.width, y: Math.random() * o.c.height,
            r: 1 + Math.random() * 3, v: 0.5 + Math.random() * 1.5, d: Math.random() * 6.28 });
        }
        if (snowFlakes.length > cfg.snow) snowFlakes.length = cfg.snow;
        x.clearRect(0, 0, o.c.width, o.c.height);
        x.fillStyle = 'rgba(255,255,255,.95)';
        x.shadowColor = 'rgba(0,0,0,.35)';
        x.shadowBlur = 3;
        snowFlakes.forEach(function (f) {
          f.d += 0.02;
          f.y += f.v;
          f.x += Math.sin(f.d) * 0.6;
          if (f.y > o.c.height) { f.y = -5; f.x = Math.random() * o.c.width; }
          x.beginPath();
          x.arc(f.x, f.y, f.r, 0, 7);
          x.fill();
        });
      });
      fx.snow = { o: o, stop: stop };
    }, function () { stopFx('snow'); });

    rng('rbspeed', function (v) { html.style.setProperty('--ug-rs', v + 's'); }, function (v) { return v + 's'; });
    sw('rainbow', function () {
      rainbowOn = true;
      updateFilt();
      html.classList.add('ug-rainbow');
    }, function () {
      rainbowOn = false;
      html.classList.remove('ug-rainbow');
      updateFilt();
    });

    rng('trailsz', function (v) { cfg.trail = v; });
    sw('trail', function () {
      var o = overlay('ug-trail');
      var ps = [];
      var hue = 0;
      function mv(e) {
        hue = (hue + 8) % 360;
        for (var i = 0; i < 2; i++) {
          ps.push({ x: e.clientX, y: e.clientY, vx: Math.random() * 2 - 1, vy: Math.random() * 2 - 1, l: 1, h: hue });
        }
      }
      window.addEventListener('mousemove', mv);
      var stop0 = loop(function () {
        var x = o.ctx;
        x.clearRect(0, 0, o.c.width, o.c.height);
        for (var i = ps.length - 1; i >= 0; i--) {
          var p = ps[i];
          p.x += p.vx;
          p.y += p.vy;
          p.l -= 0.03;
          if (p.l <= 0) { ps.splice(i, 1); continue; }
          x.fillStyle = 'hsla(' + p.h + ',100%,60%,' + p.l + ')';
          x.beginPath();
          x.arc(p.x, p.y, cfg.trail * p.l, 0, 7);
          x.fill();
        }
      });
      fx.trail = { o: o, stop: function () { stop0(); window.removeEventListener('mousemove', mv); } };
    }, function () { stopFx('trail'); });

    var spotEl = null;
    var spotR = 150;
    function spotMove(e) {
      if (!spotEl) return;
      spotEl.style.left = (e.clientX - spotR) + 'px';
      spotEl.style.top = (e.clientY - spotR) + 'px';
    }
    sw('spot', function () {
      spotEl = mkDiv('ug-spot', 'position:fixed;width:' + spotR * 2 + 'px;height:' + spotR * 2 + 'px;border-radius:50%;' +
        'left:' + (window.innerWidth / 2 - spotR) + 'px;top:' + (window.innerHeight / 2 - spotR) + 'px;' +
        'pointer-events:none;z-index:2147483645;box-shadow:0 0 0 100vmax rgba(0,0,0,.78);');
      window.addEventListener('mousemove', spotMove);
    }, function () {
      window.removeEventListener('mousemove', spotMove);
      if (spotEl) { spotEl.remove(); spotEl = null; }
    });
    rng('spotsz', function (v) {
      spotR = v;
      if (spotEl) {
        var r = spotEl.getBoundingClientRect();
        var cx = r.left + r.width / 2;
        var cy = r.top + r.height / 2;
        spotEl.style.width = spotEl.style.height = v * 2 + 'px';
        spotEl.style.left = (cx - v) + 'px';
        spotEl.style.top = (cy - v) + 'px';
      }
    }, pxf);
    cleanups.push(function () { window.removeEventListener('mousemove', spotMove); });

    rng('confamt', function (v) { cfg.confetti = v; });
    click('confetti', function () {
      var key = 'confetti' + (++uid);
      var o = overlay('ug-' + key);
      var ps = [];
      for (var i = 0; i < cfg.confetti; i++) {
        ps.push({ x: window.innerWidth / 2, y: window.innerHeight * 0.6, vx: (Math.random() - 0.5) * 16,
          vy: -Math.random() * 16 - 4, r: 3 + Math.random() * 4, h: Math.random() * 360, l: 1 });
      }
      var stop = loop(function () {
        var x = o.ctx;
        x.clearRect(0, 0, o.c.width, o.c.height);
        var alive = 0;
        ps.forEach(function (p) {
          p.vy += 0.35;
          p.x += p.vx;
          p.y += p.vy;
          p.l -= 0.008;
          if (p.l > 0) {
            alive++;
            x.fillStyle = 'hsla(' + p.h + ',100%,55%,' + Math.min(1, p.l * 2) + ')';
            x.fillRect(p.x, p.y, p.r, p.r * 1.6);
          }
        });
        if (!alive) stopFx(key);
      });
      fx[key] = { o: o, stop: stop };
    });

    click('roll', function () {
      html.classList.add('ug-roll');
      later(function () { html.classList.remove('ug-roll'); }, 1300);
    });

    rng('shakeamt', function (v) { cfg.shake = v; }, pxf);
    click('shake', function () {
      var k = [];
      for (var i = 0; i < 14; i++) {
        k.push({ transform: 'translate(' + ((Math.random() * 2 - 1) * cfg.shake) + 'px,' +
          ((Math.random() * 2 - 1) * cfg.shake) + 'px)' });
      }
      k.push({ transform: 'translate(0,0)' });
      document.body.animate(k, { duration: 700, easing: 'linear' });
    });

    /* =================== PERSISTENCE =================== */
    var NOSAVE = { refresh: 1, scroll: 1, del: 1, edit: 1, pw: 1, doodle: 1, remember: 1, pscale: 1, popacity: 1, compact: 1, fireworks: 1, sbox: 1 };
    var SEL_IDS = ['font', 'cvd', 'texteff', 'emoset', 'budemoji', 'sndstyle'];
    var NORESET = { remember: 1, pscale: 1, popacity: 1, compact: 1 };
    var savedState = SITE.state ? JSON.parse(JSON.stringify(SITE.state)) : {};
    var gTimer;
    function gset(k, v) {
      GLOB[k] = v;
      clearTimeout(gTimer);
      gTimer = setTimeout(function () { store.set(GK, GLOB); }, 250);
    }
    var sTimer;
    function collectStates() {
      var st = {};
      root.querySelectorAll('#body input[type=checkbox],#body input[type=range]').forEach(function (el) {
        if (!el.id || NOSAVE[el.id]) return;
        st[el.id] = el.type === 'checkbox' ? (el.checked ? 1 : 0) : el.value;
      });
      SEL_IDS.forEach(function (id) { st[id] = $('#' + id).value; });
      return st;
    }
    function saveStates() {
      if (!SITE.remember) return;
      SITE.state = collectStates();
      store.set(SK, SITE);
    }
    function schedSave() { clearTimeout(sTimer); sTimer = setTimeout(saveStates, 300); }
    $('#body').addEventListener('change', schedSave);
    $('#body').addEventListener('input', schedSave);
    cleanups.push(function () { clearTimeout(gTimer); clearTimeout(sTimer); });

    sw('remember', function () {
      SITE.remember = true;
      saveStates();
      store.set(SK, SITE);
      say('Settings will be remembered on this site');
    }, function () {
      SITE.remember = false;
      SITE.state = {};
      store.set(SK, SITE);
      say('Stopped remembering settings');
    });
    click('cleardata', function () {
      clearTimeout(gTimer);
      clearTimeout(sTimer);
      store.del(GK);
      store.del(SK);
      GLOB = {};
      SITE = {};
      $('#remember').checked = false;
      $('#notes').value = '';
      say('Saved data cleared');
    });

    /* keep typing inside the panel from reaching the page's own shortcuts */
    ['#q', '#find', '#notes', '#css', '#frfind', '#frrepl'].forEach(function (sel) {
      ['keydown', 'keyup', 'keypress'].forEach(function (ev) {
        $(sel).addEventListener(ev, function (e) { e.stopPropagation(); });
      });
    });

    /* =================== PRESETS =================== */
    function resetAll() {
      while (delStack.length) delStack.pop().classList.remove('ug-gone');
      root.querySelectorAll('#body input[type=checkbox]').forEach(function (el) {
        if (el.id && !NORESET[el.id]) setSwitch(el.id, false);
      });
      Object.keys(sliders).forEach(function (id) { if (!NORESET[id]) sliders[id].reset(); });
      SEL_IDS.forEach(function (id) {
        $('#' + id).selectedIndex = 0;
        $('#' + id).dispatchEvent(new Event('change'));
      });
      restoreGravity();
      html.classList.remove('ug-unscroll');
      if (window.speechSynthesis) speechSynthesis.cancel();
      ftStop();
    }
    var PRESETS = {
      'pr-night': { name: 'Night Reading', sw: ['read', 'dark', 'fix'], rg: { lh: 1.7, mw: 760 } },
      'pr-focus': { name: 'Focus Mode', sw: ['fix', 'still', 'ruler'], rg: { mw: 800, lh: 1.6, rulerh: 90 } },
      'pr-clean': { name: 'Declutter', sw: ['ads', 'fix'], after: function () { $('#overlays').click(); } },
      'pr-print': { name: 'Clean & Print', sw: ['read', 'fix', 'ads'], after: function () { later(function () { window.print(); }, 500); } },
      'pr-easy': { name: 'Easy Reading', sw: ['read'], rg: { zoom: 120, lh: 1.8, ls: 1, ws: 4, mw: 900 } },
      'pr-party': { name: 'Party Mode', sw: ['rainbow', 'trail', 'snow'], rg: { rbspeed: 4 }, after: function () { $('#confetti').click(); } }
    };
    Object.keys(PRESETS).forEach(function (id) {
      click(id, function () {
        var p = PRESETS[id];
        resetAll();
        p.sw.forEach(function (s) { setSwitch(s, true); });
        Object.keys(p.rg || {}).forEach(function (k) { if (sliders[k]) sliders[k].set(p.rg[k]); });
        if (p.after) p.after();
        say(p.name + ' applied');
      });
    });
    click('pr-reset', function () { resetAll(); say('Everything reset'); });

    /* =================== TOOLS: hide likely ads =================== */
    var AD_SEL = '[id^="ad-"],[id^="ad_"],[id*="google_ads"],[id*="div-gpt-ad"],[class^="ad-"],[class*=" ad-"],' +
      '[class*="advert"],[class*="adsbygoogle"],ins.adsbygoogle,iframe[src*="doubleclick"],iframe[src*="googlesyndication"],' +
      'iframe[src*="adservice"],[aria-label="advertisement" i],[data-ad-slot],[data-google-query-id]';
    sw('ads', function () {
      var n = 0;
      document.querySelectorAll(AD_SEL).forEach(function (el) {
        if (el === html || el === document.body || host.contains(el)) return;
        el.classList.add('ug-ad');
        n++;
      });
      say(n ? 'Hid ' + n + ' likely ad elements' : 'No likely ads found');
    }, function () {
      document.querySelectorAll('.ug-ad').forEach(function (el) { el.classList.remove('ug-ad'); });
    });

    /* =================== DESIGN: inspector =================== */
    var INS_BOX = 'position:fixed;pointer-events:none;z-index:2147483644;border:2px solid #3b82f6;background:rgba(59,130,246,.15);box-sizing:border-box;';
    var INS_LAB = 'position:fixed;pointer-events:none;z-index:2147483644;background:#111;color:#fff;font:12px/1.45 ui-monospace,Menlo,Consolas,monospace;' +
      'padding:6px 9px;border-radius:7px;white-space:pre;box-shadow:0 6px 20px rgba(0,0,0,.4);';
    var insBox = null;
    var insLab = null;
    var insEl = null;
    function selectorOf(el) {
      var parts = [];
      while (el && el.nodeType === 1 && el !== document.body && parts.length < 5) {
        var s = el.tagName.toLowerCase();
        if (el.id) { parts.unshift(s + '#' + CSS.escape(el.id)); break; }
        var c = (el.className && typeof el.className === 'string') ? el.className.trim().split(/\s+/).filter(Boolean).slice(0, 2) : [];
        if (c.length) s += '.' + c.map(function (x) { return CSS.escape(x); }).join('.');
        parts.unshift(s);
        el = el.parentElement;
      }
      return parts.join(' > ');
    }
    function insMove(e) {
      if (!insBox) return;
      var el = document.elementFromPoint(e.clientX, e.clientY);
      if (!el || el === host || el === html || el === document.body || (el.id && el.id.indexOf('ug-') === 0)) {
        insBox.style.display = 'none';
        insLab.style.display = 'none';
        insEl = null;
        return;
      }
      insEl = el;
      var r = el.getBoundingClientRect();
      var cs = getComputedStyle(el);
      insBox.style.cssText = INS_BOX + 'left:' + r.left + 'px;top:' + r.top + 'px;width:' + r.width + 'px;height:' + r.height + 'px;';
      var cl = (typeof el.className === 'string' && el.className.trim()) ? '.' + el.className.trim().split(/\s+/)[0] : '';
      var bg = cs.backgroundColor === 'rgba(0, 0, 0, 0)' ? 'none' : toHex(cs.backgroundColor);
      insLab.textContent = el.tagName.toLowerCase() + (el.id ? '#' + el.id : '') + cl + '   ' + Math.round(r.width) + ' \u00D7 ' + Math.round(r.height) +
        '\n' + cs.fontSize + ' ' + cs.fontFamily.split(',')[0].replace(/["']/g, '') + ' \u00B7 ' + toHex(cs.color) + ' \u00B7 bg ' + bg;
      insLab.style.cssText = INS_LAB + 'left:0;top:0;';
      var lh = insLab.offsetHeight;
      var lw = insLab.offsetWidth;
      var ly = r.top - lh - 6 < 4 ? Math.min(window.innerHeight - lh - 4, r.bottom + 6) : r.top - lh - 6;
      var lx = Math.max(4, Math.min(window.innerWidth - lw - 4, r.left));
      insLab.style.cssText = INS_LAB + 'left:' + lx + 'px;top:' + ly + 'px;';
    }
    function insClick(e) {
      if (!insBox || !insEl) return;
      if (e.composedPath().indexOf(host) !== -1) return;
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      var sel = selectorOf(insEl);
      copy(sel).then(function () { say('Copied ' + sel, 3500); });
    }
    sw('inspect', function () {
      insBox = mkDiv('ug-insbox', INS_BOX + 'display:none;');
      insLab = mkDiv('ug-inslab', INS_LAB + 'display:none;');
      window.addEventListener('mousemove', insMove, true);
      document.addEventListener('click', insClick, true);
    }, function () {
      window.removeEventListener('mousemove', insMove, true);
      document.removeEventListener('click', insClick, true);
      if (insBox) insBox.remove();
      if (insLab) insLab.remove();
      insBox = insLab = insEl = null;
    });
    cleanups.push(function () {
      window.removeEventListener('mousemove', insMove, true);
      document.removeEventListener('click', insClick, true);
    });

    /* =================== DATA: Markdown + save HTML =================== */
    function mdOf(node) {
      if (node.nodeType === 3) return node.nodeValue.replace(/\s+/g, ' ');
      if (node.nodeType !== 1) return '';
      if (node === host || node.id === ID) return '';
      var tag = node.tagName.toLowerCase();
      if (/^(script|style|noscript|svg|iframe|nav|footer|form|button|select|textarea|canvas|video|audio|head|template)$/.test(tag)) return '';
      if (node.hidden || node.getAttribute('aria-hidden') === 'true') return '';
      function kids() { return Array.prototype.map.call(node.childNodes, mdOf).join(''); }
      var t;
      switch (tag) {
        case 'h1': case 'h2': case 'h3': case 'h4': case 'h5': case 'h6':
          return '\n\n' + new Array(parseInt(tag.charAt(1), 10) + 1).join('#') + ' ' + kids().trim() + '\n\n';
        case 'p': return '\n\n' + kids().trim() + '\n\n';
        case 'br': return '  \n';
        case 'hr': return '\n\n---\n\n';
        case 'a':
          t = kids().trim();
          return (t && /^https?:/i.test(node.href)) ? '[' + t + '](' + node.href + ')' : t;
        case 'strong': case 'b': t = kids().trim(); return t ? '**' + t + '**' : '';
        case 'em': case 'i': t = kids().trim(); return t ? '*' + t + '*' : '';
        case 'code':
          return (node.parentNode && node.parentNode.tagName === 'PRE') ? kids() : '`' + kids().trim() + '`';
        case 'pre': return '\n\n```\n' + node.innerText.replace(/\n+$/, '') + '\n```\n\n';
        case 'ul': case 'ol':
          var n = 0;
          var ord = tag === 'ol';
          return '\n' + Array.prototype.map.call(node.children, function (li) {
            if (li.tagName !== 'LI') return mdOf(li);
            n++;
            var inner = Array.prototype.map.call(li.childNodes, mdOf).join('').trim().replace(/\n/g, '\n  ');
            return (ord ? n + '. ' : '- ') + inner + '\n';
          }).join('') + '\n';
        case 'li': return '\n- ' + kids().trim() + '\n';
        case 'blockquote': return '\n\n> ' + kids().trim().replace(/\n/g, '\n> ') + '\n\n';
        case 'img':
          var src = node.currentSrc || node.src;
          return (src && !/^data:/i.test(src)) ? '![' + (node.getAttribute('alt') || '') + '](' + src + ')' : '';
        case 'table':
          var rows = Array.prototype.map.call(node.rows, function (r) {
            return '| ' + Array.prototype.map.call(r.cells, function (c) {
              return c.innerText.replace(/\s+/g, ' ').replace(/\|/g, '\\|').trim();
            }).join(' | ') + ' |';
          });
          if (rows.length > 1) {
            var cols = node.rows[0].cells.length;
            rows.splice(1, 0, '| ' + new Array(cols + 1).join('--- | ').trim());
          }
          return '\n\n' + rows.join('\n') + '\n\n';
        default:
          return /^(div|section|article|main|header|aside|figure|figcaption|address|details|summary|dl|dt|dd)$/.test(tag)
            ? '\n' + kids() + '\n' : kids();
      }
    }
    click('mdpage', function () {
      var rootEl = document.querySelector('article') || document.querySelector('main') || document.body;
      var md = '# ' + document.title + '\n\n<' + location.href + '>\n\n' + mdOf(rootEl).replace(/\n{3,}/g, '\n\n').trim();
      show(md.length > 3000 ? md.slice(0, 3000) + '\n...' : md);
      copy(md).then(function (ok) { say(ok ? 'Copied ' + md.length + ' characters of Markdown' : 'Markdown ready (copy blocked)'); });
    });

    click('savehtml', function () {
      var c = document.documentElement.cloneNode(true);
      c.querySelectorAll('#' + ID + ',[id^="ug-"],style[data-ug]').forEach(function (n) { n.remove(); });
      Array.prototype.slice.call(c.classList).forEach(function (k) { if (k.indexOf('ug-') === 0) c.classList.remove(k); });
      ['--ug-b', '--ug-c', '--ug-s', '--ug-sp', '--ug-g', '--ug-bl', '--ug-h', '--ug-rs', '--ug-cb'].forEach(function (p) { c.style.removeProperty(p); });
      if (!c.getAttribute('style')) c.removeAttribute('style');
      c.querySelectorAll('.ug-hidefix,.ug-gone,.ug-ad').forEach(function (n) {
        n.classList.remove('ug-hidefix');
        n.classList.remove('ug-gone');
        n.classList.remove('ug-ad');
      });
      var name = (document.title || 'page').replace(/[^\w\-]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60) || 'page';
      saveBlob(name + '.html', new Blob(['<!doctype html>\n' + c.outerHTML], { type: 'text/html' }));
      say('Saved ' + name + '.html');
    });

    /* =================== FOCUS: read aloud, timer, notes =================== */
    function chunkText(t) {
      var parts = t.replace(/\s+/g, ' ').match(/[^.!?]+[.!?]*\s*/g) || [t];
      var chunks = [];
      var cur = '';
      parts.forEach(function (s) {
        while (s.length > 220) {
          if (cur) { chunks.push(cur); cur = ''; }
          chunks.push(s.slice(0, 220));
          s = s.slice(220);
        }
        if ((cur + s).length > 220) { if (cur) chunks.push(cur); cur = s; }
        else cur += s;
      });
      if (cur) chunks.push(cur);
      return chunks;
    }
    click('tts', function () {
      if (!window.speechSynthesis) return say('Speech is not supported in this browser', 3500);
      speechSynthesis.cancel();
      var sel = String(window.getSelection() || '').trim();
      var t = (sel || document.body.innerText || '').trim().slice(0, 30000);
      if (!t) return say('Nothing to read');
      var rate = parseFloat($('#ttsrate').value) || 1;
      chunkText(t).forEach(function (c) {
        var u = new SpeechSynthesisUtterance(c);
        u.rate = rate;
        speechSynthesis.speak(u);
      });
      say('Reading ' + (sel ? 'your selection' : 'the page') + '...');
    });
    click('ttsstop', function () { if (window.speechSynthesis) speechSynthesis.cancel(); say('Stopped reading'); });
    rng('ttsrate', function () {}, function (v) { return v + 'x'; });
    cleanups.push(function () { if (window.speechSynthesis) speechSynthesis.cancel(); });

    var ftId = null;
    var ftEnd = 0;
    function mmss(ms) { var s = Math.ceil(ms / 1000); return Math.floor(s / 60) + ':' + ('0' + (s % 60)).slice(-2); }
    function ftStop() {
      clearInterval(ftId);
      ftId = null;
      var b = $('#ftstart');
      if (b) b.textContent = 'Start Focus Timer';
    }
    function beep() {
      try {
        var Ctx = window.AudioContext || window.webkitAudioContext;
        var c = new Ctx();
        [0, 0.35, 0.7].forEach(function (t) {
          var o = c.createOscillator();
          var g = c.createGain();
          o.connect(g);
          g.connect(c.destination);
          o.frequency.value = 880;
          g.gain.setValueAtTime(0.15, c.currentTime + t);
          g.gain.exponentialRampToValueAtTime(0.0001, c.currentTime + t + 0.3);
          o.start(c.currentTime + t);
          o.stop(c.currentTime + t + 0.32);
        });
        setTimeout(function () { c.close(); }, 1500);
      } catch (e) {}
    }
    function ftTick() {
      var left = ftEnd - Date.now();
      if (left <= 0) { ftStop(); beep(); say('Focus session finished!', 6000); return; }
      $('#ftstart').textContent = 'Stop Timer \u2022 ' + mmss(left);
    }
    rng('ftmin', function () {}, function (v) { return v + ' min'; });
    click('ftstart', function () {
      if (ftId) { ftStop(); say('Timer stopped'); return; }
      ftEnd = Date.now() + parseFloat($('#ftmin').value) * 60000;
      ftId = setInterval(ftTick, 500);
      ftTick();
      say('Focus timer started');
    });
    cleanups.push(function () { clearInterval(ftId); });

    var nTimer;
    $('#notes').value = SITE.notes || '';
    $('#notes').addEventListener('input', function (e) {
      clearTimeout(nTimer);
      var v = e.target.value;
      nTimer = setTimeout(function () { SITE.notes = v; store.set(SK, SITE); }, 400);
    });
    click('notecopy', function () {
      copy($('#notes').value).then(function (ok) { say(ok ? 'Notes copied' : 'Copy blocked'); });
    });
    cleanups.push(function () { clearTimeout(nTimer); });

    /* =================== ADJUST: blue light filter + color vision simulator =================== */
    var blfEl = null;
    rng('blf', function (v) {
      if (v > 0) {
        if (!blfEl) blfEl = mkDiv('ug-blf', 'position:fixed;top:0;left:0;width:100vw;height:100vh;pointer-events:none;z-index:2147483643;mix-blend-mode:multiply;');
        blfEl.style.background = 'rgba(255,' + Math.round(175 - v * 1.3) + ',' + Math.round(70 - v * 0.7) + ',' + (v / 100 * 0.85) + ')';
      } else if (blfEl) { blfEl.remove(); blfEl = null; }
    }, offOr('%'));

    var CB_M = {
      prot: '0.567 0.433 0 0 0  0.558 0.442 0 0 0  0 0.242 0.758 0 0  0 0 0 1 0',
      deut: '0.625 0.375 0 0 0  0.7 0.3 0 0 0  0 0.3 0.7 0 0  0 0 0 1 0',
      trit: '0.95 0.05 0 0 0  0 0.433 0.567 0 0  0 0.475 0.525 0 0  0 0 0 1 0',
      achro: '0.299 0.587 0.114 0 0  0.299 0.587 0.114 0 0  0.299 0.587 0.114 0 0  0 0 0 1 0'
    };
    var cbSvg = null;
    $('#cvd').addEventListener('change', function (e) {
      var v = e.target.value;
      if (v && !cbSvg) {
        var d = document.createElement('div');
        d.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="0" height="0" style="position:absolute" aria-hidden="true">' +
          Object.keys(CB_M).map(function (k) {
            return '<filter id="ug-cb-' + k + '" color-interpolation-filters="sRGB"><feColorMatrix type="matrix" values="' + CB_M[k] + '"/></filter>';
          }).join('') + '</svg>';
        cbSvg = d.firstChild;
        cbSvg.id = 'ug-cbsvg';
        html.appendChild(cbSvg);
        extras.push(cbSvg);
      }
      CB = v;
      updateFilt();
    });

    /* =================== LAYOUT: reading aids =================== */
    var progEl = null;
    function progUpdate() {
      if (!progEl) return;
      var h = document.documentElement.scrollHeight - window.innerHeight;
      progEl.firstChild.style.width = (h > 0 ? Math.min(100, window.scrollY / h * 100) : 0) + '%';
    }
    sw('progress', function () {
      var a = ACCENTS[curAccent] || ACCENTS.Emerald;
      progEl = mkDiv('ug-progress', 'position:fixed;top:0;left:0;width:100vw;height:4px;z-index:2147483643;pointer-events:none;background:rgba(0,0,0,.08);');
      var bar = document.createElement('div');
      bar.style.cssText = 'height:100%;width:0;background:linear-gradient(90deg,' + a[0] + ',' + a[1] + ');';
      progEl.appendChild(bar);
      window.addEventListener('scroll', progUpdate, { passive: true });
      progUpdate();
    }, function () {
      window.removeEventListener('scroll', progUpdate);
      if (progEl) { progEl.remove(); progEl = null; }
    });
    cleanups.push(function () { window.removeEventListener('scroll', progUpdate); });

    cls('linkurls', 'ug-linkurls');
    cls('bigcur', 'ug-bigcur');

    sw('newtab', function () {
      var n = 0;
      document.querySelectorAll('a[href]').forEach(function (a) {
        if (a.getAttribute('target') === '_blank') return;
        a.setAttribute('data-ug-t', a.getAttribute('target') || '');
        a.setAttribute('data-ug-r', a.getAttribute('rel') || '');
        a.setAttribute('target', '_blank');
        a.setAttribute('rel', ((a.getAttribute('rel') || '') + ' noopener').trim());
        n++;
      });
      say(n + ' links will open in a new tab');
    }, function () {
      document.querySelectorAll('a[data-ug-t]').forEach(function (a) {
        if (a.getAttribute('data-ug-t')) a.setAttribute('target', a.getAttribute('data-ug-t')); else a.removeAttribute('target');
        if (a.getAttribute('data-ug-r')) a.setAttribute('rel', a.getAttribute('data-ug-r')); else a.removeAttribute('rel');
        a.removeAttribute('data-ug-t');
        a.removeAttribute('data-ug-r');
      });
    });
    cleanups.push(function () { $('#newtab').checked && setSwitch('newtab', false); });

    /* =================== DATA: audit, resources, storage, gallery, media =================== */
    click('seo', function () {
      var meta = function (sel, attr) { var e = document.querySelector(sel); return e ? (e.getAttribute(attr || 'content') || '') : ''; };
      var issues = 0;
      var out2 = [];
      function row(ok, text) { if (!ok) issues++; out2.push((ok ? '\u2713 ' : '\u2717 ') + text); }
      var title = document.title || '';
      row(title.length >= 10 && title.length <= 70, 'Title: ' + (title ? '"' + title.slice(0, 60) + '" (' + title.length + ' chars)' : 'missing'));
      var desc = meta('meta[name="description"]');
      row(desc.length >= 50 && desc.length <= 170, 'Meta description: ' + (desc ? desc.length + ' chars' : 'missing'));
      row(!!meta('link[rel="canonical"]', 'href'), 'Canonical link: ' + (meta('link[rel="canonical"]', 'href') || 'missing'));
      row(!!document.documentElement.lang, 'Language (html lang): ' + (document.documentElement.lang || 'missing'));
      row(!!meta('meta[name="viewport"]'), 'Viewport meta tag: ' + (meta('meta[name="viewport"]') ? 'yes' : 'missing'));
      row(!!meta('meta[property="og:title"]') && !!meta('meta[property="og:image"]'), 'Open Graph title + image: ' +
        ((meta('meta[property="og:title"]') && meta('meta[property="og:image"]')) ? 'yes' : 'incomplete'));
      var h1 = document.querySelectorAll('h1').length;
      row(h1 === 1, 'H1 headings: ' + h1 + ' (should be 1)');
      var last = 0;
      var skips = 0;
      document.querySelectorAll('h1,h2,h3,h4,h5,h6').forEach(function (h) {
        var l = parseInt(h.tagName.charAt(1), 10);
        if (last && l > last + 1) skips++;
        last = l;
      });
      row(skips === 0, 'Heading level skips: ' + skips);
      var noAlt = 0;
      Array.prototype.forEach.call(document.images, function (i) { if (!i.hasAttribute('alt')) noAlt++; });
      row(noAlt === 0, 'Images without alt text: ' + noAlt + ' of ' + document.images.length);
      var emptyLinks = 0;
      Array.prototype.forEach.call(document.links, function (a) {
        if (!(a.textContent || '').trim() && !a.getAttribute('aria-label') && !a.getAttribute('title') && !a.querySelector('img[alt]:not([alt=""])')) emptyLinks++;
      });
      row(emptyLinks === 0, 'Links with no text: ' + emptyLinks);
      var emptyBtns = 0;
      document.querySelectorAll('button,[role=button]').forEach(function (b) {
        if (!(b.textContent || '').trim() && !b.getAttribute('aria-label') && !b.getAttribute('title') && !b.getAttribute('aria-labelledby')) emptyBtns++;
      });
      row(emptyBtns === 0, 'Buttons with no label: ' + emptyBtns);
      var unlabeled = 0;
      document.querySelectorAll('input:not([type=hidden]):not([type=submit]):not([type=button]):not([type=reset]):not([type=image]),select,textarea').forEach(function (f) {
        var has = f.getAttribute('aria-label') || f.getAttribute('aria-labelledby') || f.getAttribute('title') || f.closest('label') ||
          (f.id && document.querySelector('label[for="' + f.id.replace(/"/g, '') + '"]'));
        if (!has) unlabeled++;
      });
      row(unlabeled === 0, 'Form fields without a label: ' + unlabeled);
      show(out2.join('\n'));
      say(issues ? issues + ' issue' + (issues === 1 ? '' : 's') + ' found' : 'No issues found');
    });

    click('weight', function () {
      var res = (performance.getEntriesByType ? performance.getEntriesByType('resource') : []).slice();
      var size = function (r) { return r.transferSize || r.encodedBodySize || r.decodedBodySize || 0; };
      if (!res.length) return say('No resource timing data available');
      res.sort(function (a, b) { return size(b) - size(a); });
      show(res.slice(0, 12).map(function (r) {
        var n = r.name.length > 70 ? r.name.slice(0, 67) + '...' : r.name;
        return (size(r) ? Math.round(size(r) / 1024) + ' KB' : '? KB') + '  ' + (r.initiatorType || '') + '  ' + n;
      }).join('\n'));
    });

    click('storage', function () {
      var lines = [];
      try {
        var ck = document.cookie ? document.cookie.split(/;\s*/).map(function (c) { return c.split('=')[0]; }) : [];
        lines.push('Cookies readable by scripts: ' + ck.length);
        ck.slice(0, 15).forEach(function (n) { lines.push('  ' + n); });
      } catch (e) { lines.push('Cookies: not accessible'); }
      [['localStorage', 'localStorage'], ['sessionStorage', 'sessionStorage']].forEach(function (pair) {
        try {
          var st = window[pair[1]];
          var keys = [];
          var bytes = 0;
          for (var i = 0; i < st.length; i++) {
            var k = st.key(i);
            if (k.indexOf('ug:') === 0) continue;
            keys.push(k);
            bytes += k.length + (st.getItem(k) || '').length;
          }
          lines.push('', pair[0] + ': ' + keys.length + ' keys (~' + Math.round(bytes / 102.4) / 10 + ' KB)');
          keys.slice(0, 15).forEach(function (k) { lines.push('  ' + k); });
        } catch (e) { lines.push('', pair[0] + ': not accessible'); }
      });
      show(lines.join('\n'));
    });

    var galEl = null;
    function closeGal() { if (galEl) { galEl.remove(); galEl = null; } }
    click('gallery', function () {
      closeGal();
      var seen = {};
      var list = [];
      Array.prototype.forEach.call(document.images, function (img) {
        var u = img.currentSrc || img.src;
        if (!u || seen[u]) return;
        if ((img.naturalWidth || 0) < 60 && (img.naturalHeight || 0) < 60) return;
        seen[u] = 1;
        list.push({ u: u, w: img.naturalWidth, h: img.naturalHeight });
      });
      if (!list.length) return say('No images found');
      galEl = mkDiv('ug-gallery', 'position:fixed;top:0;left:0;right:0;bottom:0;z-index:2147483642;background:rgba(10,10,12,.95);overflow:auto;' +
        'padding:28px;box-sizing:border-box;font:13px system-ui,sans-serif;color:#eee;');
      var head = document.createElement('div');
      head.style.cssText = 'display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;font-size:16px;font-weight:600;';
      head.textContent = 'Images (' + list.length + ')';
      var x = document.createElement('button');
      x.textContent = 'Close (Esc)';
      x.style.cssText = 'background:#2b2b2b;color:#eee;border:1px solid #444;border-radius:9px;padding:7px 14px;cursor:pointer;font:13px system-ui,sans-serif;';
      x.addEventListener('click', closeGal);
      head.appendChild(x);
      var grid = document.createElement('div');
      grid.style.cssText = 'display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px;';
      list.forEach(function (it) {
        var card = document.createElement('a');
        card.href = it.u;
        card.target = '_blank';
        card.rel = 'noopener';
        card.style.cssText = 'display:block;background:#1c1c20;border-radius:12px;overflow:hidden;text-decoration:none;color:#ccc;';
        var im = document.createElement('img');
        im.src = it.u;
        im.style.cssText = 'width:100%;height:140px;object-fit:contain;background:#111;display:block;';
        var cap = document.createElement('div');
        cap.style.cssText = 'padding:8px 10px;font-size:11px;';
        cap.textContent = it.w + ' \u00D7 ' + it.h;
        card.appendChild(im);
        card.appendChild(cap);
        grid.appendChild(card);
      });
      galEl.appendChild(head);
      galEl.appendChild(grid);
    });

    click('medialinks', function () {
      var urls = [];
      document.querySelectorAll('video,audio,source,iframe,embed,object').forEach(function (e) {
        var u = e.currentSrc || e.src || e.data;
        if (u && /^https?:/i.test(u)) urls.push(u);
      });
      document.querySelectorAll('a[href]').forEach(function (a) {
        if (/\.(mp4|webm|mov|m3u8|mp3|m4a|wav|ogg|flac)(\?|#|$)/i.test(a.href)) urls.push(a.href);
      });
      var list = unique(urls);
      if (!list.length) return say('No video or audio links found');
      show(list.join('\n'));
      copy(list.join('\n')).then(function (ok) { say(ok ? 'Copied ' + list.length + ' media links' : 'Found ' + list.length + ' media links (copy blocked)'); });
    });

    /* =================== DESIGN: custom CSS =================== */
    var cssStyle = document.createElement('style');
    cssStyle.setAttribute('data-ug', '1');
    document.head.appendChild(cssStyle);
    cleanups.push(function () { cssStyle.remove(); });
    var cssTimer;
    $('#css').value = SITE.css || '';
    $('#css').addEventListener('input', function (e) {
      var v = e.target.value;
      cssStyle.textContent = v;
      clearTimeout(cssTimer);
      cssTimer = setTimeout(function () { SITE.css = v; store.set(SK, SITE); }, 400);
    });
    click('cssclear', function () {
      $('#css').value = '';
      cssStyle.textContent = '';
      SITE.css = '';
      store.set(SK, SITE);
      say('Custom CSS cleared');
    });
    cleanups.push(function () { clearTimeout(cssTimer); });

    /* =================== TOOLS: find & replace, video, screenshot =================== */
    var frUndo = [];
    click('frgo', function () {
      var f = $('#frfind').value;
      var r = $('#frrepl').value;
      if (!f) return say('Type the text to find first');
      var re = new RegExp(f.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');
      var nodes = [];
      var w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
        acceptNode: function (n) {
          var p = n.parentNode ? n.parentNode.nodeName : '';
          return (/^(SCRIPT|STYLE|NOSCRIPT|TEXTAREA)$/.test(p) || !n.nodeValue.trim()) ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT;
        }
      });
      while (w.nextNode()) nodes.push(w.currentNode);
      var count = 0;
      nodes.forEach(function (node) {
        var v = node.nodeValue;
        if (v.search(re) === -1) return;
        frUndo.push({ node: node, old: v });
        node.nodeValue = v.replace(re, function () { count++; return r; });
      });
      say(count ? 'Replaced ' + count + ' match' + (count === 1 ? '' : 'es') : 'No matches found');
    });
    click('frundo', function () {
      var c = frUndo.length;
      while (frUndo.length) { var u = frUndo.pop(); u.node.nodeValue = u.old; }
      say(c ? 'Restored ' + c + ' text block' + (c === 1 ? '' : 's') : 'Nothing to undo');
    });

    click('pip', function () {
      if (document.pictureInPictureElement) { document.exitPictureInPicture(); return; }
      var vids = Array.prototype.slice.call(document.querySelectorAll('video')).filter(function (v) { return v.readyState > 0; });
      if (!vids.length) return say('No video found on this page');
      vids.sort(function (a, b) { return (b.videoWidth * b.videoHeight) - (a.videoWidth * a.videoHeight); });
      if (!document.pictureInPictureEnabled || !vids[0].requestPictureInPicture) return say('Picture-in-Picture is not available here', 3500);
      vids[0].requestPictureInPicture().then(function () { say('Picture-in-Picture on'); })
        .catch(function () { say('The site or browser blocked Picture-in-Picture', 3500); });
    });
    sw('loop', function () {
      document.querySelectorAll('video').forEach(function (v) { v.setAttribute('data-ug-loop', v.loop ? '1' : '0'); v.loop = true; });
    }, function () {
      document.querySelectorAll('video[data-ug-loop]').forEach(function (v) {
        v.loop = v.getAttribute('data-ug-loop') === '1';
        v.removeAttribute('data-ug-loop');
      });
    });

    click('shot', function () {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getDisplayMedia) return say('Screen capture is not supported here', 3500);
      navigator.mediaDevices.getDisplayMedia({ video: true, preferCurrentTab: true }).then(function (stream) {
        var track = stream.getVideoTracks()[0];
        var v = document.createElement('video');
        v.muted = true;
        v.srcObject = stream;
        v.onloadedmetadata = function () {
          v.play().then(function () {
            host.style.visibility = 'hidden';
            later(function () {
              var c = document.createElement('canvas');
              c.width = v.videoWidth;
              c.height = v.videoHeight;
              c.getContext('2d').drawImage(v, 0, 0);
              host.style.visibility = '';
              track.stop();
              c.toBlob(function (b) {
                saveBlob('screenshot-' + new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19) + '.png', b);
                say('Screenshot saved');
              });
            }, 300);
          });
        };
      }).catch(function () { say('Screenshot cancelled or blocked', 3500); });
    });

    /* =================== FUN: fireworks + bubbles =================== */
    rng('fwsize', function (v) { cfg.fw = v; });
    sw('fireworks', function () {
      var o = overlay('ug-fireworks');
      var ps = [];
      function boom(x, y) {
        var hue = Math.random() * 360;
        for (var i = 0; i < 70; i++) {
          var a = Math.random() * 6.283;
          var sp = Math.random() * cfg.fw / 18 + 1.5;
          ps.push({ x: x, y: y, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp, l: 1, h: hue + Math.random() * 40 });
        }
      }
      function onClick(e) {
        if (e.composedPath().indexOf(host) !== -1) return;
        boom(e.clientX, e.clientY);
      }
      document.addEventListener('click', onClick, true);
      var stop = loop(function () {
        var x = o.ctx;
        x.globalCompositeOperation = 'destination-out';
        x.fillStyle = 'rgba(0,0,0,.18)';
        x.fillRect(0, 0, o.c.width, o.c.height);
        x.globalCompositeOperation = 'source-over';
        for (var i = ps.length - 1; i >= 0; i--) {
          var p = ps[i];
          p.vy += 0.04;
          p.x += p.vx;
          p.y += p.vy;
          p.vx *= 0.985;
          p.l -= 0.012;
          if (p.l <= 0) { ps.splice(i, 1); continue; }
          x.fillStyle = 'hsla(' + p.h + ',100%,62%,' + p.l + ')';
          x.beginPath();
          x.arc(p.x, p.y, 2.2, 0, 7);
          x.fill();
        }
      });
      fx.fireworks = { o: o, stop: function () { stop(); document.removeEventListener('click', onClick, true); } };
    }, function () { stopFx('fireworks'); });

    rng('bubamt', function (v) { cfg.bub = v; });
    sw('bubbles', function () {
      var o = overlay('ug-bubbles');
      var bs = [];
      var stop = loop(function () {
        var x = o.ctx;
        var w = o.c.width;
        var h = o.c.height;
        while (bs.length < cfg.bub) bs.push({ x: Math.random() * w, y: Math.random() * h, r: 6 + Math.random() * 20, v: 0.4 + Math.random() * 1.2, d: Math.random() * 6.28 });
        if (bs.length > cfg.bub) bs.length = cfg.bub;
        x.clearRect(0, 0, w, h);
        x.shadowBlur = 0;
        bs.forEach(function (b) {
          b.d += 0.02;
          b.y -= b.v;
          b.x += Math.sin(b.d) * 0.5;
          if (b.y + b.r < 0) { b.y = h + b.r; b.x = Math.random() * w; }
          x.beginPath();
          x.arc(b.x, b.y, b.r, 0, 7);
          x.fillStyle = 'rgba(255,255,255,.12)';
          x.fill();
          x.strokeStyle = 'rgba(255,255,255,.75)';
          x.lineWidth = 1.5;
          x.stroke();
          x.beginPath();
          x.arc(b.x - b.r * 0.35, b.y - b.r * 0.35, b.r * 0.2, 0, 7);
          x.fillStyle = 'rgba(255,255,255,.6)';
          x.fill();
        });
      });
      fx.bubbles = { o: o, stop: stop };
    }, function () { stopFx('bubbles'); });

    /* =================== SETTINGS: theme, compact, pins, share =================== */
    function applyTheme(name) { hud.classList.toggle('light', name === 'Light'); }
    $('#theme').addEventListener('change', function (e) { applyTheme(e.target.value); gset('theme', e.target.value); });
    sw('compact', function () { hud.classList.add('compact'); gset('compact', 1); }, function () { hud.classList.remove('compact'); gset('compact', 0); });

    var pinned = {};
    function rowKey(el) {
      if (el.id) return el.id;
      var c = el.querySelector('input[id],select[id],button[id],textarea[id]');
      return c ? c.id : null;
    }
    function pinRow(el) {
      var key = rowKey(el);
      if (!key || /^pr-/.test(key) || pinned[key]) return false;
      if (moved.some(function (m) { return m.el === el; })) return false;
      var list = $('#favlist');
      var parts = [];
      var nx = el.nextElementSibling;
      function take(node) {
        var ph = document.createComment('ug-pin');
        node.parentNode.insertBefore(ph, node);
        list.appendChild(node);
        parts.push({ el: node, ph: ph });
      }
      take(el);
      if (nx && nx.classList.contains('desc')) take(nx);
      pinned[key] = parts;
      $('#favs').style.display = 'block';
      return true;
    }
    function unpinRow(key) {
      var parts = pinned[key];
      if (!parts) return;
      parts.forEach(function (p) { if (p.ph.parentNode) p.ph.parentNode.replaceChild(p.el, p.ph); });
      delete pinned[key];
      if (!Object.keys(pinned).length) $('#favs').style.display = 'none';
    }
    $('#body').addEventListener('contextmenu', function (e) {
      var row = e.target.closest ? e.target.closest('[data-s]') : null;
      if (!row) return;
      e.preventDefault();
      if ($('#rlist').contains(row)) return say('Clear the search first, then pin');
      var key = rowKey(row);
      if (!key || /^pr-/.test(key)) return say('Presets are already on the Presets tab');
      if (pinned[key]) { unpinRow(key); say('Unpinned'); }
      else if (pinRow(row)) say('Pinned to the top of Presets');
      gset('pins', Object.keys(pinned));
    });

    function applyStates(st) {
      Object.keys(st).forEach(function (id) {
        if (NOSAVE[id]) return;
        if (SEL_IDS.indexOf(id) !== -1) {
          if (st[id]) { $('#' + id).value = st[id]; $('#' + id).dispatchEvent(new Event('change')); }
          return;
        }
        var el = $('#' + id);
        if (!el) return;
        if (el.type === 'checkbox') { if (st[id]) setSwitch(id, true); }
        else if (el.type === 'range' && String(el.value) !== String(st[id])) {
          el.value = st[id];
          el.dispatchEvent(new Event('input'));
        }
      });
    }
    function applyUI(u) {
      if (u.accent && ACCENTS[u.accent]) { $('#accent').value = u.accent; applyAccent(u.accent); gset('accent', u.accent); }
      if (u.scale) sliders.pscale.set(u.scale);
      if (u.opacity) sliders.popacity.set(u.opacity);
      if (u.theme) { $('#theme').value = u.theme; applyTheme(u.theme); gset('theme', u.theme); }
      if (u.compact !== undefined) setSwitch('compact', !!u.compact);
      if (u.pins) {
        Object.keys(pinned).forEach(function (k) { unpinRow(k); });
        u.pins.forEach(function (id) {
          var el = $('#' + id);
          var row = el && el.closest('[data-s]');
          if (row) pinRow(row);
        });
        gset('pins', Object.keys(pinned));
      }
    }
    click('exportcfg', function () {
      var txt = 'UGCFG:' + JSON.stringify({
        v: 1,
        ui: { accent: GLOB.accent, scale: GLOB.scale, opacity: GLOB.opacity, theme: GLOB.theme, compact: GLOB.compact, pins: Object.keys(pinned) },
        state: collectStates()
      });
      show(txt);
      copy(txt).then(function (ok) { say(ok ? 'Setup copied. Use Load a Setup on another site.' : 'Setup shown below (copy blocked)', 3500); });
    });
    click('importcfg', function () {
      var txt = window.prompt('Paste a Utility.Gui setup (starts with UGCFG:)');
      if (!txt) return;
      var o;
      try { o = JSON.parse(txt.trim().replace(/^UGCFG:/, '')); } catch (err) { return say('That is not a valid setup', 3000); }
      resetAll();
      applyStates(o.state || {});
      applyUI(o.ui || {});
      say('Setup loaded');
    });

    /* =================== PLAY: weather, space, party, looks, chaos, sound =================== */
    var EMOJI = {
      party: ['\uD83C\uDF89', '\uD83C\uDF8A', '\u2728', '\uD83C\uDF88', '\uD83E\uDD73'],
      food: ['\uD83C\uDF55', '\uD83C\uDF54', '\uD83C\uDF5F', '\uD83C\uDF69', '\uD83C\uDF49', '\uD83C\uDF2E'],
      space: ['\uD83D\uDE80', '\uD83E\uDE90', '\u2B50', '\uD83C\uDF19', '\uD83D\uDC7D', '\u2604\uFE0F'],
      animals: ['\uD83D\uDC31', '\uD83D\uDC36', '\uD83E\uDD84', '\uD83D\uDC3C', '\uD83D\uDC38', '\uD83D\uDC19'],
      love: ['\u2764\uFE0F', '\uD83D\uDC96', '\uD83D\uDC98', '\uD83D\uDE0D', '\uD83D\uDC8B']
    };
    var EMOJI_FONT = '"Apple Color Emoji","Segoe UI Emoji","Noto Color Emoji",sans-serif';
    cfg.rain = 150; cfg.star = 6; cfg.emo = 30; cfg.disco = 5; cfg.scan = 40; cfg.grain = 30; cfg.budsz = 36; cfg.vol = 50; cfg.snd = 'pop';

    rng('rainamt', function (v) { cfg.rain = v; });
    sw('rain', function () {
      var o = overlay('ug-rain');
      var drops = [];
      var flash = 0;
      var stop = loop(function () {
        var x = o.ctx;
        var w = o.c.width;
        var h = o.c.height;
        while (drops.length < cfg.rain) drops.push({ x: Math.random() * (w + 100), y: Math.random() * h, l: 10 + Math.random() * 18, v: 12 + Math.random() * 10 });
        if (drops.length > cfg.rain) drops.length = cfg.rain;
        x.clearRect(0, 0, w, h);
        if (flash > 0) { x.fillStyle = 'rgba(255,255,255,' + flash + ')'; x.fillRect(0, 0, w, h); flash -= 0.06; }
        else if (Math.random() < 0.003) flash = 0.7;
        x.strokeStyle = 'rgba(150,185,255,.65)';
        x.lineWidth = 1.3;
        x.beginPath();
        drops.forEach(function (d) {
          x.moveTo(d.x, d.y);
          x.lineTo(d.x - d.l * 0.15, d.y + d.l);
          d.y += d.v;
          d.x -= d.v * 0.15;
          if (d.y > h) { d.y = -d.l; d.x = Math.random() * (w + 100); }
        });
        x.stroke();
      });
      fx.rain = { o: o, stop: stop };
    }, function () { stopFx('rain'); });

    rng('starspd', function (v) { cfg.star = v; });
    sw('stars', function () {
      var o = overlay('ug-stars');
      var st = [];
      function mk(z) { return { x: (Math.random() - 0.5) * o.c.width, y: (Math.random() - 0.5) * o.c.height, z: z || Math.random() * o.c.width }; }
      for (var i = 0; i < 300; i++) st.push(mk());
      var stop = loop(function () {
        var x = o.ctx;
        var w = o.c.width;
        var h = o.c.height;
        x.clearRect(0, 0, w, h);
        x.strokeStyle = '#fff';
        x.shadowColor = 'rgba(0,0,0,.6)';
        x.shadowBlur = 3;
        st.forEach(function (s, idx) {
          var pz = s.z;
          s.z -= cfg.star * 2 + 1;
          if (s.z <= 1) { st[idx] = mk(w); return; }
          var px = s.x / pz * 300 + w / 2;
          var py = s.y / pz * 300 + h / 2;
          var cx = s.x / s.z * 300 + w / 2;
          var cy = s.y / s.z * 300 + h / 2;
          x.lineWidth = (1 - s.z / w) * 3 + 0.5;
          x.beginPath();
          x.moveTo(px, py);
          x.lineTo(cx, cy);
          x.stroke();
        });
      });
      fx.stars = { o: o, stop: stop };
    }, function () { stopFx('stars'); });

    rng('emoamt', function (v) { cfg.emo = v; });
    sw('emoji', function () {
      var o = overlay('ug-emoji');
      var items = [];
      function mk(first) {
        var set = EMOJI[$('#emoset').value] || EMOJI.party;
        return { e: set[Math.floor(Math.random() * set.length)], x: Math.random() * o.c.width, y: first ? Math.random() * o.c.height : -40,
          s: 20 + Math.random() * 26, v: 1 + Math.random() * 2.5, d: Math.random() * 6.28 };
      }
      var stop = loop(function () {
        var x = o.ctx;
        while (items.length < cfg.emo) items.push(mk(true));
        if (items.length > cfg.emo) items.length = cfg.emo;
        x.clearRect(0, 0, o.c.width, o.c.height);
        items.forEach(function (it, i) {
          it.d += 0.03;
          it.y += it.v;
          it.x += Math.sin(it.d) * 0.8;
          if (it.y > o.c.height + 40) items[i] = mk(false);
          x.font = it.s + 'px ' + EMOJI_FONT;
          x.fillText(it.e, it.x, it.y);
        });
      });
      fx.emoji = { o: o, stop: stop };
    }, function () { stopFx('emoji'); });

    rng('discospd', function (v) { cfg.disco = v; });
    sw('disco', function () {
      var o = overlay('ug-disco');
      var t = 0;
      var stop = loop(function () {
        var x = o.ctx;
        var w = o.c.width;
        var h = o.c.height;
        t += cfg.disco * 0.004;
        x.clearRect(0, 0, w, h);
        for (var i = 0; i < 6; i++) {
          var cx = w * (0.5 + 0.45 * Math.sin(t * (1 + i * 0.37) + i));
          var cy = h * (0.5 + 0.45 * Math.cos(t * (0.8 + i * 0.29) + i * 2));
          var r = Math.max(w, h) * 0.32;
          var g = x.createRadialGradient(cx, cy, 0, cx, cy, r);
          var hue = (t * 60 + i * 60) % 360;
          g.addColorStop(0, 'hsla(' + hue + ',100%,60%,.38)');
          g.addColorStop(1, 'hsla(' + hue + ',100%,60%,0)');
          x.fillStyle = g;
          x.fillRect(0, 0, w, h);
        }
      });
      fx.disco = { o: o, stop: stop };
    }, function () { stopFx('disco'); });

    sw('ripples', function () {
      var o = overlay('ug-ripples');
      var rs = [];
      function onClick(e) {
        if (e.composedPath().indexOf(host) !== -1) return;
        rs.push({ x: e.clientX, y: e.clientY, r: 4, l: 1 });
      }
      document.addEventListener('click', onClick, true);
      var stop = loop(function () {
        var x = o.ctx;
        var rgb = (ACCENTS[curAccent] || ACCENTS.Emerald)[3];
        x.clearRect(0, 0, o.c.width, o.c.height);
        for (var i = rs.length - 1; i >= 0; i--) {
          var r = rs[i];
          r.r += 4;
          r.l -= 0.03;
          if (r.l <= 0) { rs.splice(i, 1); continue; }
          x.strokeStyle = 'rgba(' + rgb + ',' + r.l + ')';
          x.lineWidth = 3;
          x.beginPath();
          x.arc(r.x, r.y, r.r, 0, 7);
          x.stroke();
        }
      });
      fx.ripples = { o: o, stop: function () { stop(); document.removeEventListener('click', onClick, true); } };
    }, function () { stopFx('ripples'); });

    var buddyEl = null;
    rng('budsz', function (v) { cfg.budsz = v; if (buddyEl) buddyEl.style.fontSize = v + 'px'; }, pxf);
    $('#budemoji').addEventListener('change', function (e) { if (buddyEl) buddyEl.textContent = e.target.value; });
    sw('buddy', function () {
      buddyEl = mkDiv('ug-buddy', 'position:fixed;left:-100px;top:-100px;pointer-events:none;z-index:2147483644;line-height:1;' +
        'transform:translate(-50%,-50%);font-family:' + EMOJI_FONT + ';font-size:' + cfg.budsz + 'px;');
      buddyEl.textContent = $('#budemoji').value;
      var mx = window.innerWidth / 2;
      var my = window.innerHeight / 2;
      var bx = mx;
      var by = my;
      function mv(e) { mx = e.clientX + 18; my = e.clientY + 18; }
      window.addEventListener('mousemove', mv);
      var stop = loop(function () {
        bx += (mx - bx) * 0.12;
        by += (my - by) * 0.12;
        buddyEl.style.left = bx + 'px';
        buddyEl.style.top = by + 'px';
        buddyEl.style.transform = 'translate(-50%,-50%) scaleX(' + (mx < bx - 1 ? -1 : 1) + ')';
      });
      fx.buddy = { o: { close: function () { if (buddyEl) { buddyEl.remove(); buddyEl = null; } } }, stop: function () { stop(); window.removeEventListener('mousemove', mv); } };
    }, function () { stopFx('buddy'); });

    function applyTextEffect(v) {
      ['up', 'low', 'cap', 'mirror', 'flip', 'wobble', 'glitch', 'neon'].forEach(function (k) { html.classList.remove('ug-tx-' + k); });
      if (v) html.classList.add('ug-tx-' + v);
    }
    $('#texteff').addEventListener('change', function (e) { applyTextEffect(e.target.value); });
    cls('hacker', 'ug-hacker');

    var scanEl = null;
    function scanStyle() {
      var a = cfg.scan / 100 * 0.5;
      scanEl.style.background = 'repeating-linear-gradient(0deg,rgba(0,0,0,' + a + ') 0,rgba(0,0,0,' + a + ') 1px,transparent 1px,transparent 3px),' +
        'radial-gradient(ellipse at center,transparent 55%,rgba(0,0,0,' + (a * 0.9) + ') 100%)';
    }
    rng('scanamt', function (v) { cfg.scan = v; if (scanEl) scanStyle(); }, pct);
    sw('scan', function () {
      scanEl = mkDiv('ug-scan', 'position:fixed;top:0;left:0;width:100vw;height:100vh;pointer-events:none;z-index:2147483641;');
      scanStyle();
    }, function () { if (scanEl) { scanEl.remove(); scanEl = null; } });

    rng('grainamt', function (v) { cfg.grain = v; if (fx.grain && fx.grain.cv) fx.grain.cv.style.opacity = v / 100 * 0.4; }, pct);
    sw('grain', function () {
      var c = document.createElement('canvas');
      c.id = 'ug-grain';
      c.width = 200;
      c.height = 130;
      c.style.cssText = 'position:fixed;top:0;left:0;width:100vw;height:100vh;pointer-events:none;z-index:2147483641;image-rendering:pixelated;opacity:' + (cfg.grain / 100 * 0.4) + ';';
      html.appendChild(c);
      var g = c.getContext('2d');
      function draw() {
        var d = g.createImageData(200, 130);
        for (var i = 0; i < d.data.length; i += 4) {
          var v = Math.random() * 255;
          d.data[i] = d.data[i + 1] = d.data[i + 2] = v;
          d.data[i + 3] = 255;
        }
        g.putImageData(d, 0, 0);
      }
      draw();
      var id = setInterval(draw, 90);
      fx.grain = { cv: c, o: { close: function () { c.remove(); } }, stop: function () { clearInterval(id); } };
    }, function () { stopFx('grain'); });

    var gravEls = [];
    function restoreGravity() {
      gravEls.forEach(function (g) {
        g.el.style.transition = 'transform .6s ease';
        g.el.style.transform = g.t;
        setTimeout(function () { g.el.style.transition = g.tr; }, 700);
      });
      gravEls = [];
    }
    click('gravity', function () {
      if (gravEls.length) return say('Press Restore Gravity first');
      var vh = window.innerHeight;
      var n = 0;
      document.body.querySelectorAll('h1,h2,h3,h4,h5,h6,p,img,li,button,input,textarea,blockquote,figure,label,td,th').forEach(function (el) {
        if (n >= 120 || host.contains(el)) return;
        var r = el.getBoundingClientRect();
        if (r.bottom < 0 || r.top > vh || r.width < 4 || r.height < 4) return;
        n++;
        gravEls.push({ el: el, t: el.style.transform, tr: el.style.transition });
        el.style.transition = 'transform ' + (0.8 + Math.random() * 1.2) + 's cubic-bezier(.55,.05,.9,.4) ' + (Math.random() * 0.5) + 's';
        el.style.transform = 'translateY(' + (vh - r.bottom - Math.random() * 20) + 'px) rotate(' + ((Math.random() - 0.5) * 50) + 'deg)';
      });
      say(n ? n + ' elements fell' : 'Nothing on screen to drop');
    });
    click('gravityundo', function () { var c = gravEls.length; restoreGravity(); say(c ? 'Everything is back' : 'Nothing has fallen'); });
    cleanups.push(function () { gravEls.forEach(function (g) { g.el.style.transform = g.t; g.el.style.transition = g.tr; }); gravEls = []; });

    var audioCtx = null;
    function actx() {
      if (!audioCtx) { var C = window.AudioContext || window.webkitAudioContext; if (!C) return null; audioCtx = new C(); }
      if (audioCtx.state === 'suspended') audioCtx.resume();
      return audioCtx;
    }
    function tone(freq, dur, type, vol, delay, slideTo) {
      var c = actx();
      if (!c) return;
      var t = c.currentTime + (delay || 0);
      var o = c.createOscillator();
      var g = c.createGain();
      o.type = type || 'sine';
      o.frequency.setValueAtTime(freq, t);
      if (slideTo) o.frequency.exponentialRampToValueAtTime(slideTo, t + dur);
      g.gain.setValueAtTime(vol, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      o.connect(g);
      g.connect(c.destination);
      o.start(t);
      o.stop(t + dur + 0.02);
    }
    function playSnd() {
      var v = cfg.vol / 100 * 0.3;
      switch (cfg.snd) {
        case 'coin': tone(988, 0.08, 'square', v); tone(1319, 0.25, 'square', v, 0.08); break;
        case 'laser': tone(1400, 0.18, 'sawtooth', v, 0, 200); break;
        case 'bell': tone(880, 0.6, 'sine', v); tone(1760, 0.4, 'sine', v * 0.5); break;
        default: tone(520, 0.09, 'sine', v, 0, 260);
      }
    }
    function onSndClick(e) { if (e.composedPath().indexOf(host) === -1) playSnd(); }
    $('#sndstyle').addEventListener('change', function (e) { cfg.snd = e.target.value; playSnd(); });
    rng('sndvol', function (v) { cfg.vol = v; }, pct);
    sw('sounds', function () { document.addEventListener('click', onSndClick, true); }, function () { document.removeEventListener('click', onSndClick, true); });
    cleanups.push(function () {
      document.removeEventListener('click', onSndClick, true);
      if (audioCtx) { try { audioCtx.close(); } catch (e) {} audioCtx = null; }
    });

    var PLAY_FX = ['matrix', 'snow', 'rainbow', 'trail', 'spot', 'fireworks', 'bubbles', 'rain', 'stars', 'emoji', 'disco', 'scan', 'grain', 'ripples', 'buddy', 'hacker', 'sounds', 'sbox'];
    var SURPRISE = ['matrix', 'snow', 'rainbow', 'trail', 'bubbles', 'rain', 'stars', 'emoji', 'disco', 'scan', 'grain', 'ripples', 'buddy', 'hacker'];
    function stopAllPlay() {
      PLAY_FX.forEach(function (id) { if ($('#' + id)) setSwitch(id, false); });
      $('#texteff').value = '';
      applyTextEffect('');
      restoreGravity();
    }
    click('stopfx', function () { stopAllPlay(); say('All effects stopped'); });
    click('surprise', function () {
      stopAllPlay();
      var pool = SURPRISE.slice();
      var names = [];
      for (var i = 0; i < 3; i++) {
        var id = pool.splice(Math.floor(Math.random() * pool.length), 1)[0];
        setSwitch(id, true);
        names.push($('#' + id).closest('.row').querySelector('span').textContent);
      }
      say('Surprise: ' + names.join(', '), 3500);
    });

    /* =================== PLAY: ELEMENT SANDBOX (falling-sand physics on top of the page) =================== */
    var TY = { SAND: 1, DIRT: 2, SNOW: 3, GUNPOWDER: 4, ASH: 5, WATER: 6, OIL: 7, LAVA: 8, ACID: 9, NAPALM: 10, MUD: 11,
      STONE: 12, WOOD: 13, METAL: 14, ICE: 15, GLASS: 16, PLANT: 17, OBSIDIAN: 18, TNT: 19, FIRE: 20, SMOKE: 21, STEAM: 22, GAS: 23 };
    var NAME2TY = { sand: 1, dirt: 2, snow: 3, gunpowder: 4, ash: 5, water: 6, oil: 7, lava: 8, acid: 9, napalm: 10, mud: 11,
      stone: 12, wood: 13, metal: 14, ice: 15, glass: 16, plant: 17, tnt: 19, fire: 20, smoke: 21, steam: 22, gas: 23 };
    var NTY = 24;
    var KIND = new Uint8Array(NTY);     /* 1 powder, 2 liquid, 3 solid, 4 gas, 5 fire */
    var DENS = new Int16Array(NTY);
    var BURN = new Float32Array(NTY);
    var STICK = new Float32Array(NTY);
    var DISP = new Uint8Array(NTY);
    var DISS = new Float32Array(NTY);   /* how fast acid eats each material */
    var REACT = new Uint8Array(NTY);
    [1, 2, 3, 4, 5, 11].forEach(function (t) { KIND[t] = 1; });
    [6, 7, 8, 9, 10].forEach(function (t) { KIND[t] = 2; });
    [12, 13, 14, 15, 16, 17, 18, 19].forEach(function (t) { KIND[t] = 3; });
    [21, 22, 23].forEach(function (t) { KIND[t] = 4; });
    KIND[20] = 5;
    DENS[1] = 150; DENS[2] = 155; DENS[3] = 60; DENS[4] = 145; DENS[5] = 50; DENS[11] = 170;
    DENS[6] = 100; DENS[7] = 80; DENS[8] = 250; DENS[9] = 105; DENS[10] = 90;
    STICK[2] = 0.45; STICK[3] = 0.15; STICK[4] = 0.05; STICK[5] = 0.2; STICK[11] = 0.8;
    DISP[6] = 5; DISP[7] = 3; DISP[8] = 1; DISP[9] = 4; DISP[10] = 1;
    BURN[13] = 0.06; BURN[17] = 0.14; BURN[7] = 0.3; BURN[10] = 0.35; BURN[4] = 0.5; BURN[23] = 0.6; BURN[19] = 1; BURN[3] = 0.5; BURN[15] = 0.1;
    DISS[12] = 0.06; DISS[2] = 0.15; DISS[1] = 0.1; DISS[13] = 0.08; DISS[17] = 0.3; DISS[15] = 0.3; DISS[16] = 0.01; DISS[18] = 0.01;
    DISS[14] = 0.004; DISS[11] = 0.2; DISS[5] = 0.3; DISS[3] = 0.5; DISS[19] = 0.02; DISS[4] = 0.5;
    REACT[15] = 1; REACT[17] = 1; REACT[19] = 1;
    var BASEC = [];
    (function () {
      var b = { 1: [222, 192, 124], 2: [108, 76, 50], 3: [236, 243, 250], 4: [44, 44, 50], 5: [148, 148, 150], 6: [70, 150, 220], 7: [46, 30, 12],
        8: [255, 110, 20], 9: [100, 250, 70], 10: [205, 78, 24], 11: [72, 52, 36], 12: [112, 114, 122], 13: [140, 92, 50], 14: [150, 158, 170],
        15: [176, 224, 244], 16: [186, 232, 230], 17: [44, 138, 52], 18: [26, 20, 40], 19: [186, 34, 32] };
      for (var k in b) BASEC[k] = b[k];
    })();
    var NX8 = [-1, 0, 1, -1, 1, -1, 0, 1];
    var NY8 = [-1, -1, -1, 0, 0, 1, 1, 1];

    var sbOn = false;
    var sbPaused = false;
    var sbPix = 4;
    var sbBrush = 5;
    var sbSpeed = 1;
    var sbCur = 'sand';
    var GACC = 0.25;
    var MAXV = 8;
    var WINDV = 0;
    var W = 0;
    var H = 0;
    var CT, CL, CV, CA, CVY, CM, MK, DEPTH;
    var sbCanvas = null;
    var sbGlow = null;
    var sbFx = null;
    var sbCtx = null;
    var sbGCtx = null;
    var sbImg, sbBuf, sbGImg, sbGBuf;
    var stamp = 0;
    var frame = 0;
    var maskDirty = true;
    var debris = [];
    var blasts = [];
    var bombs = [];
    var missiles = [];
    var fxp = [];
    var bolts = [];
    var emitters = [];
    var nukeFx = null;
    var scorchEl = null;
    var fallIdx = 0;
    var fallHit = false;
    var PART_CAP = 6000;
    var sbDown = false;
    var sbLast = [0, 0];
    var sbPtr = [0, 0];

    function cpx() { return window.innerWidth / W; }
    function rr() { return Math.random(); }
    function c8(v) { return v < 0 ? 0 : (v > 255 ? 255 : v | 0); }
    function pk(r, g, b, a) { return ((c8(a) << 24) | (c8(b) << 16) | (c8(g) << 8) | c8(r)) >>> 0; }

    function initGrid() {
      var vw = window.innerWidth;
      var vh = window.innerHeight;
      W = Math.max(40, Math.ceil(vw / sbPix));
      H = Math.max(30, Math.ceil(vh / sbPix));
      var n = W * H;
      CT = new Uint8Array(n); CL = new Uint8Array(n); CV = new Uint8Array(n); CA = new Uint8Array(n);
      CVY = new Float32Array(n); CM = new Uint8Array(n); MK = new Uint8Array(n); DEPTH = new Uint16Array(W);
      sbCanvas.width = W; sbCanvas.height = H; sbGlow.width = W; sbGlow.height = H;
      sbImg = sbCtx.createImageData(W, H); sbBuf = new Uint32Array(sbImg.data.buffer);
      sbGImg = sbGCtx.createImageData(W, H); sbGBuf = new Uint32Array(sbGImg.data.buffer);
      debris = []; blasts = []; bombs = []; missiles = []; fxp = []; bolts = []; emitters = []; nukeFx = null;
      maskDirty = true;
    }

    /* ---------- tiny cell helpers ---------- */
    function mv(a, b) {
      CT[b] = CT[a]; CL[b] = CL[a]; CV[b] = CV[a]; CA[b] = CA[a]; CVY[b] = CVY[a]; CM[b] = stamp;
      CT[a] = 0; CL[a] = 0; CA[a] = 0; CVY[a] = 0;
    }
    function sw2(a, b) {
      var t = CT[a]; CT[a] = CT[b]; CT[b] = t;
      t = CL[a]; CL[a] = CL[b]; CL[b] = t;
      t = CV[a]; CV[a] = CV[b]; CV[b] = t;
      t = CA[a]; CA[a] = CA[b]; CA[b] = t;
      var f = CVY[a]; CVY[a] = CVY[b]; CVY[b] = f;
      CM[a] = stamp; CM[b] = stamp;
    }
    function put(i, t, l, a) { CT[i] = t; CL[i] = l || 0; CV[i] = (rr() * 256) | 0; CA[i] = a || 0; CVY[i] = 0; CM[i] = stamp; }
    function clr(i) { CT[i] = 0; CL[i] = 0; CA[i] = 0; CVY[i] = 0; }
    function isFree(x, y) {
      if (x < 0 || x >= W || y < 0 || y >= H) return false;
      var i = y * W + x;
      return CT[i] === 0 && MK[i] === 0;
    }
    function rnb(x, y) {
      var k = (rr() * 8) | 0;
      var nx = x + NX8[k];
      var ny = y + NY8[k];
      if (nx < 0 || nx >= W || ny < 0 || ny >= H) return -1;
      return ny * W + nx;
    }

    /* ---------- page elements become solid ground ---------- */
    function buildMask() {
      maskDirty = false;
      MK.fill(0);
      if ($('#sbghost').checked) return;
      var els = document.body.querySelectorAll('h1,h2,h3,h4,h5,h6,p,li,img,button,input,textarea,select,a,label,td,th,blockquote,pre,video,iframe');
      var vw = window.innerWidth;
      var vh = window.innerHeight;
      var cw = W / vw;
      var ch = H / vh;
      var n = 0;
      for (var k = 0; k < els.length && n < 700; k++) {
        var el = els[k];
        if (host.contains(el)) continue;
        var r = el.getBoundingClientRect();
        if (r.width < 6 || r.height < 6 || r.bottom < 0 || r.top > vh || r.right < 0 || r.left > vw) continue;
        if (r.width > vw * 0.95 && r.height > vh * 0.6) continue;
        n++;
        var x0 = Math.max(0, Math.floor(r.left * cw));
        var x1 = Math.min(W - 1, Math.floor(r.right * cw));
        var y0 = Math.max(0, Math.floor(r.top * ch));
        var y1 = Math.min(H - 1, Math.floor(r.bottom * ch));
        for (var yy = y0; yy <= y1; yy++) { var row = yy * W; for (var xx = x0; xx <= x1; xx++) MK[row + xx] = 1; }
      }
    }

    /* ---------- falling ---------- */
    function fall(x, y, i, t, maxSteps) {
      var vy = CVY[i] + GACC;
      if (vy > MAXV) vy = MAXV;
      var steps = vy | 0;
      if (steps < 1) steps = rr() < vy ? 1 : 0;
      if (steps > maxSteps) steps = maxSteps;
      var ci = i;
      var cy = y;
      var hit = false;
      for (var s = 0; s < steps; s++) {
        if (cy + 1 >= H) { hit = true; break; }
        var bi = ci + W;
        if (MK[bi]) { hit = true; break; }
        var bt = CT[bi];
        if (bt === 0) { mv(ci, bi); ci = bi; cy++; continue; }
        var bk = KIND[bt];
        if (bk >= 4 || (bk === 2 && DENS[bt] < DENS[t])) { sw2(ci, bi); ci = bi; cy++; if (bk === 2) vy *= 0.7; continue; }
        hit = true;
        break;
      }
      CVY[ci] = hit ? 0 : vy;
      fallIdx = ci;
      fallHit = hit;
    }
    function slide(x, y, i, t, stickP) {
      if (stickP && rr() < stickP) return false;
      var d = rr() < 0.5 ? -1 : 1;
      for (var k = 0; k < 2; k++) {
        var nx = x + d;
        if (nx >= 0 && nx < W && y + 1 < H) {
          var di = (y + 1) * W + nx;
          if (!MK[di] && !MK[y * W + nx]) {
            var dt = CT[di];
            if (dt === 0) { mv(i, di); return true; }
            if (KIND[t] === 1 && KIND[dt] === 2 && DENS[dt] < DENS[t]) { sw2(i, di); return true; }
          }
        }
        d = -d;
      }
      return false;
    }

    function powder(x, y, i, t) {
      fall(x, y, i, t, 8);
      var ci = fallIdx;
      var cy = (ci / W) | 0;
      var cx = ci - cy * W;
      if (fallHit && !slide(cx, cy, ci, t, STICK[t])) { /* resting */ }
      if (t === 2) {
        var n = rnb(cx, cy);
        if (n >= 0 && CT[n] === 6 && rr() < 0.03) { CT[ci] = 11; clr(n); }
      }
    }

    function liquid(x, y, i, t) {
      if (t === 8 && rr() < 0.6) { lavaReact(x, y, i); return; }
      fall(x, y, i, t, 6);
      var ci = fallIdx;
      var cy = (ci / W) | 0;
      var cx = ci - cy * W;
      if (t === 6) waterReact(cx, cy, ci);
      else if (t === 9) acidReact(cx, cy, ci);
      if (CT[ci] !== t) return;
      if (!fallHit) return;
      if (slide(cx, cy, ci, t, 0)) return;
      var d = rr() < 0.5 ? -1 : 1;
      var disp = DISP[t];
      for (var k = 0; k < 2; k++) {
        var last = -1;
        for (var j = 1; j <= disp; j++) {
          var nx = cx + d * j;
          if (nx < 0 || nx >= W) break;
          var ni = cy * W + nx;
          if (CT[ni] !== 0 || MK[ni]) break;
          last = ni;
        }
        if (last >= 0) { mv(ci, last); return; }
        d = -d;
      }
    }
    function waterReact(x, y, i) {
      var n = rnb(x, y);
      if (n < 0) return;
      var nt = CT[n];
      if (nt === 20) { clr(n); if (rr() < 0.35) put(i, 22, 220 + ((rr() * 35) | 0), 0); }
      else if (nt === 15 && rr() < 0.004) { put(i, 15, 0, 0); }
      else if (nt === 8) { put(i, 22, 230, 0); if (rr() < 0.6) put(n, 18, 0, 0); else put(n, 12, 0, 0); }
    }
    function acidReact(x, y, i) {
      var n = rnb(x, y);
      if (n < 0) return;
      var nt = CT[n];
      if (DISS[nt] > 0 && rr() < DISS[nt]) {
        put(n, 21, 130, 0);
        if (rr() < 0.3) clr(i);
      }
    }
    function lavaReact(x, y, i) {
      var n = rnb(x, y);
      if (n >= 0) {
        var nt = CT[n];
        if (nt === 6) { put(n, 22, 230, 0); if (rr() < 0.55) put(i, 18, 0, 0); else put(i, 12, 0, 0); return; }
        if (nt === 15 || nt === 3) { put(n, 6, 0, 0); }
        else if (nt === 1 && rr() < 0.02) { put(n, 16, 0, 0); }
        else if (BURN[nt] > 0 && rr() < Math.min(1, BURN[nt] * 3)) { ignite(n, nt); }
      }
      if (y > 0 && rr() < 0.004) {
        var ui = i - W;
        if (CT[ui] === 0 && !MK[ui]) put(ui, rr() < 0.7 ? 20 : 21, rr() < 0.7 ? 30 + ((rr() * 30) | 0) : 140, 0);
      }
    }

    function gasStep(x, y, i, t) {
      if (t === 21) { if (rr() < 0.5) CL[i]--; if (CL[i] <= 1) { clr(i); return; } }
      else if (t === 22) { CL[i]--; if (CL[i] <= 1) { if (rr() < 0.45) put(i, 6, 0, 0); else clr(i); return; } }
      if (y === 0) { if (t !== 23) clr(i); return; }
      var dx = ((rr() * 3) | 0) - 1;
      if (WINDV !== 0 && rr() < Math.abs(WINDV) * 8) dx = WINDV > 0 ? 1 : -1;
      var rise = t === 22 ? 0.92 : (t === 23 ? 0.6 : 0.72);
      if (rr() < rise) {
        if (isFree(x + dx, y - 1)) { mv(i, i - W + dx); return; }
        if (isFree(x, y - 1)) { mv(i, i - W); return; }
      }
      if (isFree(x + dx, y)) mv(i, i + dx);
    }

    function fireStep(x, y, i) {
      var touch = false;
      for (var q0 = 0; q0 < 3; q0++) {
        var n = rnb(x, y);
        if (n < 0) continue;
        var nt = CT[n];
        if (nt === 6) { clr(i); if (rr() < 0.4) put(n, 22, 220 + ((rr() * 35) | 0), 0); return; }
        if (BURN[nt] > 0 && nt !== 3 && nt !== 15) touch = true;
        if (BURN[nt] > 0 && rr() < BURN[nt]) ignite(n, nt);
      }
      var l = CL[i];
      if (CA[i] === 1) {
        l -= 1;
        CL[i] = l;
        if (l < 2) {
          var r = rr();
          clr(i);
          if (r < 0.35) put(i, 5, 0, 0);
          else if (r < 0.5) put(i, 21, 140, 0);
          return;
        }
        if (y > 0) {
          var ui = i - W;
          if (CT[ui] === 0 && !MK[ui]) {
            var q = rr();
            if (q < 0.06) put(ui, 20, 28 + ((rr() * 40) | 0), 0);
            else if (q < 0.085) put(ui, 21, 150, 0);
          }
        }
        return;
      }
      l -= 3 + ((rr() * 4) | 0);
      if (l <= 0) { clr(i); if (rr() < 0.1) put(i, 21, 110, 0); return; }
      CL[i] = l;
      if (touch && rr() < 0.8) { CL[i] = Math.min(255, l + 3); return; }
      if (y === 0) { clr(i); return; }
      var dx = ((rr() * 3) | 0) - 1;
      if (WINDV !== 0 && rr() < Math.abs(WINDV) * 8) dx = WINDV > 0 ? 1 : -1;
      if (rr() < 0.8) {
        if (isFree(x + dx, y - 1)) { mv(i, i - W + dx); return; }
        if (isFree(x, y - 1)) { mv(i, i - W); return; }
      }
      if (isFree(x + dx, y)) mv(i, i + dx);
    }

    function solidStep(x, y, i, t) {
      if (t === 17) {
        for (var k = 0; k < 8; k++) {
          var wx = x + NX8[k];
          var wy = y + NY8[k];
          if (wx < 0 || wx >= W || wy < 0 || wy >= H) continue;
          var wi = wy * W + wx;
          if (CT[wi] === 6 && rr() < 0.1) {
            var gx = x + ((rr() * 3) | 0) - 1;
            var gy = y - ((rr() * 3) | 0) + (rr() < 0.15 ? 1 : 0);
            if (gx >= 0 && gx < W && gy >= 0 && gy < H) {
              var gi = gy * W + gx;
              if (!MK[gi] && (CT[gi] === 0 || CT[gi] === 6)) { put(gi, 17, 0, 0); if (gi !== wi) clr(wi); }
            }
            return;
          }
        }
        return;
      }
      var n = rnb(x, y);
      if (n < 0) return;
      var nt = CT[n];
      if (t === 15) {
        if (nt === 20 || nt === 8) { put(i, 6, 0, 0); if (nt === 20) clr(n); }
        else if (nt === 6 && rr() < 0.01) put(n, 15, 0, 0);
      } else if (t === 19) {
        if (nt === 20 || nt === 8) { clr(i); addBlast(x, y, 74, 1.8, false); }
      }
    }

    function ignite(j, t) {
      var jx = j % W;
      var jy = (j / W) | 0;
      switch (t) {
        case 13: put(j, 20, 170 + ((rr() * 85) | 0), 1); break;
        case 17: put(j, 20, 60 + ((rr() * 50) | 0), 1); break;
        case 7: put(j, 20, 70 + ((rr() * 50) | 0), 1); break;
        case 10: put(j, 20, 215 + ((rr() * 40) | 0), 1); break;
        case 4: clr(j); addBlast(jx, jy, 28, 1.0, false); break;
        case 23: clr(j); addBlast(jx, jy, 42, 1.1, false); break;
        case 19: clr(j); addBlast(jx, jy, 74, 1.8, false); break;
        case 3: put(j, 6, 0, 0); break;
        case 15: put(j, 6, 0, 0); break;
      }
    }

    /* ---------- explosions ---------- */
    function addBlast(cx, cy, Rpx, power, nuke) {
      var R = Rpx / cpx();
      if (blasts.length > 70) { var i0 = cy * W + cx; if (i0 >= 0 && i0 < CT.length && CT[i0] === 0) put(i0, 20, 80, 0); return; }
      blasts.push({ x: cx, y: cy, r: 0, R: R, sp: Math.max(1.4, R / (nuke ? 22 : 14)), power: power, nuke: !!nuke });
      var px = (cx + 0.5) * cpx();
      var py = (cy + 0.5) * cpx();
      explodeFx(px, py, Rpx, power, nuke);
      if (blasts.length < 6) boom(nuke ? 3.2 : Math.min(2.2, 0.5 + Rpx / 90));
      if (!nuke) shakePage(Math.min(14, 3 + Rpx / 12), 500);
    }
    function blastsStep() {
      for (var b = blasts.length - 1; b >= 0; b--) {
        var bl = blasts[b];
        var r0 = bl.r;
        var r1 = bl.r + bl.sp;
        var x0 = Math.max(0, Math.floor(bl.x - r1));
        var x1 = Math.min(W - 1, Math.ceil(bl.x + r1));
        var y0 = Math.max(0, Math.floor(bl.y - r1));
        var y1 = Math.min(H - 1, Math.ceil(bl.y + r1));
        var r0s = r0 * r0;
        var r1s = r1 * r1;
        for (var yy = y0; yy <= y1; yy++) {
          for (var xx = x0; xx <= x1; xx++) {
            var dx = xx - bl.x;
            var dy = yy - bl.y;
            var d2 = dx * dx + dy * dy;
            if (d2 < r0s || d2 >= r1s) continue;
            blastCell(bl, xx, yy, Math.sqrt(d2), dx, dy);
          }
        }
        bl.r = r1;
        if (r1 >= bl.R) blasts.splice(b, 1);
      }
    }
    function blastCell(bl, x, y, d, dx, dy) {
      var i = y * W + x;
      var t = CT[i];
      var f = d / bl.R;
      if (t === 0) {
        if (f < 0.55 && rr() < 0.05 * bl.power) put(i, 20, 50 + ((rr() * 70) | 0), 0);
        return;
      }
      if (t === 14 && !bl.nuke) return;
      if (t === 19) { clr(i); addBlast(x, y, 74, 1.8, false); return; }
      if (t === 20 || t === 21 || t === 22) { if (rr() < 0.5) clr(i); return; }
      if (BURN[t] > 0 && t !== 3 && t !== 15 && (t === 4 || t === 7 || t === 10 || t === 23) && f < 0.8) {
        clr(i); put(i, 20, 60 + ((rr() * 60) | 0), 0);
        return;
      }
      if (t === 6 && f < 0.5) { put(i, 22, 240, 0); return; }
      if (debris.length < PART_CAP) {
        var nx = d > 0.001 ? dx / d : rr() - 0.5;
        var ny = d > 0.001 ? dy / d : rr() - 0.5;
        var sp = bl.power * (1.15 - f * 0.75) * (0.55 + rr() * 0.9) * (bl.nuke ? 1.5 : 1);
        debris.push({ x: x + 0.5, y: y + 0.5, vx: nx * sp + (rr() - 0.5) * 0.4, vy: ny * sp - bl.power * 0.5 * rr(), t: t, hot: f < 0.7 ? 1 : 0 });
        clr(i);
      } else {
        clr(i);
        if (f < 0.5) put(i, 20, 50 + ((rr() * 60) | 0), 0);
      }
    }
    function debrisStep() {
      for (var k = debris.length - 1; k >= 0; k--) {
        var p = debris[k];
        p.vy += GACC * 0.9;
        p.vx += WINDV * 0.5;
        p.vx *= 0.996;
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0 || p.x >= W) { debris.splice(k, 1); continue; }
        if (p.y < 0) continue;
        var ix = Math.floor(p.x);
        var iy = Math.floor(p.y);
        if (iy >= H || !isFree(ix, iy)) {
          var sx = Math.floor(p.x - p.vx);
          var sy = Math.min(H - 1, Math.floor(p.y - p.vy));
          var placed = false;
          for (var up = 0; up < 14 && !placed; up++) {
            if (isFree(sx, sy - up)) { var di = (sy - up) * W + sx; put(di, p.t, p.t === 20 ? 60 : 0, 0); if (p.hot && BURN[p.t] > 0) ignite(di, p.t); placed = true; }
            else if (isFree(sx + 1, sy - up)) { var di2 = (sy - up) * W + sx + 1; put(di2, p.t, 0, 0); placed = true; }
            else if (isFree(sx - 1, sy - up)) { var di3 = (sy - up) * W + sx - 1; put(di3, p.t, 0, 0); placed = true; }
          }
          debris.splice(k, 1);
        }
      }
    }

    /* ---------- bombs, nukes and lightning (pixel-space entities) ---------- */
    function explodeAtPx(px, py, Rpx, power, nuke) {
      var cx = Math.max(0, Math.min(W - 1, Math.floor(px / cpx())));
      var cy = Math.max(0, Math.min(H - 1, Math.floor(py / cpx())));
      addBlast(cx, cy, Rpx, power, nuke);
    }
    function entitiesStep() {
      var cs = cpx();
      for (var b = bombs.length - 1; b >= 0; b--) {
        var o = bombs[b];
        o.vy += 0.55;
        o.x += o.vx;
        o.y += o.vy;
        var gx = Math.floor(o.x / cs);
        var gy = Math.floor((o.y + 9) / cs);
        var inb = gx >= 0 && gx < W && gy >= 0 && gy < H;
        var blocked = gy >= H || (inb && ((CT[gy * W + gx] !== 0 && KIND[CT[gy * W + gx]] !== 4) || MK[gy * W + gx] === 1));
        if (blocked && o.vy > 0) {
          o.y -= o.vy;
          o.vy = -o.vy * 0.32;
          o.vx *= 0.7;
          if (Math.abs(o.vy) < 1.2) o.vy = 0;
        }
        if (o.x < 0 || o.x > window.innerWidth) { bombs.splice(b, 1); continue; }
        var oy = Math.floor(o.y / cs);
        var cells = (gx >= 0 && gx < W && oy >= 0 && oy < H) ? CT[oy * W + gx] : 0;
        o.fuse--;
        if (o.fuse % 4 === 0) fxp.push({ k: 'spark', x: o.x + 6, y: o.y - 12, vx: (rr() - 0.5) * 2, vy: -rr() * 2.4, a: 0, life: 14 });
        if (o.fuse <= 0 || cells === 20 || cells === 8) { bombs.splice(b, 1); explodeAtPx(o.x, o.y, 112, 1.8, false); }
      }
      for (var m = missiles.length - 1; m >= 0; m--) {
        var ms = missiles[m];
        ms.vy = Math.min(34, ms.vy + 1.1);
        ms.y += ms.vy;
        fxp.push({ k: 'spark', x: ms.x + (rr() - 0.5) * 8, y: ms.y - 38, vx: (rr() - 0.5) * 2, vy: -rr() * 3, a: 0, life: 18 });
        if (ms.y + 18 >= ms.ty) { missiles.splice(m, 1); nukeAt(ms.x, ms.ty); }
      }
    }
    function nukeAt(px, py) {
      var vw = window.innerWidth;
      var vh = window.innerHeight;
      var Rpx = Math.min(0.62 * Math.min(vw, vh), 540);
      addBlast(Math.floor(px / cpx()), Math.floor(py / cpx()), Rpx, 3.4, true);
      nukeFx = { x: px, y: py, t: 0, R: Rpx };
      var fl = mkDiv('ug-flash', 'position:fixed;top:0;left:0;right:0;bottom:0;background:#fff;opacity:.97;z-index:2147483646;pointer-events:none;transition:opacity 1.5s ease-out;');
      requestAnimationFrame(function () { requestAnimationFrame(function () { fl.style.opacity = '0'; }); });
      later(function () { fl.remove(); }, 1700);
      shakePage(30, 1700);
      later(function () {
        scorchOn();
        if (!gravEls.length) $('#gravity').click();
        startFires();
      }, 450);
    }
    function scorchOn() {
      if (scorchEl) return;
      scorchEl = mkDiv('ug-scorch', 'position:fixed;top:0;left:0;right:0;bottom:0;pointer-events:none;z-index:2147483640;opacity:0;transition:opacity 3s ease;' +
        'background:radial-gradient(ellipse at 50% 125%,rgba(255,110,20,.55),rgba(255,60,0,0) 58%),radial-gradient(ellipse at center,rgba(30,20,15,.3),rgba(0,0,0,.62) 100%);' +
        'backdrop-filter:sepia(.9) brightness(.5) contrast(1.15);-webkit-backdrop-filter:sepia(.9) brightness(.5) contrast(1.15);');
      requestAnimationFrame(function () { requestAnimationFrame(function () { if (scorchEl) scorchEl.style.opacity = '1'; }); });
    }
    function startFires() {
      for (var k = 0; k < 30; k++) emitters.push({ x: Math.floor(rr() * W), life: 700 + ((rr() * 500) | 0) });
      for (var q = 0; q < 6; q++) {
        var lx = Math.floor(rr() * W);
        var ly = H - 1;
        while (ly > 0 && (CT[ly * W + lx] !== 0 || MK[ly * W + lx])) ly--;
        for (var dy = -3; dy <= 0; dy++) for (var dx = -5; dx <= 5; dx++) {
          if (dx * dx + dy * dy * 4 <= 28 && isFree(lx + dx, ly + dy)) put((ly + dy) * W + lx + dx, 8, 0, 0);
        }
      }
    }
    function emittersStep() {
      for (var e = emitters.length - 1; e >= 0; e--) {
        var em = emitters[e];
        em.life--;
        if (em.life <= 0) { emitters.splice(e, 1); continue; }
        if (rr() < 0.3) {
          var y = H - 1;
          while (y > 0 && (CT[y * W + em.x] !== 0 || MK[y * W + em.x])) y--;
          if (isFree(em.x, y)) put(y * W + em.x, 20, 90 + ((rr() * 90) | 0), 1);
        }
      }
    }
    function lightningAt(px, py) {
      var pts = [[px + (rr() - 0.5) * 120, -10]];
      var segs = 14;
      for (var s = 1; s <= segs; s++) { var f = s / segs; pts.push([pts[0][0] + (px - pts[0][0]) * f + (rr() - 0.5) * 70 * (1 - f), -10 + (py + 10) * f]); }
      pts[pts.length - 1] = [px, py];
      bolts.push({ pts: pts, a: 0, life: 12 });
      var cs = cpx();
      var gx = Math.floor(px / cs);
      var gy = Math.floor(py / cs);
      addBlast(gx, gy, 30, 0.8, false);
      for (var dy = -5; dy <= 5; dy++) for (var dx = -5; dx <= 5; dx++) {
        var x = gx + dx;
        var y = gy + dy;
        if (x < 0 || x >= W || y < 0 || y >= H || dx * dx + dy * dy > 26) continue;
        var i = y * W + x;
        if (CT[i] === 1 && rr() < 0.6) put(i, 16, 0, 0);
        else if (BURN[CT[i]] > 0 && rr() < 0.7) ignite(i, CT[i]);
      }
      flashSmall();
    }
    function flashSmall() {
      var fl = mkDiv('ug-flash', 'position:fixed;top:0;left:0;right:0;bottom:0;background:#fff;opacity:.5;z-index:2147483646;pointer-events:none;transition:opacity .35s ease-out;');
      requestAnimationFrame(function () { requestAnimationFrame(function () { fl.style.opacity = '0'; }); });
      later(function () { fl.remove(); }, 450);
    }
    function shakePage(amp, ms) {
      var k = [];
      for (var i = 0; i < 18; i++) { var d = 1 - i / 18; k.push({ transform: 'translate(' + ((rr() * 2 - 1) * amp * d) + 'px,' + ((rr() * 2 - 1) * amp * d) + 'px)' }); }
      k.push({ transform: 'translate(0,0)' });
      try { document.body.animate(k, { duration: ms, easing: 'linear' }); } catch (e) {}
    }
    function boom(p) {
      if ($('#sbmute') && $('#sbmute').checked) return;
      var c = actx();
      if (!c) return;
      var dur = 0.5 + p * 0.55;
      var len = Math.floor(c.sampleRate * dur);
      var buf = c.createBuffer(1, len, c.sampleRate);
      var d = buf.getChannelData(0);
      for (var i = 0; i < len; i++) d[i] = (rr() * 2 - 1) * Math.pow(1 - i / len, 2.2);
      var src = c.createBufferSource();
      src.buffer = buf;
      var lp = c.createBiquadFilter();
      lp.type = 'lowpass';
      lp.frequency.setValueAtTime(1800, c.currentTime);
      lp.frequency.exponentialRampToValueAtTime(60, c.currentTime + dur);
      var g = c.createGain();
      g.gain.value = Math.min(1, 0.22 + p * 0.22);
      src.connect(lp); lp.connect(g); g.connect(c.destination);
      src.start();
      var o = c.createOscillator();
      var og = c.createGain();
      o.frequency.setValueAtTime(90, c.currentTime);
      o.frequency.exponentialRampToValueAtTime(28, c.currentTime + dur);
      og.gain.setValueAtTime(Math.min(0.9, 0.25 + p * 0.2), c.currentTime);
      og.gain.exponentialRampToValueAtTime(0.0001, c.currentTime + dur);
      o.connect(og); og.connect(c.destination);
      o.start();
      o.stop(c.currentTime + dur);
    }

    /* ---------- effects layer particles (full resolution) ---------- */
    function explodeFx(px, py, Rpx, power, nuke) {
      fxp.push({ k: 'ball', x: px, y: py, vx: 0, vy: 0, r: Rpx * 0.12, gr: Rpx * (nuke ? 0.035 : 0.06), a: 0, life: nuke ? 46 : 18, hot: 1, soot: 0 });
      fxp.push({ k: 'ring', x: px, y: py, r: 4, gr: Math.max(4, Rpx / (nuke ? 20 : 11)), R: Rpx * 1.25, a: 0, life: 999 });
      var ns = Math.min(70, 10 + Rpx / 5);
      for (var i = 0; i < ns; i++) fxp.push({ k: 'spark', x: px, y: py, vx: (rr() - 0.5) * power * 16, vy: (rr() - 0.8) * power * 14, a: 0, life: 24 + ((rr() * 36) | 0) });
      var np = nuke ? 0 : Math.min(9, 3 + Rpx / 30);
      for (var j = 0; j < np; j++) fxp.push({ k: 'ball', x: px + (rr() - 0.5) * Rpx * 0.5, y: py + (rr() - 0.5) * Rpx * 0.3, vx: (rr() - 0.5) * 0.8, vy: -0.6 - rr() * 1.2,
        r: Rpx * (0.12 + rr() * 0.14), gr: 0.25, a: 0, life: 70 + ((rr() * 50) | 0), hot: 0, soot: 1 });
    }
    function nukeFxStep() {
      if (!nukeFx) return;
      var n = nukeFx;
      n.t++;
      var R = n.R;
      var rise = R * 0.0046;
      if (n.t < 90) {
        for (var s = 0; s < 2; s++) fxp.push({ k: 'ball', x: n.x + (rr() - 0.5) * R * 0.1, y: n.y + (rr() - 0.5) * R * 0.05, vx: (rr() - 0.5) * 0.6,
          vy: -rise * (0.8 + rr() * 0.5), r: R * (0.045 + rr() * 0.035), gr: R * 0.0007, a: 0, life: 120, hot: 1, soot: 1 });
      }
      if (n.t > 14 && n.t < 118) {
        var capY = n.y - Math.min(n.t, 100) * rise * 1.5;
        var capW = R * 0.5 * Math.min(1, n.t / 80);
        for (var q = 0; q < 3; q++) fxp.push({ k: 'ball', x: n.x + (rr() * 2 - 1) * capW, y: capY + (rr() - 0.5) * R * 0.1, vx: (rr() - 0.5) * 0.8,
          vy: -0.3 - rr() * 0.5, r: R * (0.06 + rr() * 0.07), gr: R * 0.0005, a: 0, life: 150, hot: n.t < 60 ? 1 : 0, soot: 1 });
      }
      if (n.t > 200) nukeFx = null;
    }

    function drawFx(update) {
      var c = sbFx.ctx;
      var w = sbFx.c.width;
      var h = sbFx.c.height;
      c.clearRect(0, 0, w, h);
      var k;
      for (k = fxp.length - 1; k >= 0; k--) {
        var p = fxp[k];
        var f = p.a / p.life;
        if (p.k === 'ball') {
          if (p.hot && f < 0.75) {
            var al = 1 - f / 0.75;
            var g = c.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r);
            g.addColorStop(0, 'rgba(255,240,200,' + (al * 0.7) + ')');
            g.addColorStop(0.35, 'rgba(255,160,40,' + (al * 0.55) + ')');
            g.addColorStop(0.7, 'rgba(200,55,10,' + (al * 0.3) + ')');
            g.addColorStop(1, 'rgba(120,20,5,0)');
            c.globalCompositeOperation = 'lighter';
            c.fillStyle = g;
            c.beginPath(); c.arc(p.x, p.y, p.r, 0, 7); c.fill();
          }
          if (p.soot) {
            var sa = Math.min(1, f * 2.2) * (1 - f) * 0.78;
            var g2 = c.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r * 1.1);
            g2.addColorStop(0, 'rgba(40,34,32,' + sa + ')');
            g2.addColorStop(1, 'rgba(40,34,32,0)');
            c.globalCompositeOperation = 'source-over';
            c.fillStyle = g2;
            c.beginPath(); c.arc(p.x, p.y, p.r * 1.1, 0, 7); c.fill();
          }
          if (update) { p.x += p.vx; p.y += p.vy; p.r += p.gr; p.vx *= 0.99; p.vy *= 0.985; }
        } else if (p.k === 'spark') {
          c.globalCompositeOperation = 'lighter';
          c.strokeStyle = 'rgba(255,' + ((200 - f * 150) | 0) + ',' + ((90 - f * 70) | 0) + ',' + (1 - f) + ')';
          c.lineWidth = 2;
          c.beginPath(); c.moveTo(p.x, p.y); c.lineTo(p.x - p.vx * 1.6, p.y - p.vy * 1.6); c.stroke();
          if (update) { p.x += p.vx; p.y += p.vy; p.vy += 0.28; p.vx *= 0.99; }
        } else if (p.k === 'ring') {
          var ra = Math.max(0, 1 - p.r / p.R);
          c.globalCompositeOperation = 'lighter';
          c.strokeStyle = 'rgba(255,235,205,' + (ra * 0.8) + ')';
          c.lineWidth = 1 + ra * 5;
          c.beginPath(); c.arc(p.x, p.y, p.r, 0, 7); c.stroke();
          if (update) { p.r += p.gr; if (p.r >= p.R) p.a = p.life; }
        }
        if (update) { p.a++; if (p.a >= p.life) fxp.splice(k, 1); }
      }
      if (fxp.length > 1500 && update) fxp.splice(0, fxp.length - 1500);
      c.globalCompositeOperation = 'source-over';
      for (k = 0; k < bombs.length; k++) {
        var o = bombs[k];
        var bg = c.createRadialGradient(o.x - 3, o.y - 3, 1, o.x, o.y, 10);
        bg.addColorStop(0, '#9a9aa4'); bg.addColorStop(0.55, '#26262c'); bg.addColorStop(1, '#0c0c0f');
        c.fillStyle = bg;
        c.beginPath(); c.arc(o.x, o.y, 9, 0, 7); c.fill();
        c.strokeStyle = '#6b4a2a'; c.lineWidth = 2;
        c.beginPath(); c.moveTo(o.x + 3, o.y - 8); c.quadraticCurveTo(o.x + 9, o.y - 14, o.x + 6, o.y - 18); c.stroke();
        if (((o.fuse >> 1) & 1) === 0) {
          c.globalCompositeOperation = 'lighter';
          var fg = c.createRadialGradient(o.x + 6, o.y - 18, 0, o.x + 6, o.y - 18, 9);
          fg.addColorStop(0, 'rgba(255,240,180,1)'); fg.addColorStop(1, 'rgba(255,120,20,0)');
          c.fillStyle = fg; c.beginPath(); c.arc(o.x + 6, o.y - 18, 9, 0, 7); c.fill();
          c.globalCompositeOperation = 'source-over';
        }
      }
      for (k = 0; k < missiles.length; k++) {
        var ms = missiles[k];
        c.save();
        c.translate(ms.x, ms.y);
        c.globalCompositeOperation = 'lighter';
        var fl = c.createLinearGradient(0, -20, 0, -70 - rr() * 14);
        fl.addColorStop(0, 'rgba(255,230,160,.95)'); fl.addColorStop(1, 'rgba(255,90,10,0)');
        c.fillStyle = fl;
        c.beginPath(); c.moveTo(-6, -20); c.lineTo(6, -20); c.lineTo(0, -72); c.closePath(); c.fill();
        c.globalCompositeOperation = 'source-over';
        c.fillStyle = '#e8e8ee'; c.fillRect(-6, -20, 12, 34);
        c.fillStyle = '#9a9aa6'; c.fillRect(-6, -20, 4, 34);
        c.fillStyle = '#d62a1e';
        c.beginPath(); c.moveTo(-6, 14); c.lineTo(6, 14); c.lineTo(0, 30); c.closePath(); c.fill();
        c.fillStyle = '#b7b7c2';
        c.beginPath(); c.moveTo(-6, -20); c.lineTo(-14, -28); c.lineTo(-6, -8); c.closePath(); c.fill();
        c.beginPath(); c.moveTo(6, -20); c.lineTo(14, -28); c.lineTo(6, -8); c.closePath(); c.fill();
        c.fillStyle = '#222'; c.fillRect(-6, -2, 12, 4);
        c.restore();
      }
      for (k = bolts.length - 1; k >= 0; k--) {
        var bt = bolts[k];
        var ba = 1 - bt.a / bt.life;
        c.globalCompositeOperation = 'lighter';
        c.shadowColor = 'rgba(140,180,255,' + ba + ')';
        c.shadowBlur = 18;
        c.strokeStyle = 'rgba(235,242,255,' + ba + ')';
        c.lineWidth = 3;
        c.beginPath();
        for (var q = 0; q < bt.pts.length; q++) { if (q === 0) c.moveTo(bt.pts[q][0], bt.pts[q][1]); else c.lineTo(bt.pts[q][0], bt.pts[q][1]); }
        c.stroke();
        c.shadowBlur = 0;
        if (update) { bt.a++; if (bt.a >= bt.life) bolts.splice(k, 1); }
      }
      c.globalCompositeOperation = 'source-over';
    }

    /* ---------- painting ---------- */
    function paintAt(cx, cy, br, name, density) {
      var erase = name === 'eraser';
      var t = NAME2TY[name];
      if (!erase && !t) return;
      var r2 = br * br + 0.5;
      var kind = erase ? 0 : KIND[t];
      var rate = erase ? 1 : (kind === 3 ? 1 : (kind === 1 ? 0.45 : (kind === 2 ? 0.6 : (t === 20 ? 0.3 : 0.2)))) * density;
      for (var dy = -br; dy <= br; dy++) {
        for (var dx = -br; dx <= br; dx++) {
          if (dx * dx + dy * dy > r2) continue;
          var x = cx + dx;
          var y = cy + dy;
          if (x < 0 || x >= W || y < 0 || y >= H) continue;
          var i = y * W + x;
          if (erase) { clr(i); continue; }
          if (CT[i] !== 0 || MK[i]) continue;
          if (rr() > rate) continue;
          put(i, t, t === 20 ? 70 + ((rr() * 60) | 0) : (t === 21 ? 200 : (t === 22 || t === 23 ? 255 : 0)), 0);
        }
      }
    }
    function useTool(px, py) {
      if (sbCur === 'bomb') { bombs.push({ x: px, y: py, vx: (rr() - 0.5) * 1.2, vy: 0, fuse: 150 }); sbDown = false; return true; }
      if (sbCur === 'nuke') { if (missiles.length < 2) missiles.push({ x: px, y: -90, ty: py, vy: 0 }); sbDown = false; return true; }
      if (sbCur === 'lightning') { lightningAt(px, py); sbDown = false; return true; }
      return false;
    }
    function ptrCell(e) { return [Math.floor(e.clientX / window.innerWidth * W), Math.floor(e.clientY / window.innerHeight * H)]; }

    /* ---------- main step + render ---------- */
    function simStep() {
      frame++;
      stamp = (stamp % 250) + 1;
      if (maskDirty || frame % 20 === 0) buildMask();
      emittersStep();
      blastsStep();
      debrisStep();
      entitiesStep();
      nukeFxStep();
      if (sbDown && sbCur !== 'bomb' && sbCur !== 'nuke' && sbCur !== 'lightning') paintAt(sbLast[0], sbLast[1], sbBrush, sbCur, 0.5);
      var flip = frame & 1;
      for (var y = H - 1; y >= 0; y--) {
        var row = y * W;
        if (flip) { for (var x = 0; x < W; x++) cellStep(x, y, row + x); }
        else { for (var x2 = W - 1; x2 >= 0; x2--) cellStep(x2, y, row + x2); }
        flip ^= 1;
      }
    }
    function cellStep(x, y, i) {
      var t = CT[i];
      if (t === 0 || CM[i] === stamp) return;
      switch (KIND[t]) {
        case 1: powder(x, y, i, t); break;
        case 2: liquid(x, y, i, t); break;
        case 3: if (REACT[t]) solidStep(x, y, i, t); break;
        case 4: gasStep(x, y, i, t); break;
        case 5: fireStep(x, y, i); break;
      }
    }

    function renderGrid() {
      sbBuf.fill(0);
      sbGBuf.fill(0);
      var tm = frame * 0.05;
      for (var x0 = 0; x0 < W; x0++) DEPTH[x0] = 0;
      for (var y = 0; y < H; y++) {
        var row = y * W;
        for (var x = 0; x < W; x++) {
          var i = row + x;
          var t = CT[i];
          if (t === 0) { DEPTH[x] = 0; continue; }
          var v = CV[i];
          var j = (v - 128) / 128;
          var up = y > 0 ? CT[i - W] : 1;
          var r = 0, g = 0, b = 0, a = 255;
          var gl = 0, gr = 0, gg = 0, gb = 0;
          if (t !== 6) DEPTH[x] = 0;
          switch (t) {
            case 1:
              r = 222 + j * 14; g = 192 + j * 13; b = 124 + j * 12;
              if ((v & 15) === 0) { r -= 34; g -= 36; b -= 32; } else if ((v & 31) === 1) { r += 22; g += 26; b += 40; }
              if (up === 0) { r += 14; g += 14; b += 12; }
              break;
            case 2:
              r = 108 + j * 12; g = 76 + j * 10; b = 50 + j * 8;
              if ((v & 15) === 0) { r -= 36; g -= 28; b -= 20; } else if ((v & 63) === 3) { r += 48; g += 50; b += 52; }
              if (up === 0) { r += 10; g += 8; b += 6; }
              break;
            case 3:
              r = 236 + j * 6; g = 243 + j * 5; b = 250;
              if ((v & 31) === 5) { var tw = Math.sin(tm * 3 + v) * 0.5 + 0.5; r += tw * 19; g += tw * 12; b += tw * 5; }
              if (up !== 0) { r -= 10; g -= 8; b -= 4; }
              break;
            case 4:
              r = 44 + j * 9; g = 44 + j * 9; b = 50 + j * 9;
              if ((v & 31) === 2) { r = 130; g = 90; b = 50; }
              break;
            case 5:
              r = 148 + j * 22; g = 148 + j * 22; b = 150 + j * 22;
              if (up === 0) { r += 10; g += 10; b += 10; }
              break;
            case 6: {
              var d = ++DEPTH[x];
              var k = d > 26 ? 1 : d / 26;
              var sh = Math.sin(tm * 2 + x * 0.35 + y * 0.2) * 7;
              if (d === 1) { r = 205 + sh; g = 236 + sh; b = 255; a = 190; }
              else { r = 92 - k * 78 + sh; g = 176 - k * 110 + sh; b = 236 - k * 86 + sh; a = 172 + k * 56; }
              if (d <= 3 && (v & 127) === 9) { r += 60; g += 60; b += 20; }
              break;
            }
            case 7:
              r = 46 + j * 6; g = 30 + j * 6; b = 12 + j * 4; a = 228;
              if (up === 0) { var sv = Math.sin(tm + x * 0.4); r = 120 + 60 * sv; g = 80 + 50 * Math.sin(tm + x * 0.4 + 2); b = 60 + 60 * Math.sin(tm + x * 0.4 + 4); a = 238; }
              break;
            case 8: {
              var nz = (Math.sin(x * 0.32 + tm * 1.4 + y * 0.18) * 0.5 + 0.5) * 0.6 + (v / 255) * 0.4;
              if (nz < 0.28) { r = 112; g = 30; b = 10; gl = 90; gr = 255; gg = 70; gb = 10; }
              else { r = 255; g = 60 + nz * 190; b = 10 + nz * 40; gl = 150; gr = 255; gg = 110; gb = 20; }
              break;
            }
            case 9:
              r = 100 + j * 20; g = 250; b = 70 + j * 14; a = 198;
              if ((v & 31) === 4) { r += 80; b += 90; }
              gl = 40; gr = 110; gg = 255; gb = 70;
              break;
            case 10:
              r = 205 + j * 14; g = 78 + j * 10; b = 24; a = 240;
              if (up === 0) { r = 250; g = 150; b = 60; }
              break;
            case 11:
              r = 72 + j * 8; g = 52 + j * 7; b = 36 + j * 6;
              if (up === 0) { r += 26; g += 22; b += 18; }
              break;
            case 12:
              r = 112 + j * 18; g = 114 + j * 18; b = 122 + j * 16;
              if ((v & 15) < 2) { r -= 38; g -= 38; b -= 36; }
              if (up === 0) { r += 16; g += 16; b += 16; } else if (y < H - 1 && CT[i + W] === 0) { r -= 10; g -= 10; b -= 10; }
              break;
            case 13: {
              var grain = (x * 3 + (v >> 6)) % 6;
              if (grain < 2) { r = 116; g = 72; b = 36; } else { r = 146; g = 98; b = 56; }
              r += j * 8; g += j * 6; b += j * 5;
              if ((v & 127) === 11) { r = 84; g = 50; b = 26; }
              if (up === 0) { r += 14; g += 12; b += 8; }
              break;
            }
            case 14:
              r = 150 + j * 8 + ((y % 7) === 0 ? 30 : 0); g = 158 + j * 8 + ((y % 7) === 0 ? 30 : 0); b = 172 + j * 8 + ((y % 7) === 0 ? 28 : 0);
              if (up === 0) { r += 28; g += 28; b += 28; }
              if ((x % 11) === 0) { r -= 24; g -= 24; b -= 20; }
              break;
            case 15:
              r = 176 + j * 8; g = 224 + j * 6; b = 244; a = 218;
              if (((x + y) % 9) === 0) { r = 236; g = 250; b = 255; }
              break;
            case 16:
              r = 186; g = 232; b = 230; a = 112;
              if (((x * 2 + y) % 13) === 0) { r = 255; g = 255; b = 255; a = 190; }
              break;
            case 17:
              r = 44 + j * 18; g = 138 + j * 30; b = 52 + j * 14;
              if (up === 0) { r += 60; g += 54; b += 30; }
              if ((v & 127) === 7) { r = 226; g = 70; b = 104; }
              break;
            case 18:
              r = 26 + j * 6; g = 20 + j * 5; b = 40 + j * 8;
              if (((x * 3 + y * 2) % 17) === 0) { r = 96; g = 74; b = 140; }
              break;
            case 19:
              if ((y % 6) === 0) { r = 236; g = 214; b = 190; }
              else { r = 186 + j * 10; g = 34; b = 32; }
              if ((x % 5) === 0 && (y % 6) > 1) { r -= 40; g -= 10; b -= 10; }
              break;
            case 20: {
              var fl = CL[i] / 255;
              var fk = rr() * 30 - 15;
              if (fl > 0.7) { r = 255; g = 240 + fk; b = 170 + fk; }
              else if (fl > 0.5) { r = 255; g = 205 + fk; b = 80; }
              else if (fl > 0.3) { r = 255; g = 125 + fk; b = 24; }
              else if (fl > 0.15) { r = 225; g = 60; b = 12; }
              else { r = 120; g = 30; b = 14; }
              a = Math.min(255, 70 + fl * 320);
              gl = a * 0.55; gr = 255; gg = 140; gb = 30;
              break;
            }
            case 21:
              r = g = b = 70 + j * 30; a = (CL[i] / 255) * 175;
              break;
            case 22:
              r = g = b = 236; a = CL[i] * 0.55;
              break;
            case 23:
              r = 140; g = 220; b = 140; a = 60;
              break;
          }
          sbBuf[i] = pk(r, g, b, a);
          if (gl) sbGBuf[i] = pk(gr, gg, gb, gl);
        }
      }
      for (var k = 0; k < debris.length; k++) {
        var p = debris[k];
        var px = Math.floor(p.x);
        var py = Math.floor(p.y);
        if (px < 0 || px >= W || py < 0 || py >= H) continue;
        var bc = BASEC[p.t] || [200, 200, 200];
        var pi = py * W + px;
        sbBuf[pi] = pk(bc[0], bc[1], bc[2], 255);
        if (p.hot) { sbBuf[pi] = pk(255, 150 + rr() * 80, 40, 255); sbGBuf[pi] = pk(255, 140, 30, 200); }
      }
      sbCtx.putImageData(sbImg, 0, 0);
      sbGCtx.putImageData(sbGImg, 0, 0);
    }

    /* ---------- start / stop ---------- */
    function sbStart() {
      if (sbOn) return;
      sbOn = true;
      var base = 'position:fixed;top:0;left:0;width:100vw;height:100vh;image-rendering:pixelated;';
      sbCanvas = document.createElement('canvas');
      sbCanvas.id = 'ug-sandbox';
      sbCanvas.style.cssText = base + 'z-index:2147483644;touch-action:none;cursor:crosshair;pointer-events:' + ($('#sbpass').checked ? 'none' : 'auto') + ';';
      sbGlow = document.createElement('canvas');
      sbGlow.id = 'ug-sbglow';
      sbGlow.style.cssText = base + 'z-index:2147483644;pointer-events:none;filter:blur(' + Math.max(3, sbPix * 1.6) + 'px);opacity:.85;';
      html.appendChild(sbCanvas);
      html.appendChild(sbGlow);
      sbFx = overlay('ug-sbfx');
      sbCtx = sbCanvas.getContext('2d');
      sbGCtx = sbGlow.getContext('2d');
      initGrid();
      function down(e) {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        sbCanvas.setPointerCapture(e.pointerId);
        sbDown = true;
        var c = ptrCell(e);
        sbLast = c;
        sbPtr = [e.clientX, e.clientY];
        if (useTool(e.clientX, e.clientY)) return;
        paintAt(c[0], c[1], sbBrush, sbCur, 1);
      }
      function move(e) {
        sbPtr = [e.clientX, e.clientY];
        if (!sbDown) return;
        var c = ptrCell(e);
        var dx = c[0] - sbLast[0];
        var dy = c[1] - sbLast[1];
        var n = Math.max(Math.abs(dx), Math.abs(dy));
        var step = Math.max(1, Math.floor(sbBrush / 2));
        for (var s = step; s <= n; s += step) paintAt(Math.round(sbLast[0] + dx * s / n), Math.round(sbLast[1] + dy * s / n), sbBrush, sbCur, 1);
        sbLast = c;
      }
      function up() { sbDown = false; }
      sbCanvas.addEventListener('pointerdown', down);
      sbCanvas.addEventListener('pointermove', move);
      sbCanvas.addEventListener('pointerup', up);
      sbCanvas.addEventListener('pointercancel', up);
      var rsT;
      function onResize() { clearTimeout(rsT); rsT = setTimeout(function () { if (sbOn) initGrid(); }, 200); }
      function onScroll() { maskDirty = true; }
      window.addEventListener('resize', onResize);
      window.addEventListener('scroll', onScroll, { passive: true });
      var stop = loop(function () {
        if (!sbPaused) { for (var s = 0; s < sbSpeed; s++) simStep(); }
        renderGrid();
        drawFx(!sbPaused);
      });
      fx.sandbox = {
        o: { close: function () {
          sbOn = false;
          sbDown = false;
          sbCanvas.remove(); sbGlow.remove(); sbFx.close();
          window.removeEventListener('resize', onResize);
          window.removeEventListener('scroll', onScroll);
          clearTimeout(rsT);
          sbCanvas = sbGlow = sbFx = null;
          sbPaused = false;
          $('#sbpause').textContent = 'Pause';
          sbRestorePage(true);
        } },
        stop: stop
      };
    }
    function sbRestorePage(instant) {
      restoreGravity();
      emitters = [];
      if (scorchEl) {
        var el = scorchEl;
        scorchEl = null;
        if (instant) el.remove();
        else { el.style.opacity = '0'; later(function () { el.remove(); }, 3100); }
      }
    }

    sw('sbox', sbStart, function () { stopFx('sandbox'); });
    root.querySelectorAll('.el').forEach(function (b) {
      b.addEventListener('click', function () {
        sbCur = b.getAttribute('data-el');
        root.querySelectorAll('.el').forEach(function (x) { x.classList.toggle('on', x === b); });
        if (!sbOn) setSwitch('sbox', true);
        if (sbCanvas) sbCanvas.style.cursor = 'crosshair';
      });
    });
    root.querySelectorAll('.el').forEach(function (b) { b.classList.toggle('on', b.getAttribute('data-el') === sbCur); });
    rng('sbbrush', function (v) { sbBrush = v; });
    rng('sbres', function (v) { sbPix = v; if (sbOn) { initGrid(); sbGlow.style.filter = 'blur(' + Math.max(3, sbPix * 1.6) + 'px)'; } }, pxf);
    rng('sbgrav', function (v) { GACC = 0.05 * v; MAXV = 3 + v * 0.8; });
    rng('sbspeed', function (v) { sbSpeed = v; }, function (v) { return v + 'x'; });
    rng('sbwind', function (v) { WINDV = v * 0.012; }, function (v) { return v === 0 ? 'none' : (v > 0 ? 'right ' + v : 'left ' + (-v)); });
    sw('sbghost', function () { maskDirty = true; }, function () { maskDirty = true; });
    sw('sbpass', function () { if (sbCanvas) sbCanvas.style.pointerEvents = 'none'; }, function () { if (sbCanvas) sbCanvas.style.pointerEvents = 'auto'; });
    click('sbpause', function () { sbPaused = !sbPaused; $('#sbpause').textContent = sbPaused ? 'Resume' : 'Pause'; });
    click('sbclear', function () {
      if (!sbOn) return say('Turn the sandbox on first');
      CT.fill(0); CL.fill(0); CA.fill(0); CVY.fill(0);
      debris = []; blasts = []; bombs = []; missiles = []; fxp = []; bolts = []; emitters = []; nukeFx = null;
      say('Sandbox cleared');
    });
    click('sbrestore', function () { sbRestorePage(false); say('Page restored'); });
    click('opensb', function () { showTab('p-sandbox'); });
    click('sbback', function () { showTab('p-play'); });
    window.__utilityGui.sb = {
      W: function () { return W; }, H: function () { return H; },
      get: function (x, y) { return CT[y * W + x]; },
      put: function (x, y, name) { var t = NAME2TY[name]; if (t && x >= 0 && x < W && y >= 0 && y < H) put(y * W + x, t, t === 20 ? 90 : (t === 21 ? 200 : (t >= 22 && t <= 23 ? 255 : 0)), 0); },
      count: function (name) { var t = NAME2TY[name]; var n = 0; for (var i = 0; i < CT.length; i++) if (CT[i] === t) n++; return n; },
      steps: function (n) { for (var i = 0; i < n; i++) simStep(); },
      state: function () { return { debris: debris.length, blasts: blasts.length, bombs: bombs.length, missiles: missiles.length, emitters: emitters.length, scorch: !!scorchEl, mask: MK ? MK.reduce(function (a, b) { return a + b; }, 0) : 0 }; },
      useTool: function (px, py, name) { sbCur = name; return useTool(px, py); },
      cell: function () { return cpx(); }
    };
    cleanups.push(function () { if (window.__utilityGui) delete window.__utilityGui.sb; });

    /* =================== PLAY: GAMES (each one opens in its own full window) =================== */
    var gameWin = null;
    var gameCleanup = null;
    var GAME_CSS = [
      ':host{all:initial}',
      '*{box-sizing:border-box;font-family:Inter,-apple-system,"Segoe UI",Roboto,sans-serif}',
      '.back{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(6,8,14,.86);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);',
      'display:flex;align-items:center;justify-content:center;animation:gin .22s ease}',
      '@keyframes gin{from{opacity:0;transform:scale(.97)}to{opacity:1;transform:none}}',
      '.win{width:min(980px,95vw);height:min(820px,95vh);background:#14161d;border:1px solid rgba(255,255,255,.1);border-radius:24px;',
      'box-shadow:0 40px 100px rgba(0,0,0,.6);display:flex;flex-direction:column;overflow:hidden;color:#f2f2f2}',
      '.bar{display:flex;justify-content:space-between;align-items:flex-start;padding:20px 28px 14px;border-bottom:1px solid rgba(255,255,255,.07);flex:none}',
      '.bar h1{margin:0;font-size:28px;letter-spacing:-.02em;font-weight:700}',
      '.bar p{margin:6px 0 0;color:#8a8f9c;font-size:14px}',
      '.x{background:rgba(255,255,255,.06);border:none;color:#cfd3dc;width:38px;height:38px;border-radius:12px;font-size:22px;cursor:pointer;flex:none}',
      '.x:hover{background:rgba(255,255,255,.14);color:#fff}',
      '.stage{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:14px;padding:18px;overflow:auto;min-height:0;position:relative}',
      '.stage>:first-child{margin-top:auto}.stage>:last-child{margin-bottom:auto}',
      '.row{display:flex;gap:12px;align-items:center;flex-wrap:wrap;justify-content:center}',
      '.btn{background:#222633;border:1px solid rgba(255,255,255,.1);color:#eef0f5;border-radius:12px;padding:9px 16px;font-size:14px;cursor:pointer}',
      '.btn:hover{background:#2c3142}',
      '.btn.on{background:var(--a,#2cc38b);color:#06150e;border-color:transparent;font-weight:700}',
      '.stat{font-size:14px;color:#a9afbd;display:flex;gap:8px;align-items:baseline}.stat b{color:#fff;font-size:20px;font-variant-numeric:tabular-nums}',
      '.msg{font-size:19px;font-weight:600;min-height:28px;text-align:center}',
      '.hint{font-size:13px;color:#7c8190;text-align:center}',
      'canvas{border-radius:14px;background:#0c0e13;box-shadow:0 0 0 1px rgba(255,255,255,.08);touch-action:none;display:block}',
      '@keyframes shk{0%,100%{transform:translateY(0) rotate(0)}25%{transform:translateY(-22px) rotate(-8deg)}75%{transform:translateY(8px) rotate(8deg)}}',
      '@keyframes pop{0%{transform:scale(.6)}60%{transform:scale(1.12)}100%{transform:scale(1)}}',
      '@keyframes drp{from{transform:translateY(var(--dy,-300px))}to{transform:none}}'
    ].join('');
    function gEl(tag, cls, text) {
      var e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text != null) e.textContent = text;
      return e;
    }
    function closeGame() {
      if (gameCleanup) { try { gameCleanup(); } catch (err) {} gameCleanup = null; }
      if (gameWin) { gameWin.remove(); gameWin = null; }
      host.style.visibility = '';
      if (window.__utilityGui) delete window.__utilityGui.game;
    }
    var GAME_IMPL = {};
    function openGame(id) {
      closeGame();
      var meta = GAMES.filter(function (g) { return g[0] === id; })[0];
      if (!meta || !GAME_IMPL[id]) return;
      host.style.visibility = 'hidden';
      var hostG = mkDiv('ug-game', 'position:fixed;top:0;left:0;right:0;bottom:0;z-index:2147483646;');
      hostG.style.setProperty('--a', (ACCENTS[curAccent] || ACCENTS.Emerald)[1]);
      var rootG = hostG.attachShadow({ mode: 'open' });
      rootG.innerHTML = '<style>' + GAME_CSS + '</style><div class="back"><div class="win"><div class="bar"><div><h1></h1><p></p></div>' +
        '<button class="x" title="Close (Esc)">\u00D7</button></div><div class="stage"></div></div></div>';
      rootG.querySelector('h1').textContent = meta[1] + '  ' + meta[2];
      rootG.querySelector('p').textContent = meta[3];
      rootG.querySelector('.x').addEventListener('click', closeGame);
      var stage = rootG.querySelector('.stage');
      var cl = [];
      var api = {
        stage: stage,
        el: gEl,
        btn: function (text, fn, cls) { var b = gEl('button', 'btn' + (cls ? ' ' + cls : ''), text); b.addEventListener('click', fn); return b; },
        stat: function (label, init) {
          var d = gEl('div', 'stat');
          d.appendChild(document.createTextNode(label));
          var b = gEl('b', '', init == null ? '0' : String(init));
          d.appendChild(b);
          return { el: d, set: function (v) { b.textContent = String(v); } };
        },
        key: function (fn) {
          function h(e) { if (fn(e)) { e.preventDefault(); e.stopPropagation(); } }
          window.addEventListener('keydown', h, true);
          cl.push(function () { window.removeEventListener('keydown', h, true); });
        },
        keyup: function (fn) {
          window.addEventListener('keyup', fn, true);
          cl.push(function () { window.removeEventListener('keyup', fn, true); });
        },
        on: function (target, ev, fn, opts) { target.addEventListener(ev, fn, opts); cl.push(function () { target.removeEventListener(ev, fn, opts); }); },
        loop: function (fn) { var stop = loop(fn); cl.push(stop); return stop; },
        every: function (fn, ms) { var t = setInterval(fn, ms); var stop = function () { clearInterval(t); }; cl.push(stop); return stop; },
        after: function (fn, ms) { var t = setTimeout(fn, ms); cl.push(function () { clearTimeout(t); }); return t; },
        hi: function (k) { return (GLOB.hi || {})[k] || 0; },
        setHi: function (k, v) { var h = GLOB.hi || {}; h[k] = v; gset('hi', h); },
        canvas: function (w, h, reserve) {
          var cv = gEl('canvas');
          var availW = Math.max(200, stage.clientWidth - 40);
          var availH = Math.max(200, stage.clientHeight - (reserve == null ? 120 : reserve));
          var s = Math.min(1, availW / w, availH / h);
          var dpr = window.devicePixelRatio || 1;
          cv.width = Math.round(w * s * dpr);
          cv.height = Math.round(h * s * dpr);
          cv.style.width = Math.round(w * s) + 'px';
          cv.style.height = Math.round(h * s) + 'px';
          var ctx = cv.getContext('2d');
          ctx.scale(s * dpr, s * dpr);
          return { c: cv, ctx: ctx, w: w, h: h, s: s, pos: function (e) {
            var r = cv.getBoundingClientRect();
            return { x: (e.clientX - r.left) / r.width * w, y: (e.clientY - r.top) / r.height * h };
          } };
        },
        tone: function (f, d, type, v) { tone(f, d, type || 'sine', v == null ? 0.18 : v); }
      };
      gameWin = hostG;
      var inst = GAME_IMPL[id](stage, api) || {};
      gameCleanup = function () { cl.forEach(function (f) { try { f(); } catch (err) {} }); if (inst.destroy) inst.destroy(); };
      window.__utilityGui.game = inst;
      inst.id = id;
    }
    root.querySelectorAll('.gm').forEach(function (b) {
      b.addEventListener('click', function () { openGame(b.getAttribute('data-game')); });
    });
    cleanups.push(closeGame);

    /* ---------- Tic Tac Toe ---------- */
    GAME_IMPL.ttt = function (stage, api) {
      var LINES = [[0, 1, 2], [3, 4, 5], [6, 7, 8], [0, 3, 6], [1, 4, 7], [2, 5, 8], [0, 4, 8], [2, 4, 6]];
      var mode = 'hard';
      var board = [];
      var turn = 'X';
      var over = false;
      var lock = false;
      var starter = 'O';
      var scores = { X: 0, O: 0, D: 0 };
      var modeRow = api.el('div', 'row');
      var mbtn = {};
      [['hard', 'vs Computer (Hard)'], ['easy', 'vs Computer (Easy)'], ['pvp', '2 Players']].forEach(function (m) {
        mbtn[m[0]] = api.btn(m[1], function () { mode = m[0]; scores = { X: 0, O: 0, D: 0 }; starter = 'O'; reset(); }, mode === m[0] ? 'on' : '');
        modeRow.appendChild(mbtn[m[0]]);
      });
      var msg = api.el('div', 'msg');
      var grid = api.el('div');
      grid.style.cssText = 'display:grid;grid-template-columns:repeat(3,112px);gap:10px;';
      var cells = [];
      for (var i = 0; i < 9; i++) {
        var c = api.el('button');
        c.style.cssText = 'width:112px;height:112px;font-size:62px;font-weight:800;background:#1d2130;border:1px solid rgba(255,255,255,.1);border-radius:18px;color:#fff;cursor:pointer;transition:background .15s,transform .1s;';
        (function (idx) { c.addEventListener('click', function () { play(idx); }); })(i);
        cells.push(c);
        grid.appendChild(c);
      }
      var score = api.el('div', 'stat');
      var again = api.btn('New Game', function () { reset(); });
      stage.appendChild(modeRow); stage.appendChild(msg); stage.appendChild(grid); stage.appendChild(score); stage.appendChild(again);
      function winner(b) {
        for (var k = 0; k < LINES.length; k++) {
          var l = LINES[k];
          if (b[l[0]] && b[l[0]] === b[l[1]] && b[l[0]] === b[l[2]]) return { p: b[l[0]], line: l };
        }
        return null;
      }
      function full(b) { return b.every(function (v) { return v; }); }
      function minimax(b, p, depth) {
        var w = winner(b);
        if (w) return w.p === 'O' ? 10 - depth : depth - 10;
        if (full(b)) return 0;
        var best = p === 'O' ? -99 : 99;
        for (var k = 0; k < 9; k++) {
          if (b[k]) continue;
          b[k] = p;
          var v = minimax(b, p === 'O' ? 'X' : 'O', depth + 1);
          b[k] = '';
          if (p === 'O') { if (v > best) best = v; } else if (v < best) best = v;
        }
        return best;
      }
      function bestMove(b) {
        var empties = [];
        for (var k = 0; k < 9; k++) if (!b[k]) empties.push(k);
        if (mode === 'easy' && Math.random() < 0.55) return empties[(Math.random() * empties.length) | 0];
        var bestV = -99;
        var moves = [];
        empties.forEach(function (k) {
          b[k] = 'O';
          var v = minimax(b, 'X', 1);
          b[k] = '';
          if (v > bestV) { bestV = v; moves = [k]; } else if (v === bestV) moves.push(k);
        });
        return moves[(Math.random() * moves.length) | 0];
      }
      function label() {
        if (mode === 'pvp') return ['Player X', 'Player O'];
        return ['You (X)', 'Computer (O)'];
      }
      function render() {
        cells.forEach(function (c, k) {
          c.textContent = board[k] || '';
          c.style.color = board[k] === 'X' ? '#6ea8ff' : '#ffb86b';
          c.style.background = '#1d2130';
          c.style.transform = 'none';
        });
        var l = label();
        score.textContent = l[0] + ': ' + scores.X + '   ·   Draws: ' + scores.D + '   ·   ' + l[1] + ': ' + scores.O;
        Object.keys(mbtn).forEach(function (k) { mbtn[k].className = 'btn' + (k === mode ? ' on' : ''); });
      }
      function finish() {
        var w = winner(board);
        over = true;
        if (w) {
          scores[w.p]++;
          w.line.forEach(function (k) { cells[k].style.background = '#2a4a3a'; cells[k].style.transform = 'scale(1.05)'; });
          msg.textContent = mode === 'pvp' ? 'Player ' + w.p + ' wins!' : (w.p === 'X' ? 'You win!' : 'The computer wins');
        } else { scores.D++; msg.textContent = "It's a draw"; }
        var l = label();
        score.textContent = l[0] + ': ' + scores.X + '   ·   Draws: ' + scores.D + '   ·   ' + l[1] + ': ' + scores.O;
      }
      function cpuTurn() {
        if (over || mode === 'pvp') return;
        lock = true;
        msg.textContent = 'Computer is thinking...';
        api.after(function () {
          var m = bestMove(board.slice());
          board[m] = 'O';
          turn = 'X';
          render();
          lock = false;
          if (winner(board) || full(board)) finish(); else msg.textContent = 'Your turn (X)';
          if (over) highlight();
        }, 380);
      }
      function highlight() { var w = winner(board); if (w) w.line.forEach(function (k) { cells[k].style.background = '#2a4a3a'; cells[k].style.transform = 'scale(1.05)'; }); }
      function play(k) {
        if (over || lock || board[k]) return;
        board[k] = turn;
        var next = turn === 'X' ? 'O' : 'X';
        render();
        if (winner(board) || full(board)) { finish(); highlight(); return; }
        turn = next;
        if (mode === 'pvp') msg.textContent = 'Player ' + turn + "'s turn";
        else cpuTurn();
      }
      function reset() {
        board = ['', '', '', '', '', '', '', '', ''];
        over = false; lock = false; turn = 'X';
        starter = starter === 'X' ? 'O' : 'X';
        render();
        if (mode === 'pvp') { msg.textContent = "Player X's turn"; return; }
        if (starter === 'O') { turn = 'O'; cpuTurn(); } else msg.textContent = 'Your turn (X)';
      }
      reset();
      return { play: play, board: function () { return board.slice(); }, msg: function () { return msg.textContent; }, scores: function () { return scores; }, mode: function (m) { mode = m; reset(); } };
    };

    /* ---------- Rock Paper Scissors ---------- */
    GAME_IMPL.rps = function (stage, api) {
      var CH = { rock: '✊', paper: '✋', scissors: '✌️' };
      var BEATS = { rock: 'scissors', paper: 'rock', scissors: 'paper' };
      var VERB = { 'rock>scissors': 'Rock crushes scissors', 'paper>rock': 'Paper covers rock', 'scissors>paper': 'Scissors cut paper' };
      var you = 0;
      var cpu = 0;
      var ties = 0;
      var streak = 0;
      var busy = false;
      var matchOver = false;
      var TARGET = 5;
      var last = null;
      var sc = api.el('div', 'row');
      var sYou = api.stat('You'); var sTie = api.stat('Ties'); var sCpu = api.stat('Computer'); var sStreak = api.stat('Win streak');
      [sYou, sTie, sCpu, sStreak].forEach(function (s) { sc.appendChild(s.el); });
      var arena = api.el('div');
      arena.style.cssText = 'display:flex;gap:70px;align-items:center;justify-content:center;margin:6px 0;';
      function hand(label) {
        var w = api.el('div');
        w.style.cssText = 'display:flex;flex-direction:column;align-items:center;gap:10px;';
        var h = api.el('div', '', CH.rock);
        h.style.cssText = 'font-size:112px;line-height:1;';
        var l = api.el('div', 'stat', label);
        w.appendChild(h); w.appendChild(l);
        return { w: w, h: h };
      }
      var hy = hand('You');
      var hc = hand('Computer');
      hc.h.style.transform = 'scaleX(-1)';
      arena.appendChild(hy.w); arena.appendChild(hc.w);
      var msg = api.el('div', 'msg', 'Pick your move');
      var row = api.el('div', 'row');
      Object.keys(CH).forEach(function (k) {
        var b = api.btn(CH[k] + '  ' + k.charAt(0).toUpperCase() + k.slice(1), function () { play(k); });
        b.style.cssText = 'font-size:20px;padding:14px 22px;';
        row.appendChild(b);
      });
      var info = api.el('div', 'hint', 'First to ' + TARGET + ' wins the match');
      var reset = api.btn('New Match', function () { you = cpu = ties = streak = 0; matchOver = false; busy = false; hy.h.textContent = hc.h.textContent = CH.rock; msg.textContent = 'Pick your move'; update(); });
      stage.appendChild(sc); stage.appendChild(arena); stage.appendChild(msg); stage.appendChild(row); stage.appendChild(info); stage.appendChild(reset);
      function update() { sYou.set(you); sTie.set(ties); sCpu.set(cpu); sStreak.set(streak); }
      function reveal(p, c) {
        hy.h.style.animation = hc.h.style.animation = 'none';
        hy.h.textContent = CH[p]; hc.h.textContent = CH[c];
        var r = p === c ? 'tie' : (BEATS[p] === c ? 'win' : 'lose');
        if (r === 'tie') { ties++; streak = 0; msg.textContent = 'Tie! You both chose ' + p; }
        else if (r === 'win') { you++; streak++; msg.textContent = 'You win! ' + VERB[p + '>' + c]; }
        else { cpu++; streak = 0; msg.textContent = 'You lose. ' + VERB[c + '>' + p]; }
        last = { p: p, c: c, r: r };
        update();
        busy = false;
        if (you >= TARGET || cpu >= TARGET) { matchOver = true; msg.textContent = (you >= TARGET ? 'You won the match! ' : 'The computer won the match. ') + 'Press New Match to play again.'; }
      }
      function play(p, forcedCpu) {
        if (busy || matchOver) return;
        busy = true;
        var c = forcedCpu || ['rock', 'paper', 'scissors'][(Math.random() * 3) | 0];
        if (forcedCpu) { reveal(p, c); return; }
        hy.h.textContent = hc.h.textContent = CH.rock;
        hy.h.style.animation = hc.h.style.animation = 'shk .5s ease-in-out 2';
        msg.textContent = 'Rock... Paper... Scissors...';
        api.after(function () { reveal(p, c); }, 1000);
      }
      update();
      return { play: play, state: function () { return { you: you, cpu: cpu, ties: ties, last: last, over: matchOver }; } };
    };

    /* ---------- Snake ---------- */
    GAME_IMPL.snake = function (stage, api) {
      var N = 26;
      var CS = 20;
      var cv = api.canvas(N * CS, N * CS, 150);
      var ctx = cv.ctx;
      var snake, dir, nextDir, food, score, dead, paused, started, interval, last = 0, walls = true;
      var best = api.hi('snake');
      var top = api.el('div', 'row');
      var sScore = api.stat('Score'); var sBest = api.stat('Best', best);
      var wallBtn = api.btn('Walls: Deadly', function () { walls = !walls; wallBtn.textContent = walls ? 'Walls: Deadly' : 'Walls: Wrap around'; reset(); });
      var newBtn = api.btn('New Game', function () { reset(); });
      top.appendChild(sScore.el); top.appendChild(sBest.el); top.appendChild(wallBtn); top.appendChild(newBtn);
      var hint = api.el('div', 'hint', 'Arrow keys or WASD to move  ·  Space to pause  ·  Enter to restart');
      stage.appendChild(top); stage.appendChild(cv.c); stage.appendChild(hint);
      function placeFood() {
        for (var tries = 0; tries < 500; tries++) {
          var f = { x: (Math.random() * N) | 0, y: (Math.random() * N) | 0 };
          if (!snake.some(function (s) { return s.x === f.x && s.y === f.y; })) { food = f; return; }
        }
      }
      function reset() {
        snake = [{ x: 13, y: 13 }, { x: 12, y: 13 }, { x: 11, y: 13 }];
        dir = nextDir = { x: 1, y: 0 };
        score = 0; dead = false; paused = false; started = false; interval = 115;
        sScore.set(0);
        placeFood();
      }
      function step() {
        dir = nextDir;
        var h = { x: snake[0].x + dir.x, y: snake[0].y + dir.y };
        if (walls) { if (h.x < 0 || h.y < 0 || h.x >= N || h.y >= N) { die(); return; } }
        else { h.x = (h.x + N) % N; h.y = (h.y + N) % N; }
        if (snake.some(function (s, i) { return i < snake.length - 1 && s.x === h.x && s.y === h.y; })) { die(); return; }
        snake.unshift(h);
        if (h.x === food.x && h.y === food.y) {
          score += 10;
          sScore.set(score);
          interval = Math.max(52, interval - 3);
          placeFood();
          api.tone(660, 0.08, 'square', 0.08);
        } else snake.pop();
      }
      function die() {
        dead = true;
        api.tone(140, 0.35, 'sawtooth', 0.12);
        if (score > best) { best = score; api.setHi('snake', best); sBest.set(best); }
      }
      function draw() {
        ctx.fillStyle = '#0c0e13'; ctx.fillRect(0, 0, N * CS, N * CS);
        for (var y = 0; y < N; y++) for (var x = 0; x < N; x++) if ((x + y) % 2 === 0) { ctx.fillStyle = 'rgba(255,255,255,.025)'; ctx.fillRect(x * CS, y * CS, CS, CS); }
        var fg = ctx.createRadialGradient(food.x * CS + 10, food.y * CS + 10, 1, food.x * CS + 10, food.y * CS + 10, 16);
        fg.addColorStop(0, 'rgba(255,90,90,.55)'); fg.addColorStop(1, 'rgba(255,90,90,0)');
        ctx.fillStyle = fg; ctx.fillRect(food.x * CS - 8, food.y * CS - 8, CS + 16, CS + 16);
        ctx.fillStyle = '#ff4d4d'; ctx.beginPath(); ctx.arc(food.x * CS + 10, food.y * CS + 11, 7, 0, 7); ctx.fill();
        ctx.fillStyle = '#5ee07a'; ctx.beginPath(); ctx.ellipse(food.x * CS + 13, food.y * CS + 4, 4, 2, -0.6, 0, 7); ctx.fill();
        for (var i = snake.length - 1; i >= 0; i--) {
          var s = snake[i];
          var f = 1 - i / Math.max(8, snake.length) * 0.55;
          ctx.fillStyle = 'rgb(' + ((60 * f) | 0) + ',' + ((220 * f) | 0) + ',' + ((130 * f) | 0) + ')';
          ctx.beginPath();
          if (ctx.roundRect) ctx.roundRect(s.x * CS + 1, s.y * CS + 1, CS - 2, CS - 2, i === 0 ? 8 : 6); else ctx.rect(s.x * CS + 1, s.y * CS + 1, CS - 2, CS - 2);
          ctx.fill();
        }
        var hd = snake[0];
        ctx.fillStyle = '#0b1a12';
        var ex = dir.x === 0 ? 4 : 0, ey = dir.y === 0 ? 4 : 0;
        ctx.beginPath(); ctx.arc(hd.x * CS + 10 + dir.x * 3 + ex * 0.9, hd.y * CS + 10 + dir.y * 3 - ey * 0.9, 2.2, 0, 7); ctx.arc(hd.x * CS + 10 + dir.x * 3 - ex * 0.9, hd.y * CS + 10 + dir.y * 3 + ey * 0.9, 2.2, 0, 7); ctx.fill();
        if (!started || paused || dead) {
          ctx.fillStyle = 'rgba(8,10,14,.62)'; ctx.fillRect(0, 0, N * CS, N * CS);
          ctx.fillStyle = '#fff'; ctx.font = '700 26px Inter,sans-serif'; ctx.textAlign = 'center';
          ctx.fillText(dead ? 'Game over  ·  Score ' + score : (paused ? 'Paused' : 'Press an arrow key to start'), N * CS / 2, N * CS / 2);
          ctx.textAlign = 'start';
        }
      }
      function setDir(dx, dy) {
        if (dead) return;
        if (dx === -dir.x && dy === -dir.y && snake.length > 1) return;
        nextDir = { x: dx, y: dy };
        started = true;
      }
      api.key(function (e) {
        var k = e.key;
        if (k === 'ArrowUp' || k === 'w' || k === 'W') { setDir(0, -1); return true; }
        if (k === 'ArrowDown' || k === 's' || k === 'S') { setDir(0, 1); return true; }
        if (k === 'ArrowLeft' || k === 'a' || k === 'A') { setDir(-1, 0); return true; }
        if (k === 'ArrowRight' || k === 'd' || k === 'D') { setDir(1, 0); return true; }
        if (k === ' ') { if (started && !dead) paused = !paused; return true; }
        if (k === 'Enter') { reset(); return true; }
        return false;
      });
      api.loop(function (t) {
        if (started && !paused && !dead && t - last >= interval) { last = t; step(); }
        draw();
      });
      reset();
      return { state: function () { return { snake: snake.map(function (s) { return [s.x, s.y]; }), food: [food.x, food.y], score: score, dead: dead, started: started, dir: [dir.x, dir.y] }; },
        step: step, setDir: setDir, setFood: function (x, y) { food = { x: x, y: y }; } };
    };

    /* ---------- Pong ---------- */
    GAME_IMPL.pong = function (stage, api) {
      var W = 720;
      var H = 420;
      var cv = api.canvas(W, H, 160);
      var ctx = cv.ctx;
      var PH = 84;
      var PW = 12;
      var py = H / 2 - PH / 2;
      var ay = H / 2 - PH / 2;
      var ball, trail, ps = 0, as = 0, state = 'ready', serveDir = 1, keys = {}, mouseY = null, TARGET = 7;
      var top = api.el('div', 'row');
      var msg = api.el('div', 'msg', 'Click or press Space to serve');
      var newBtn = api.btn('New Match', function () { ps = as = 0; serve(1); });
      top.appendChild(newBtn);
      var hint = api.el('div', 'hint', 'Move the mouse, or use W/S or the arrow keys  ·  First to ' + TARGET + ' wins');
      stage.appendChild(top); stage.appendChild(msg); stage.appendChild(cv.c); stage.appendChild(hint);
      function serve(d) {
        serveDir = d;
        ball = { x: W / 2, y: H / 2, vx: 0, vy: 0, sp: 6 };
        trail = [];
        state = 'ready';
        msg.textContent = 'Click or press Space to serve';
      }
      function launch() {
        if (state !== 'ready') return;
        var a = (Math.random() - 0.5) * 0.8;
        ball.vx = Math.cos(a) * ball.sp * serveDir;
        ball.vy = Math.sin(a) * ball.sp;
        state = 'play';
        msg.textContent = ps + '  :  ' + as;
      }
      function update(dt) {
        var spd = 7;
        if (keys.up) py -= spd * dt;
        if (keys.down) py += spd * dt;
        if (mouseY !== null) py += (mouseY - PH / 2 - py) * Math.min(1, 0.35 * dt);
        py = Math.max(0, Math.min(H - PH, py));
        if (state === 'ready') { ball.y = H / 2 + Math.sin(performance.now() / 300) * 40; }
        if (state === 'play') {
          trail.push({ x: ball.x, y: ball.y });
          if (trail.length > 9) trail.shift();
          ball.x += ball.vx * dt;
          ball.y += ball.vy * dt;
          if (ball.y < 8) { ball.y = 8; ball.vy = Math.abs(ball.vy); }
          if (ball.y > H - 8) { ball.y = H - 8; ball.vy = -Math.abs(ball.vy); }
          var ty = ball.vx > 0 ? ball.y : H / 2;
          var ac = ay + PH / 2;
          var maxv = 4.6 * dt;
          ay += Math.max(-maxv, Math.min(maxv, (ty - ac) * 0.9));
          ay = Math.max(0, Math.min(H - PH, ay));
          if (ball.vx < 0 && ball.x - 8 < 24 + PW && ball.x - 8 > 14 && ball.y > py - 6 && ball.y < py + PH + 6) hit(py, 1);
          if (ball.vx > 0 && ball.x + 8 > W - 24 - PW && ball.x + 8 < W - 14 && ball.y > ay - 6 && ball.y < ay + PH + 6) hit(ay, -1);
          if (ball.x < -20) { as++; point(1); }
          else if (ball.x > W + 20) { ps++; point(-1); }
        }
      }
      function hit(pyy, dirx) {
        var rel = (ball.y - (pyy + PH / 2)) / (PH / 2);
        ball.sp = Math.min(15, ball.sp * 1.06);
        var ang = rel * 0.95;
        ball.vx = Math.cos(ang) * ball.sp * dirx;
        ball.vy = Math.sin(ang) * ball.sp;
        ball.x = dirx > 0 ? 24 + PW + 9 : W - 24 - PW - 9;
        api.tone(dirx > 0 ? 520 : 400, 0.05, 'square', 0.06);
      }
      function point(d) {
        api.tone(200, 0.2, 'sawtooth', 0.08);
        if (ps >= TARGET || as >= TARGET) {
          state = 'over';
          msg.textContent = (ps >= TARGET ? 'You win the match! ' : 'The computer wins. ') + 'Press New Match.';
          return;
        }
