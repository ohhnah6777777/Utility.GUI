      var ctx = cv.ctx;
      var COLS = 10;
      var ROWS = 7;
      var BW = 58;
      var BH = 20;
      var GAP = 4;
      var OX = (W - (COLS * (BW + GAP) - GAP)) / 2;
      var OY = 56;
      var COLORS = ['#ff5d5d', '#ff9d4d', '#ffd84d', '#7ee06a', '#4dd2c8', '#5d9bff', '#b07dff'];
      var paddle = { x: W / 2 - 45, w: 90, h: 12, y: H - 34 };
