    /* ---------- Minesweeper ---------- */
    GAME_IMPL.mines = function (stage, api) {
      var LEVELS = { Beginner: [9, 9, 10], Intermediate: [16, 16, 40], Expert: [16, 30, 99] };
      var level = 'Beginner';
      var R, C, M, mine, adj, rev, flag, placed, over, won, revealed, flags, started, secs, timer;
      var lvRow = api.el('div', 'row');
      var lvBtn = {};
      Object.keys(LEVELS).forEach(function (k) { lvBtn[k] = api.btn(k, function () { level = k; reset(); }, k === level ? 'on' : ''); lvRow.appendChild(lvBtn[k]); });
      var top = api.el('div', 'row');
      var sMines = api.stat('Mines'); var face = api.btn('🙂', function () { reset(); }); face.style.fontSize = '22px'; var sTime = api.stat('Time', 0);
      top.appendChild(sMines.el); top.appendChild(face); top.appendChild(sTime.el);
      var grid = api.el('div');
      var hint = api.el('div', 'hint', 'Click to reveal  ·  Right-click to flag  ·  Double-click a number to clear around it');
      stage.appendChild(lvRow); stage.appendChild(top); stage.appendChild(grid); stage.appendChild(hint);
      var NUMC = ['', '#6ea8ff', '#5ee07a', '#ff6b6b', '#b07dff', '#ff9d4d', '#4dd9e8', '#e8e8e8', '#9aa0ad'];
      var cells = [];
      function idx(r, c) { return r * C + c; }
      function nbrs(r, c) {
        var out = [];
        for (var dr = -1; dr <= 1; dr++) for (var dc = -1; dc <= 1; dc++) { if (!dr && !dc) continue; var nr = r + dr, nc = c + dc; if (nr >= 0 && nr < R && nc >= 0 && nc < C) out.push([nr, nc]); }
        return out;
      }
      function reset() {
        clearInterval(timer);
        var cfg2 = LEVELS[level]; R = cfg2[0]; C = cfg2[1]; M = cfg2[2];
        mine = []; adj = []; rev = []; flag = [];
        for (var i = 0; i < R * C; i++) { mine.push(false); adj.push(0); rev.push(false); flag.push(false); }
        placed = false; over = false; won = false; revealed = 0; flags = 0; started = false; secs = 0;
        face.textContent = '🙂'; sTime.set(0); sMines.set(M);
        Object.keys(lvBtn).forEach(function (k) { lvBtn[k].className = 'btn' + (k === level ? ' on' : ''); });
        var cs = Math.min(32, Math.floor((Math.min(stage.clientWidth - 60, 900)) / C), Math.floor((stage.clientHeight - 210) / R));
        cs = Math.max(20, cs);
        grid.innerHTML = '';
        grid.style.cssText = 'display:grid;grid-template-columns:repeat(' + C + ',' + cs + 'px);gap:2px;background:#0c0e13;padding:6px;border-radius:12px;';
        cells = [];
        for (var r = 0; r < R; r++) for (var c = 0; c < C; c++) {
          var b = api.el('button');
          b.style.cssText = 'width:' + cs + 'px;height:' + cs + 'px;font-size:' + Math.floor(cs * 0.55) + 'px;font-weight:800;background:#2a3042;border:none;border-radius:5px;color:#fff;cursor:pointer;padding:0;';
          (function (rr, cc) {
            b.addEventListener('click', function () { reveal(rr, cc); });
            b.addEventListener('contextmenu', function (e) { e.preventDefault(); toggleFlag(rr, cc); });
            b.addEventListener('dblclick', function () { chord(rr, cc); });
          })(r, c);
