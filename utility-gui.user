          b.textContent = mine[i] ? '💣' : (adj[i] ? adj[i] : ''); b.style.color = NUMC[adj[i]] || '#fff';
        } else { b.style.background = '#2a3042'; b.textContent = flag[i] ? '🚩' : ''; }
