      }
      function drop(c) {
        if (over || lock) return false;
        var r = rowFor(board, c);
        if (r < 0) return false;
        board[r][c] = turn; lastDropRow = r;
        api.tone(turn === 1 ? 330 : 262, 0.1, 'sine', 0.1);
        var w = findWin(board);
        if (w) { over = true; winCells = w.cells; scores[w.p]++; msg.textContent = mode === '2 Players' ? (w.p === 1 ? 'Red wins!' : 'Yellow wins!') : (w.p === 1 ? 'You win!' : 'The computer wins'); render(c); return true; }
        if (board[0].every(function (v) { return v; })) { over = true; msg.textContent = "It's a draw"; render(c); return true; }
        turn = 3 - turn;
        render(c);
        if (mode === '2 Players') msg.textContent = turn === 1 ? "Red's turn" : "Yellow's turn";
        else if (turn === 2) {
          lock = true; msg.textContent = 'Computer is thinking...';
          api.after(function () { lock = false; var m = aiMove(); drop(m); if (!over) msg.textContent = 'Your turn (Red)'; }, 420);
        }
        return true;
      }
      reset();
      return { drop: drop, state: function () { return { board: board.map(function (r) { return r.slice(); }), over: over, turn: turn, msg: msg.textContent }; }, mode: function (m) { mode = m; reset(); } };
    };

    /* ---------- Hangman ---------- */
    GAME_IMPL.hangman = function (stage, api) {
      var WORDS = {
        Animals: ['elephant', 'giraffe', 'penguin', 'dolphin', 'kangaroo', 'octopus', 'cheetah', 'hedgehog', 'butterfly', 'crocodile', 'flamingo', 'squirrel', 'panther', 'jellyfish', 'peacock'],
        Fruits: ['strawberry', 'pineapple', 'watermelon', 'blueberry', 'apricot', 'pomegranate', 'tangerine', 'raspberry', 'blackberry', 'grapefruit', 'cranberry', 'mango'],
        Countries: ['argentina', 'australia', 'portugal', 'switzerland', 'thailand', 'vietnam', 'germany', 'morocco', 'colombia', 'indonesia', 'norway', 'iceland'],
        Tech: ['keyboard', 'internet', 'browser', 'software', 'algorithm', 'password', 'bluetooth', 'database', 'processor', 'JavaScript', 'download', 'wireless'],
        Space: ['galaxy', 'asteroid', 'telescope', 'satellite', 'astronaut', 'comet', 'nebula', 'eclipse', 'universe', 'meteorite', 'supernova', 'gravity']
      };
      var MAXW = 6;
      var word, cat, guessed, wrong, over, streak = 0;
      var catLbl = api.el('div', 'stat');
      var svgNS = 'http://www.w3.org/2000/svg';
      var svg = document.createElementNS(svgNS, 'svg');
      svg.setAttribute('viewBox', '0 0 200 220'); svg.setAttribute('width', '190'); svg.setAttribute('height', '210');
      var P = [
        '<circle cx="140" cy="62" r="18"/>', '<line x1="140" y1="80" x2="140" y2="135"/>', '<line x1="140" y1="95" x2="115" y2="118"/>',
        '<line x1="140" y1="95" x2="165" y2="118"/>', '<line x1="140" y1="135" x2="120" y2="170"/>', '<line x1="140" y1="135" x2="160" y2="170"/>'
      ];
      var wordEl = api.el('div');
      wordEl.style.cssText = 'font-size:42px;font-weight:800;letter-spacing:10px;font-family:ui-monospace,Menlo,Consolas,monospace;min-height:56px;';
      var msg = api.el('div', 'msg');
      var wrongEl = api.el('div', 'stat');
      var kb = api.el('div');
      kb.style.cssText = 'display:flex;flex-wrap:wrap;gap:6px;justify-content:center;max-width:620px;';
      var keyBtns = {};
      'abcdefghijklmnopqrstuvwxyz'.split('').forEach(function (ch) {
        var b = api.btn(ch.toUpperCase(), function () { guess(ch); });
        b.style.cssText = 'width:46px;height:44px;padding:0;font-weight:700;';
        keyBtns[ch] = b; kb.appendChild(b);
      });
      var stat = api.stat('Win streak', 0);
      var again = api.btn('New Word', function () { reset(); });
      var top = api.el('div', 'row'); top.appendChild(catLbl); top.appendChild(stat.el);
      stage.appendChild(top); stage.appendChild(svg); stage.appendChild(wordEl); stage.appendChild(wrongEl); stage.appendChild(msg); stage.appendChild(kb); stage.appendChild(again);
      function drawSvg() {
        svg.innerHTML = '<g stroke="#9aa3b8" stroke-width="5" stroke-linecap="round" fill="none"><line x1="20" y1="205" x2="100" y2="205"/><line x1="60" y1="205" x2="60" y2="20"/><line x1="60" y1="20" x2="140" y2="20"/><line x1="140" y1="20" x2="140" y2="44"/></g>' +
          '<g stroke="#ff8a7a" stroke-width="5" stroke-linecap="round" fill="none">' + P.slice(0, wrong).join('') + '</g>';
      }
      function show() {
        wordEl.textContent = word.split('').map(function (ch) { return guessed[ch.toLowerCase()] || over ? ch.toUpperCase() : '_'; }).join(' ');
        wrongEl.textContent = 'Wrong guesses (' + wrong + '/' + MAXW + '): ' + Object.keys(guessed).filter(function (k) { return word.toLowerCase().indexOf(k) < 0; }).join(' ').toUpperCase();
        drawSvg();
      }
      function reset() {
        var cats = Object.keys(WORDS);
        cat = cats[(Math.random() * cats.length) | 0];
        word = WORDS[cat][(Math.random() * WORDS[cat].length) | 0];
        guessed = {}; wrong = 0; over = false; msg.textContent = '';
        catLbl.textContent = 'Category: ' + cat;
        Object.keys(keyBtns).forEach(function (k) { keyBtns[k].disabled = false; keyBtns[k].style.opacity = '1'; });
        show();
      }
      function guess(ch) {
        ch = ch.toLowerCase();
        if (over || guessed[ch] || !/^[a-z]$/.test(ch)) return;
        guessed[ch] = true;
        keyBtns[ch].disabled = true; keyBtns[ch].style.opacity = '.3';
        if (word.toLowerCase().indexOf(ch) < 0) { wrong++; api.tone(160, 0.12, 'sawtooth', 0.06); } else api.tone(520, 0.06, 'sine', 0.06);
        var solved = word.toLowerCase().split('').every(function (c) { return guessed[c]; });
        if (solved) { over = true; streak++; stat.set(streak); msg.textContent = 'You got it!'; }
        else if (wrong >= MAXW) { over = true; streak = 0; stat.set(0); msg.textContent = 'Game over. The word was ' + word.toUpperCase(); }
        show();
      }
      api.key(function (e) { if (e.ctrlKey || e.metaKey || e.altKey) return false; if (/^[a-zA-Z]$/.test(e.key)) { guess(e.key); return true; } if (e.key === 'Enter') { reset(); return true; } return false; });
      reset();
      return { guess: guess, state: function () { return { word: word, wrong: wrong, over: over, msg: msg.textContent, shown: wordEl.textContent }; }, setWord: function (w) { word = w; guessed = {}; wrong = 0; over = false; msg.textContent = ''; show(); } };
    };

    /* ---------- Simon ---------- */
    GAME_IMPL.simon = function (stage, api) {
      var PADS = [
        { c: '#2fbf5a', lit: '#8dffae', f: 415, r: '100% 0 0 0' }, { c: '#e23b3b', lit: '#ff9a9a', f: 310, r: '0 100% 0 0' },
        { c: '#f2c230', lit: '#fff0a0', f: 252, r: '0 0 0 100%' }, { c: '#2f6fe0', lit: '#9cc2ff', f: 209, r: '0 0 100% 0' }
      ];
      var seq = [], pos = 0, playing = false, accept = false, score = 0, best = api.hi('simon'), over = false;
      var top = api.el('div', 'row');
      var sScore = api.stat('Round'); var sBest = api.stat('Best', best);
      top.appendChild(sScore.el); top.appendChild(sBest.el);
      var msg = api.el('div', 'msg', 'Press Start');
      var wrap = api.el('div');
      var SZ = Math.max(200, Math.min(380, stage.clientHeight - 230));
      wrap.style.cssText = 'position:relative;width:' + SZ + 'px;height:' + SZ + 'px;display:grid;grid-template-columns:1fr 1fr;gap:10px;';
      var padEls = PADS.map(function (p, i) {
        var b = api.el('button');
        b.style.cssText = 'border:none;cursor:pointer;background:' + p.c + ';border-radius:' + p.r.replace(/100%/g, '100%') + ';opacity:.72;transition:opacity .1s,filter .1s;box-shadow:inset 0 -8px 0 rgba(0,0,0,.22);';
        b.addEventListener('click', function () { press(i); });
        wrap.appendChild(b);
        return b;
      });
      var center = api.btn('Start', function () { start(); });
      center.style.cssText = 'position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:' + SZ * 0.3 + 'px;height:' + SZ * 0.3 + 'px;border-radius:50%;font-size:18px;font-weight:800;background:#14161d;border:6px solid #0c0e13;color:#fff;cursor:pointer;';
      wrap.appendChild(center);
      var hint = api.el('div', 'hint', 'Watch the pattern, then repeat it  ·  Click the pads or use keys 1-4');
      stage.appendChild(top); stage.appendChild(msg); stage.appendChild(wrap); stage.appendChild(hint);
      function light(i, ms) {
        padEls[i].style.opacity = '1'; padEls[i].style.filter = 'brightness(1.5)';
        api.tone(PADS[i].f, ms / 1000, 'sine', 0.16);
        setTimeout(function () { padEls[i].style.opacity = '.72'; padEls[i].style.filter = 'none'; }, ms);
      }
      function start() { seq = []; score = 0; over = false; sScore.set(0); center.textContent = '...'; next(); }
      function next() {
        seq.push((Math.random() * 4) | 0);
        sScore.set(seq.length);
        playing = true; accept = false; pos = 0; msg.textContent = 'Watch...';
        var speed = Math.max(260, 560 - seq.length * 22);
        seq.forEach(function (s, i) { api.after(function () { light(s, speed * 0.7); }, 600 + i * speed); });
        api.after(function () { playing = false; accept = true; msg.textContent = 'Your turn'; }, 600 + seq.length * speed);
      }
      function press(i) {
        if (!accept || over) return;
        light(i, 220);
        if (seq[pos] !== i) {
          over = true; accept = false;
          api.tone(110, 0.6, 'sawtooth', 0.14);
          var got = seq.length - 1;
          msg.textContent = 'Wrong! You reached round ' + got + '. Press Start to try again.';
          center.textContent = 'Start';
          if (got > best) { best = got; api.setHi('simon', best); sBest.set(best); }
          return;
        }
        pos++;
        if (pos === seq.length) { accept = false; msg.textContent = 'Nice!'; api.after(next, 700); }
      }
      api.key(function (e) { if (/^[1-4]$/.test(e.key)) { press(+e.key - 1); return true; } if (e.key === 'Enter') { start(); return true; } return false; });
      return { press: press, start: start, state: function () { return { seq: seq.slice(), accept: accept, over: over, msg: msg.textContent }; } };
    };

    /* ---------- Flappy Bird ---------- */
    GAME_IMPL.flappy = function (stage, api) {
      var W = 360;
      var H = 520;
      var cv = api.canvas(W, H, 150);
      var ctx = cv.ctx;
      var bird, pipes, score, state, frame, best = api.hi('flappy'), ground = 0;
      var top = api.el('div', 'row');
      var sScore = api.stat('Score'); var sBest = api.stat('Best', best);
      top.appendChild(sScore.el); top.appendChild(sBest.el);
      var hint = api.el('div', 'hint', 'Click, tap or press Space / ↑ to flap');
      stage.appendChild(top); stage.appendChild(cv.c); stage.appendChild(hint);
      var GAPH = 148;
      function reset() { bird = { x: 90, y: H / 2 - 20, vy: 0, rot: 0 }; pipes = []; score = 0; frame = 0; state = 'ready'; sScore.set(0); }
      function flap() {
        if (state === 'dead') { if (frame > 20) reset(); return; }
        if (state === 'ready') state = 'play';
        bird.vy = -7.4;
        api.tone(620, 0.05, 'square', 0.05);
      }
      function update(dt) {
        frame += dt;
        if (state === 'ready') { bird.y = H / 2 - 20 + Math.sin(frame / 8) * 7; ground = (ground + 2.4 * dt) % 24; return; }
        if (state === 'dead') { bird.vy += 0.55 * dt; bird.y = Math.min(H - 70 - 10, bird.y + bird.vy * dt); return; }
        ground = (ground + 2.6 * dt) % 24;
        bird.vy += 0.46 * dt; bird.y += bird.vy * dt;
        bird.rot = Math.max(-0.5, Math.min(1.2, bird.vy / 10));
        if (!pipes.length || pipes[pipes.length - 1].x < W - 190) pipes.push({ x: W + 20, gy: 90 + Math.random() * (H - 70 - GAPH - 150), passed: false });
        pipes.forEach(function (p) {
          p.x -= 2.6 * dt;
          if (!p.passed && p.x + 52 < bird.x) { p.passed = true; score++; sScore.set(score); api.tone(880, 0.06, 'sine', 0.07); }
          if (bird.x + 13 > p.x && bird.x - 13 < p.x + 52 && (bird.y - 11 < p.gy || bird.y + 11 > p.gy + GAPH)) die();
        });
        pipes = pipes.filter(function (p) { return p.x > -70; });
        if (bird.y + 12 > H - 70 || bird.y < -20) die();
      }
      function die() {
        if (state === 'dead') return;
        state = 'dead'; frame = 0; api.tone(150, 0.3, 'sawtooth', 0.1);
        if (score > best) { best = score; api.setHi('flappy', best); sBest.set(best); }
      }
      function draw() {
        var sky = ctx.createLinearGradient(0, 0, 0, H);
        sky.addColorStop(0, '#5ec6f0'); sky.addColorStop(1, '#c9ecfa');
        ctx.fillStyle = sky; ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = 'rgba(255,255,255,.75)';
        [[60, 90, 26], [190, 140, 20], [290, 70, 24]].forEach(function (c) { var cx = (c[0] - frame * 0.15 + 400) % 440 - 40; ctx.beginPath(); ctx.arc(cx, c[1], c[2], 0, 7); ctx.arc(cx + c[2], c[1] + 6, c[2] * 0.8, 0, 7); ctx.arc(cx - c[2], c[1] + 8, c[2] * 0.7, 0, 7); ctx.fill(); });
        pipes.forEach(function (p) {
          var g = ctx.createLinearGradient(p.x, 0, p.x + 52, 0);
          g.addColorStop(0, '#3fa22a'); g.addColorStop(0.5, '#7fe05a'); g.addColorStop(1, '#3a9626');
          ctx.fillStyle = g;
          ctx.fillRect(p.x, 0, 52, p.gy); ctx.fillRect(p.x - 4, p.gy - 22, 60, 22);
          ctx.fillRect(p.x, p.gy + GAPH, 52, H); ctx.fillRect(p.x - 4, p.gy + GAPH, 60, 22);
          ctx.strokeStyle = 'rgba(0,0,0,.35)'; ctx.lineWidth = 2;
          ctx.strokeRect(p.x, 0, 52, p.gy); ctx.strokeRect(p.x - 4, p.gy - 22, 60, 22); ctx.strokeRect(p.x, p.gy + GAPH, 52, H); ctx.strokeRect(p.x - 4, p.gy + GAPH, 60, 22);
        });
        ctx.fillStyle = '#dcd08a'; ctx.fillRect(0, H - 70, W, 70);
        ctx.fillStyle = '#7fcf4a'; ctx.fillRect(0, H - 70, W, 12);
        ctx.fillStyle = '#c4b86e'; for (var x = -24; x < W + 24; x += 24) ctx.fillRect(x - ground, H - 52, 12, 52);
        ctx.save(); ctx.translate(bird.x, bird.y); ctx.rotate(bird.rot);
        ctx.fillStyle = '#ffd23f'; ctx.beginPath(); ctx.ellipse(0, 0, 16, 13, 0, 0, 7); ctx.fill();
        ctx.fillStyle = '#ffb81f'; ctx.beginPath(); ctx.ellipse(-4, 3 + Math.sin(frame / 2) * 3, 9, 6, -0.3, 0, 7); ctx.fill();
        ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(7, -5, 5.5, 0, 7); ctx.fill();
        ctx.fillStyle = '#111'; ctx.beginPath(); ctx.arc(9, -5, 2.4, 0, 7); ctx.fill();
        ctx.fillStyle = '#ff6a3d'; ctx.beginPath(); ctx.moveTo(12, 0); ctx.lineTo(24, 3); ctx.lineTo(12, 7); ctx.closePath(); ctx.fill();
        ctx.restore();
        ctx.fillStyle = '#fff'; ctx.strokeStyle = 'rgba(0,0,0,.5)'; ctx.lineWidth = 5; ctx.font = '800 44px Inter,sans-serif'; ctx.textAlign = 'center';
        ctx.strokeText(score, W / 2, 70); ctx.fillText(score, W / 2, 70);
        if (state === 'ready') { ctx.font = '700 20px Inter,sans-serif'; ctx.strokeText('Tap or press Space', W / 2, H / 2 + 60); ctx.fillText('Tap or press Space', W / 2, H / 2 + 60); }
        if (state === 'dead') { ctx.font = '800 34px Inter,sans-serif'; ctx.strokeText('Game over', W / 2, H / 2 - 20); ctx.fillText('Game over', W / 2, H / 2 - 20); ctx.font = '600 16px Inter,sans-serif'; ctx.strokeText('Tap to play again', W / 2, H / 2 + 14); ctx.fillText('Tap to play again', W / 2, H / 2 + 14); }
        ctx.textAlign = 'start';
      }
      api.key(function (e) { if (e.key === ' ' || e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') { flap(); return true; } return false; });
      api.on(cv.c, 'mousedown', flap);
      api.on(cv.c, 'touchstart', function (e) { e.preventDefault(); flap(); }, { passive: false });
      var lastT = 0;
      api.loop(function (t) { var dt = lastT ? Math.min(2.2, (t - lastT) / 16.67) : 1; lastT = t; update(dt); draw(); });
      reset();
      return { flap: flap, state: function () { return { state: state, score: score, y: bird.y, pipes: pipes.length }; }, tick: function (n) { for (var i = 0; i < n; i++) update(1); } };
    };

