    };
    var TAB_TIPS = {
      'p-presets': 'One-tap setups, plus anything you pin. Right-click a feature to pin it here.',
      'p-focus': 'Read aloud, focus timer and notes.',
      'p-layout': 'Page appearance, scrolling and size.',
      'p-adjust': 'Color and text sliders for the whole page.',
      'p-data': 'Collect and analyze what is on the page.',
      'p-design': 'Edit, draw and measure on the page.',
      'p-tools': 'Unlock, delete, navigate and find things.',
      'p-fun': 'Visual effects: weather, space, party, text transformers, gravity and click sounds.',
      'p-play': 'The element sandbox and a collection of classic games.'
    };
    var KW = {
      dark: 'night theme black', read: 'article paper sepia clean', img: 'pictures photos video', gray: 'greyscale monochrome black white',
      still: 'pause stop motion animations', fix: 'sticky header navbar cookie banner pinned', scroll: 'autoscroll auto',
      zoom: 'scale magnify size', mw: 'width narrow column margin', op: 'transparent fade', bri: 'light dark', sat: 'colour vivid',
      sep: 'warm tint', hue: 'colour rotate', blur: 'privacy hide', lh: 'spacing leading', ls: 'spacing tracking', ws: 'spacing',
      links: 'urls anchors scrape', emails: 'mail addresses scrape', imgs: 'pictures photos save', tables: 'spreadsheet export excel',
      heads: 'toc table of contents headings', text: 'copy article', stats: 'word count reading time', fonts: 'typeface palette css',
      edit: 'type contenteditable design mode', outline: 'boxes layout debug', hl: 'anchor yellow', font: 'typeface',
      eye: 'eyedropper picker hex', doodle: 'draw paint annotate pen', grid: 'lines align guide', ruler: 'focus line reading guide',
      unlock: 'copy paste right click context menu select', pw: 'password reveal', del: 'remove erase element hide',
      mute: 'sound audio volume silence', undo: 'restore', overlays: 'popup modal paywall cookie banner', top: 'jump start',
      bottom: 'jump end', md: 'markdown share', clean: 'tracking utm url', wayback: 'archive history internet archive',
      print: 'pdf', rate: 'playback speed video audio', refresh: 'reload auto', find: 'search text highlight',
      matrix: 'rain code', snow: 'winter flakes', rainbow: 'hue color cycle', trail: 'cursor sparkle mouse', spot: 'flashlight focus',
      confetti: 'party celebrate', roll: 'spin rotate', shake: 'quake earthquake', accent: 'theme color',
      pscale: 'size panel', popacity: 'transparency panel', keybtn: 'hotkey shortcut keybind',
      'pr-night': 'dark reading night preset', 'pr-focus': 'concentrate distraction preset', 'pr-clean': 'ads popups clutter preset',
      'pr-print': 'printer pdf preset', 'pr-easy': 'accessibility large text dyslexia preset', 'pr-party': 'fun preset',
      'pr-reset': 'default clear off undo all', mdpage: 'markdown export convert article', savehtml: 'download save offline file',
      inspect: 'devtools css selector element', ads: 'advert block adblock', tts: 'speak voice text to speech listen',
      ttsstop: 'silence cancel', ttsrate: 'speed voice', ftmin: 'pomodoro', ftstart: 'pomodoro timer countdown work',
      notes: 'memo scratchpad write', remember: 'save persist storage', cleardata: 'delete storage forget',
      blf: 'night warm orange eye strain f.lux', cvd: 'colour blind accessibility protanopia deuteranopia tritanopia', progress: 'scroll bar reading',
      linkurls: 'href address print', newtab: 'target blank', bigcur: 'pointer mouse large', seo: 'audit meta title alt a11y wcag lint',
      weight: 'size performance network speed', storage: 'cookies localstorage privacy', gallery: 'pictures photos grid', medialinks: 'mp4 mp3 stream',
      css: 'style stylesheet inject', frgo: 'replace substitute', pip: 'picture in picture floating video', loop: 'repeat video', shot: 'capture png image screen',
      fireworks: 'explosion party', bubbles: 'soap float', theme: 'light dark panel', compact: 'dense small spacing', exportcfg: 'backup share copy settings',
      importcfg: 'restore paste settings',
      rain: 'weather storm lightning thunder', stars: 'space warp galaxy fly hyperspace', emoji: 'emoticons party falling', disco: 'lights party club',
      ripples: 'click water wave', buddy: 'pet cursor follower friend', texteff: 'uppercase lowercase mirror flip upside down wobble glitch neon glow caps',
      hacker: 'terminal matrix green console', scan: 'crt retro tv old', grain: 'film noise vintage', gravity: 'fall drop physics chaos',
      gravityundo: 'restore undo', sounds: 'audio click beep sfx', surprise: 'random shuffle', stopfx: 'off disable all clear effects',
      opensb: 'falling sand powder toy physics elements nuke explosives fire water', sbox: 'sand sandbox physics game draw', sbbrush: 'size paint',
      sbres: 'resolution detail pixel quality performance', sbgrav: 'fall weight', sbwind: 'breeze air', sbghost: 'collision land page ghost solid', sbclear: 'reset wipe delete',
      sbrestore: 'undo nuke rebuild repair', sbpause: 'freeze stop'
    };
    Object.keys(TIPS).forEach(function (id) {
      var el = $('#' + id);
      if (el) (el.closest('.row') || el).setAttribute('data-tip', TIPS[id]);
    });
    Object.keys(KW).forEach(function (id) {
      var el = $('#' + id);
      var t = el && el.closest('[data-s]');
      if (t) t.setAttribute('data-k', KW[id]);
    });
    root.querySelectorAll('.tab').forEach(function (b) { b.setAttribute('data-tip', TAB_TIPS[b.getAttribute('data-tab')]); });

    var tip = $('#tip');
    var tipFor = null;
    function hideTip() { tipFor = null; if (tip) tip.classList.remove('show'); }
    function showTip(target) {
      var txt = target.getAttribute('data-tip');
      if (!txt) return hideTip();
      tip.textContent = txt;
      tip.style.fontSize = (12 * SCALE) + 'px';
      tip.style.maxWidth = (230 * SCALE) + 'px';
      tip.style.left = '0px';
      tip.style.top = '0px';
      var tr = target.getBoundingClientRect();
      var hr = hud.getBoundingClientRect();
      var w = tip.offsetWidth;
      var h = tip.offsetHeight;
      var vw = window.innerWidth;
      var vh = window.innerHeight;
      var x = hr.left - w - 12;
      var y = tr.top + tr.height / 2 - h / 2;
      if (x < 8) {
        x = hr.right + 12;
        if (x + w > vw - 8) {
          x = Math.max(8, Math.min(vw - w - 8, tr.left));
          y = (tr.bottom + 8 + h < vh - 8) ? tr.bottom + 8 : tr.top - h - 8;
        }
      }
      y = Math.max(8, Math.min(vh - h - 8, y));
      tip.style.left = x + 'px';
      tip.style.top = y + 'px';
      tip.classList.add('show');
    }
    hud.addEventListener('mouseover', function (e) {
      var t = e.target.closest ? e.target.closest('[data-tip]') : null;
      if (t === tipFor) return;
      tipFor = t;
      if (t) showTip(t); else hideTip();
    });
    hud.addEventListener('mouseleave', hideTip);

    /* =================== keyboard =================== */
    function onKey(e) {
      if (binding) {
        e.preventDefault();
        e.stopPropagation();
        ckey = e.key;
        gset('ckey', ckey);
        binding = false;
        $('#keybtn').textContent = keyName(ckey);
        say('Collapse key set to ' + keyName(ckey));
        return;
      }
      if (e.key === 'Escape' && gameWin) { closeGame(); return; }
      if (e.key === 'Escape' && galEl) { closeGal(); return; }
      if (e.key !== ckey) return;
      if (e.key === 'Escape' && html.classList.contains('ug-del')) { setSwitch('del', false); return; }
      if (ckey !== 'Escape') {
        var t = (e.composedPath && e.composedPath()[0]) || e.target;
        if (t && (/^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) || t.isContentEditable)) return;
      }
      toggleCollapse();
    }
    window.addEventListener('keydown', onKey, true);
    cleanups.push(function () { window.removeEventListener('keydown', onKey, true); });

    /* =================== restore saved state =================== */
    (function restoreAll() {
      applyUI(GLOB);
      if (GLOB.ckey) { ckey = GLOB.ckey; $('#keybtn').textContent = keyName(ckey); }
      if (GLOB.pos) {
        hud.style.right = 'auto';
        hud.style.left = Math.max(0, Math.min(parseFloat(GLOB.pos.left) || 0, window.innerWidth - 80)) + 'px';
        hud.style.top = Math.max(0, Math.min(parseFloat(GLOB.pos.top) || 0, window.innerHeight - 40)) + 'px';
      }
      var startTab = (GLOB.tab && $('#' + GLOB.tab)) ? GLOB.tab : 'p-presets';
      ind.style.transition = 'none';
      showTab(startTab, true);
      void ind.offsetWidth;
      ind.style.transition = '';
      if (SITE.remember) {
        $('#remember').checked = true;
        applyStates(savedState);
        if (SITE.css) cssStyle.textContent = SITE.css;
        if (Object.keys(savedState).length) say('Restored your settings for this site');
      }
    })();
  }

  /* =====================================================================
     cleanup
     ===================================================================== */
  function stopFx(k) {
    var f = fx[k];
    if (!f) return;
    if (f.stop) f.stop();
    if (f.o) f.o.close();
    delete fx[k];
  }

  function destroy() {
    timers.forEach(clearTimeout);
    clearInterval(refreshId);
    scrollSpeed = 0;
    if (scrollRaf) cancelAnimationFrame(scrollRaf);
    Object.keys(fx).forEach(function (k) { stopFx(k); });
    if (dd) { dd.close(); dd = null; }
    extras.forEach(function (el) { el.remove(); });
    Array.prototype.slice.call(html.classList).forEach(function (c) {
      if (c.indexOf('ug-') === 0) html.classList.remove(c);
    });
    ['--ug-b', '--ug-c', '--ug-s', '--ug-sp', '--ug-g', '--ug-bl', '--ug-h', '--ug-rs', '--ug-cb'].forEach(function (p) {
      html.style.removeProperty(p);
    });
    document.querySelectorAll('.ug-hidefix,.ug-gone,.ug-ad').forEach(function (el) {
      el.classList.remove('ug-hidefix');
      el.classList.remove('ug-gone');
      el.classList.remove('ug-ad');
    });
    document.querySelectorAll('mark.ug-mark').forEach(function (m) {
      if (m.parentNode) { m.parentNode.replaceChild(document.createTextNode(m.textContent), m); }
    });
    document.querySelectorAll('input[data-ug-pw]').forEach(function (i) { i.type = 'password'; i.removeAttribute('data-ug-pw'); });
    document.querySelectorAll('[data-ug-muted]').forEach(function (m) { m.muted = false; m.removeAttribute('data-ug-muted'); });
    document.designMode = 'off';
    document.body.style.zoom = origZoom;
    cleanups.forEach(function (fn) { try { fn(); } catch (e) {} });
    pageStyle.remove();
    fontStyle.remove();
    adjStyle.remove();
    host.remove();
    delete window.__utilityGui;
  }
})();

  }
  window.addEventListener('keydown', function (e) {
    if (e.altKey && e.shiftKey && e.code === 'KeyU') { e.preventDefault(); run(); }
  }, true);
})();
