        el.style.cssText = 'position:absolute;left:0;top:0;width:' + CELL + 'px;height:' + CELL + 'px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-weight:800;transition:transform .12s ease;';
        board.appendChild(el);
