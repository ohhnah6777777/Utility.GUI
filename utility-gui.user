          ctx.fillStyle = '#fff'; ctx.font = '700 34px Inter,sans-serif'; ctx.textAlign = 'center';
          ctx.fillText('Game over  ·  Score ' + score, W / 2, H / 2); ctx.font = '500 16px Inter,sans-serif'; ctx.fillText('Click or press Enter to play again', W / 2, H / 2 + 34); ctx.textAlign = 'start';
        } else if (state === 'ready') {
