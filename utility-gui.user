        for (var i = 0; i < N; i++) order.push(i);
        if (dr === 1 || dc === 1) order.reverse();
        var removed = [];
        var merged = {};
        order.forEach(function (a) {
          order.forEach(function (b) {
            var r = dr !== 0 ? a : b;
            var c = dr !== 0 ? b : a;
