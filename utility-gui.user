    };

    /* ---------- Connect Four ---------- */
    GAME_IMPL.c4 = function (stage, api) {
      var ROWS = 6;
      var COLS = 7;
      var mode = 'Medium';
      var board, turn, over, lock, scores = { 1: 0, 2: 0 }, winCells = [];
      var DEPTH = { Easy: 2, Medium: 4, Hard: 6 };
      var row = api.el('div', 'row');
      var mbtn = {};
      ['Easy', 'Medium', 'Hard', '2 Players'].forEach(function (m) {
        mbtn[m] = api.btn(m === '2 Players' ? m : 'vs Computer · ' + m, function () { mode = m; scores = { 1: 0, 2: 0 }; reset(); }, m === mode ? 'on' : '');
        row.appendChild(mbtn[m]);
      });
      var msg = api.el('div', 'msg');
      var score = api.el('div', 'stat');
      var boardEl = api.el('div');
      var CELL = Math.max(46, Math.min(76, Math.floor((stage.clientHeight - 310) / 6), Math.floor((stage.clientWidth - 80) / 7)));
      boardEl.style.cssText = 'display:grid;grid-template-columns:repeat(7,' + CELL + 'px);gap:8px;padding:12px;background:#2b4fb8;border-radius:20px;box-shadow:inset 0 -6px 0 rgba(0,0,0,.25);';
      var holes = [];
      for (var r = 0; r < ROWS; r++) for (var c = 0; c < COLS; c++) {
        var h = api.el('button');
        h.style.cssText = 'width:' + CELL + 'px;height:' + CELL + 'px;border-radius:50%;border:none;background:#10142a;box-shadow:inset 0 4px 8px rgba(0,0,0,.55);cursor:pointer;padding:0;position:relative;overflow:visible;';
        (function (cc) { h.addEventListener('click', function () { drop(cc); }); })(c);
        holes.push(h); boardEl.appendChild(h);
      }
      var again = api.btn('New Game', function () { reset(); });
      var hint = api.el('div', 'hint', 'Click a column to drop a disc  ·  Red goes first');
      stage.appendChild(row); stage.appendChild(msg); stage.appendChild(boardEl); stage.appendChild(score); stage.appendChild(again); stage.appendChild(hint);
      function reset() {
        board = []; for (var r = 0; r < ROWS; r++) board.push(new Array(COLS).fill(0));
        turn = 1; over = false; lock = false; winCells = [];
        render(); msg.textContent = mode === '2 Players' ? "Red's turn" : 'Your turn (Red)';
        Object.keys(mbtn).forEach(function (m) { mbtn[m].className = 'btn' + (m === mode ? ' on' : ''); });
      }
      function render(dropCol) {
        for (var r = 0; r < ROWS; r++) for (var c = 0; c < COLS; c++) {
          var v = board[r][c], hEl = holes[r * COLS + c];
          hEl.style.background = v === 1 ? 'radial-gradient(circle at 35% 30%,#ff8a8a,#e02f3d)' : (v === 2 ? 'radial-gradient(circle at 35% 30%,#fff0a0,#f2b705)' : '#10142a');
          hEl.style.boxShadow = v ? 'inset 0 -4px 8px rgba(0,0,0,.3)' : 'inset 0 4px 8px rgba(0,0,0,.55)';
          hEl.style.outline = '';
          if (dropCol === c && v && r === lastDropRow) { hEl.style.setProperty('--dy', (-(r + 1) * (CELL + 8) - 10) + 'px'); hEl.style.animation = 'none'; void hEl.offsetWidth; hEl.style.animation = 'drp .38s cubic-bezier(.45,0,.9,.55)'; }
        }
        winCells.forEach(function (p) { holes[p[0] * COLS + p[1]].style.outline = '4px solid #fff'; });
        score.textContent = 'Red: ' + scores[1] + '   ·   ' + (mode === '2 Players' ? 'Yellow: ' : 'Computer: ') + scores[2];
      }
      var lastDropRow = -1;
      function findWin(b) {
        var D = [[0, 1], [1, 0], [1, 1], [1, -1]];
        for (var r = 0; r < ROWS; r++) for (var c = 0; c < COLS; c++) {
          var v = b[r][c];
          if (!v) continue;
          for (var k = 0; k < 4; k++) {
            var cells = [[r, c]];
            for (var s = 1; s < 4; s++) { var rr = r + D[k][0] * s, cc = c + D[k][1] * s; if (rr < 0 || rr >= ROWS || cc < 0 || cc >= COLS || b[rr][cc] !== v) break; cells.push([rr, cc]); }
            if (cells.length === 4) return { p: v, cells: cells };
          }
        }
        return null;
      }
      function rowFor(b, c) { for (var r = ROWS - 1; r >= 0; r--) if (!b[r][c]) return r; return -1; }
      function evalWindow(w, p) {
        var me = w.filter(function (x) { return x === p; }).length, opp = w.filter(function (x) { return x === 3 - p; }).length, emp = w.filter(function (x) { return !x; }).length;
        if (me === 4) return 1000; if (me === 3 && emp === 1) return 6; if (me === 2 && emp === 2) return 2;
        if (opp === 3 && emp === 1) return -8; return 0;
      }
      function evalBoard(b, p) {
